{
  "2": {
    "255": {
      "ٱلۡقَيُّومُ": "القائم على كل شيء بتدبير خلقه وحفظهم.",
      "سِنَةٌۭ": "نعاس، وهو بداية النوم.",
      "يَـُٔودُهُۥ": "يثقله ويشق عليه."
    },
    "285": {
      "غُفْرَانَكَ": "نسألك مغفرتك وصفحك عن ذنوبنا."
    },
    "286": {
      "وُسْعَهَا": "طاقتها وما تستطيعه.",
      "إِصْرًۭا": "تكليفاً شاقاً وعهداً غليظاً كما حملته على الأمم قبلنا.",
      "مَوْلَىٰنَا": "ناصرنا وسيدنا ومتولي أمورنا."
    }
  },
  "18": {
    "1": {
      "عِوَجَا": "اختِلافاً، ولا اختِلالاً فِي ألفاظِه، ولا فِي معانيه."
    },
    "2": {
      "قَيِّمٗا": "مستقيماً معتدلاً، لا إفراطَ فيه ولا تفريطَ.",
      "بَأۡسٗا شَدِيدٗا": "عقوبةً عاجلةً في الدنيا، وآجِلَةً في الآخرةِ.",
      "أَجۡرًا حَسَنٗا": "ثواباً جزيلاً، هو الجنةُ."
    },
    "5": {
      "كَبُرَتۡ": "عَظُمَتْ في الشَّناعَةِ والقُبْحِ."
    },
    "6": {
      "بَٰخِعٞ نَّفۡسَكَ": "مُهْلِكُها ومُجْهِدُها.",
      "عَلَىٰٓ ءَاثَٰرِهِمۡ": "بعدَ تَوَلِّي قومِك عنك.",
      "ٱلۡحَدِيثِ": "القرآنِ.",
      "أَسَفًا": "حُزْناً وغَضَباً؛ لحِرْصِك على إيمانهم."
    },
    "7": {
      "لِنَبۡلُوَهُمۡ": "لِنَخْتَبِرَهم."
    },
    "8": {
      "صَعِيدٗا": "تُراباً.",
      "جُرُزًا": "لا نباتَ فيه."
    },
    "9": {
      "ٱلۡكَهۡفِ": "النَّقْبِ المتَّسِعِ في الجبل، وهو أكبرُ من المغارة.",
      "وَٱلرَّقِيمِ": "اللَّوْحِ الذي كُتِبَتْ فيه أسماءُ أهلِ الكهفِ."
    },
    "10": {
      "أَوَى ٱلۡفِتۡيَةُ إِلَى ٱلۡكَهۡفِ": "لجَؤُوا إليه؛ لعبادةِ اللهِ، وفِراراً بدِينهم.",
      "وَهَيِّئۡ": "يَسِّرْ.",
      "رَشَدٗا": "اهتداءً إلى الحق، وسَداداً في العمل."
    },
    "11": {
      "فَضَرَبۡنَا عَلَىٰٓ ءَاذَانِهِمۡ": "أَنَمْناهم نوماً عميقاً؛ بحيث لا يَسْمعون."
    },
    "12": {
      "بَعَثۡنَٰهُمۡ": "أيقَظْناهم مِنْ نومِهم.",
      "ٱلۡحِزۡبَيۡنِ": "الفريقَين المختلفَين في مُدَّةِ بقائِهم في الكهفِ.",
      "أَمَدٗا": "غايةً ومُدَّة."
    },
    "14": {
      "وَرَبَطۡنَا عَلَىٰ قُلُوبِهِمۡ": "قَوَّيْناها بالصَّبْرِ والتثبيتِ على الحقِّ.",
      "شَطَطًا": "قولاً بعيداً مجانِباً للحقِّ."
    },
    "15": {
      "لَوۡلَا": "هَلَّا.",
      "بِسُلۡطَٰنِۭ بَيِّنٖ": "دليلٍ واضحٍ.",
      "ٱفۡتَرَىٰ": "اختَلَقَ.",
      "كَذِبٗا": "بنسبةِ الشريكِ إلى اللهِ تعالى."
    },
    "16": {
      "ٱعۡتَزَلۡتُمُوهُمۡ": "فارَقْتُم قومَكم؛ فِراراً بدِينِكم.",
      "فَأۡوُۥٓاْ": "الجَؤُوا.",
      "يَنشُرۡ": "يَبْسُطْ ويُوَسِّعْ.",
      "وَيُهَيِّئۡ": "يُيَسِّرْ.",
      "مِرۡفَقٗا": "ما تنتفعون به من أسبابِ العيشِ."
    },
    "17": {
      "تَزَٰوَرُ": "تميلُ.",
      "ذَاتَ ٱلۡيَمِينِ": "جهةَ يمينِ الكهفِ.",
      "تَقۡرِضُهُمۡ": "تَتْرُكُهم وتتجاوَزُهم.",
      "فَجۡوَةٖ مِّنۡهُ": "مُتَّسَعٍ من الكهفِ وفَضائِه، فلا يتأَذَّون من جَوِّه، أو من حرارةِ الشمس، ويأتيهم الهواءُ النافعُ.",
      "ءَايَٰتِ ٱللَّهِ": "دلائلِ قُدرتِه.",
      "يَهۡدِ ٱللَّهُ": "يوفِّقه.",
      "وَلِيّٗا": "مُعِيناً وناصِراً."
    },
    "18": {
      "رُقُودٞ": "نِيامٌ.",
      "بِٱلۡوَصِيدِ": "بفِناءِ الكَهْفِ، كأنه يَحْرُسُهم.",
      "رُعۡبٗا": "خَوفاً وفَزَعاً."
    },
    "19": {
      "وَكَذَٰلِكَ": "وكما أَنَمْناهم وحَفِظْناهم مدةً طويلة.",
      "بَعَثۡنَٰهُمۡ": "أَيْقَظْناهم من نومِهم كما كانوا.",
      "بِوَرِقِكُمۡ": "بنقُودِكم الفِضِّيَّةِ.",
      "أَيُّهَآ": "أيُّ أهلِ المدينةِ.",
      "أَزۡكَىٰ طَعَامٗا": "أَحَلُّ وأطيبُ.",
      "وَلۡيَتَلَطَّفۡ": "وليتكلَّفِ اللُّطْفَ والرِّفْقَ في المعاملةِ، حتى لا ينكشِفَ أمرُنا."
    },
    "20": {
      "يَظۡهَرُواْ عَلَيۡكُمۡ": "يَطَّلِعُوا على مكانِكم ويَعْلَمُوا به.",
      "يَرۡجُمُوكُمۡ": "يَقْتُلوكم بالرَّجْمِ بالحجارةِ.",
      "مِلَّتِهِمۡ": "دينِهم الباطلِ."
    },
    "21": {
      "وَكَذَٰلِكَ": "وكما أَنَمْناهم السنينَ الطِّوالَ، ثم أيْقَظْناهم بعدَها.",
      "أَعۡثَرۡنَا عَلَيۡهِمۡ": "أطْلَعْنا عليهم أهلَ زمانِهم.",
      "وَعۡدَ ٱللَّهِ": "بالبعثِ.",
      "أَمۡرَهُمۡ": "في أمرِ القِيامةِ، فمِنْ مُقِرٍّ لها وجاحِدٍ، أو في أمْرِ الفِتْيَةِ المؤمنين وما اطَّلعوا عليه مِنْ أحوالِهم.",
      "ٱلَّذِينَ غَلَبُواْ عَلَىٰٓ أَمۡرِهِمۡ": "أصحابُ الكلمةِ والنفوذِ."
    },
    "22": {
      "رَجۡمَۢا بِٱلۡغَيۡبِ": "قولاً بلا عِلْمٍ ولا اطِّلاعٍ.",
      "بِعِدَّتِهِم": "بعَدَدِهم.",
      "فَلَا تُمَارِ فِيهِمۡ": "فلا تجادِلْ في شأنِ أصحابِ الكهفِ وعَدَدِهم أحداً من الخائضين فيه.",
      "إِلَّا مِرَآءٗ ظَٰهِرٗا": "إلا جِدالاً واضحاً بذِكْرِ ما قَصَصْنا عليك مِنْ شأنِهم دونَ زيادةٍ."
    },
    "24": {
      "وَٱذۡكُر رَّبَّكَ": "بقولِ: إنْ شاء الله.",
      "يَهۡدِيَنِ": "يُوَفِّقَني.",
      "مِنۡ هَٰذَا": "من قصةِ أصحابِ الكهفِ في الدِّلالةِ على نُبُوَّتي.",
      "رَشَدٗا": "هدايةً ودَلالة للناسِ على ذلك."
    },
    "25": {
      "وَلَبِثُواْ فِي كَهۡفِهِمۡ": "ومَكَثَ الفِتْيانُ فيه نِياماً."
    },
    "26": {
      "أَبۡصِرۡ بِهِۦ وَأَسۡمِعۡ": "ما أبصَرَ اللهَ وأسمَعَه بكلِّ موجودٍ، فهو لا يَغِيبُ عنه شيء.",
      "مَا لَهُم": "ليس للخَلْقِ.",
      "وَلِيّٖ": "مُعينٍ وناصرٍ.",
      "حُكۡمِهِۦٓ": "قَضائِه وتشريعِه."
    },
    "27": {
      "مُلۡتَحَدٗا": "مَلْجَأً ومَلاذاً."
    },
    "28": {
      "وَٱصۡبِرۡ نَفۡسَكَ": "احبِسْها في طاعةِ اللهِ.",
      "بِٱلۡغَدَوٰةِ وَٱلۡعَشِيِّ": "أولِ النهار وآخرِه، والمرادُ دوامُ العبادةِ.",
      "وَلَا تَعۡدُ عَيۡنَاكَ عَنۡهُمۡ": "لا تَصْرِفْ نَظَرَكَ عنهم إلى غيرِهِم.",
      "أَغۡفَلۡنَا قَلۡبَهُۥ": "جَعَلْناه غافلاً.",
      "فُرُطٗا": "ضَياعاً وهَلاكاً، ومُتَجاوِزاً فيه الاعتدالَ."
    },
    "29": {
      "ٱلۡحَقُّ": "ما جئتكُم به هو الحقُّ.",
      "فَمَن شَآءَ فَلۡيُؤۡمِن وَمَن شَآءَ فَلۡيَكۡفُرۡ": "تهديدٌ ووعيدٌ لمن اختارَ الكفرَ بعد بيانِ الحقِّ ووُضوحِه.",
      "سُرَادِقُهَا": "سُوْرُها المحيطُ بها.",
      "كَٱلۡمُهۡلِ": "ماءٌ غليظٌ كالمُنْصَهِر من المعادنِ، أو كعَكَرِ الزيتِ، بَلَغَ منتهى الحَرارةِ.",
      "مُرۡتَفَقًا": "منزِلاً ومُقاماً."
    },
    "31": {
      "جَنَّٰتُ عَدۡنٖ": "جِنانُ إقامةٍ دائمةٍ.",
      "يُحَلَّوۡنَ": "يُزَيَّنُون.",
      "سُندُسٖ": "رقيقِ الحَريرِ.",
      "وَإِسۡتَبۡرَقٖ": "ما غَلُظَ من الحريرِ وثَخُنَ.",
      "ٱلۡأَرَآئِكِ": "الأَسِرَّةِ المزيَّنَةِ بفاخِرِ السَّتائرِ."
    },
    "32": {
      "وَٱضۡرِبۡ لَهُم": "واذكُرْ للمؤمنين والكافرين المستكبرِين وأَوْرِدْ لهم.",
      "جَنَّتَيۡنِ": "حديقتَين.",
      "وَحَفَفۡنَٰهُمَا بِنَخۡلٖ": "جَعَلْنا النَّخْلَ محيطاً بكلٍّ منهما."
    },
    "33": {
      "ءَاتَتۡ أُكُلَهَا": "أثمرَتْ ثمرَها الذي يُؤْكَلُ.",
      "وَلَمۡ تَظۡلِم مِّنۡهُ": "ولم تَنْقُصْ من إثمارها عَبْرَ السنينَ."
    },
    "34": {
      "لَهُۥ ثَمَرٞ": "لصاحبِ البستانينِ أنواعٌ من المال سِوَىٰ حديقتَيه.",
      "نَفَرٗا": "أولاداً وخَدَماً وأعواناً."
    },
    "35": {
      "ظَالِمٞ لِّنَفۡسِهِۦ": "كافرٌ بالبعثِ، مُعْجَبٌ بمالِه.",
      "تَبِيدَ": "تَهْلِكَ وتَفْنَى."
    },
    "36": {
      "قَآئِمَةٗ": "كائنةً وواقعةً.",
      "مُنقَلَبٗا": "مَرْجِعاً وعاقبةً."
    },
    "38": {
      "لَٰكِنَّا۠": "لكنْ أنا أقولُ."
    },
    "39": {
      "وَلَوۡلَآ": "وهَلَّا."
    },
    "40": {
      "حُسۡبَانٗا": "جَمْعُ حُسْبانَةٍ، وهو العذابُ كالصَّواعِقِ.",
      "صَعِيدٗا": "أرضاً أو تراباً.",
      "زَلَقًا": "لا نَباتَ فيها، ومَلْساءُ لا تَثْبُتُ عليها قَدَمٌ، والمرادُ أنها عَدِيمةُ النَّفْعِ."
    },
    "41": {
      "غَوۡرٗا": "غائِراً ذاهباً في أسفلِ الأرضِ."
    },
    "42": {
      "وَأُحِيطَ بِثَمَرِهِۦ": "وأُهلِكَتْ أموالُ الكافرِ بما فيها حديقتاه، كما تَوَقَّعَ المؤمنُ.",
      "يُقَلِّبُ كَفَّيۡهِ": "دَلالةً على نَدَمِه وأَسَفِه وحَسْرَتِه.",
      "خَاوِيَةٌ عَلَىٰ عُرُوشِهَا": "متهدِّمةٌ سَقَطَ بعضُها على بعضٍ، خاليةٌ مما كان فيها."
    },
    "43": {
      "فِئَةٞ": "جماعةٌ ممَّنِ افتَخَرَ بهم.",
      "وَمَا كَانَ مُنتَصِرًا": "ما كان ممتنعاً بنفسِه وقوَّتِه عندَ انتقامِ اللهِ منه."
    },
    "44": {
      "هُنَالِكَ": "في مثلِ هذه الشَّدائدِ، أو يومِ القيامةِ.",
      "ٱلۡوَلَٰيَةُ لِلَّهِ": "النُّصْرَةُ للهِ وحدَه لا يَقْدِرُ عليها غيرُه.",
      "عُقۡبٗا": "عاقبةً لمَنْ تَوَلَّاهم."
    },
    "45": {
      "وَٱضۡرِبۡ لَهُم": "اذكُرْ للناسِ وأَوْرِدْ.",
      "مَثَلَ ٱلۡحَيَوٰةِ ٱلدُّنۡيَا": "صِفَتَها في زينتِها، وتَقَلُّبها وسُرْعَة زوالِها.",
      "هَشِيمٗا": "يابساً مُتَكَسِّراً، بعد خُضْرَتِه ونَضارَتِه.",
      "تَذۡرُوهُ ٱلرِّيَٰحُ": "تُذْهِبُه وتُفَرِّقُه إلى كلِّ جهةٍ.",
      "مُقۡتَدِرًا": "كاملَ القُدْرةِ على كلِّ شيءٍ."
    },
    "46": {
      "زِينَةُ ٱلۡحَيَوٰةِ ٱلدُّنۡيَا": "فيهما جَمالٌ ونَفْعٌ وقوَّةٌ.",
      "وَٱلۡبَٰقِيَٰتُ ٱلصَّٰلِحَٰتُ": "الأعمالُ الصالحةُ بما فيها: التسبيحُ، والتحميدُ، والتكبيرُ، والتهليلُ.",
      "أَمَلٗا": "ما كان يأمُلُه صاحبُها في الدُّنيا عندَ اللهِ في الآخِرة."
    },
    "47": {
      "نُسَيِّرُ ٱلۡجِبَالَ": "نُزِيلُها عن أماكنِها، ونُسَيِّرها في الجوِّ كالسَّحابِ.",
      "بَارِزَةٗ": "ظاهرةً للأَعْيُنِ لا يَسْتُرها شيءٌ.",
      "وَحَشَرۡنَٰهُمۡ": "جَمَعْنا الأوَّلِين والآخِرين لموقفِ الحسابِ.",
      "نُغَادِرۡ": "نَتْرُكْ."
    },
    "48": {
      "صَفّٗا": "مُصْطَفِّين جميعاً، لا يَغِيبُ أحدٌ منهم.",
      "كَمَا خَلَقۡنَٰكُمۡ أَوَّلَ مَرَّةِۭ": "مِثْلَ خَلْقِنا الأولِ لكم: فُرادى، حُفاةَ الأقدامِ، عُراةَ الأجسامِ، غيرَ مَخْتُونين.",
      "بَلۡ زَعَمۡتُمۡ": "يا مُنْكِري البَعْثِ.",
      "مَوۡعِدٗا": "لبَعْثِكم ومُجازاتِكم على أعمالِكم."
    },
    "49": {
      "ٱلۡكِتَٰبُ": "صحائفُ أعمالِ العبادِ.",
      "مُشۡفِقِينَ": "خائفين.",
      "يَٰوَيۡلَتَنَا": "يا هَلاكَنا، نداءٌ منهم على أنفسِهم بالخُسْرانِ والهَلاكِ.",
      "لَا يُغَادِرُ": "لا يَتْرُك.",
      "أَحۡصَىٰهَا": "عَدَّها وأثْبتَها."
    },
    "50": {
      "ٱسۡجُدُواْ لِأٓدَمَ": "تحيةً وإكراماً له وإظهاراً لفَضْلِه، لاعبادةً.",
      "فَفَسَقَ عَنۡ أَمۡرِ رَبِّهِۦٓ": "خَرَجَ عن طاعةِ ربِّه بتَرْكِ السُّجودِ؛ تَكَبُّراً.",
      "أَوۡلِيَآءَ": "أعواناً."
    },
    "51": {
      "مَآ أَشۡهَدتُّهُمۡ": "أي: إبليسَ وذريتَه.",
      "عَضُدٗا": "أعواناً وأنصاراً في شأنٍ من شؤوني."
    },
    "52": {
      "فَدَعَوۡهُمۡ": "استغاثُوا بهم.",
      "مَوۡبِقٗا": "مَهْلِكاً في جَهَنَّمَ يَهْلِكُون فيه."
    },
    "53": {
      "فَظَنُّوٓاْ": "أيقَنوا.",
      "مُوَاقِعُوهَا": "واقِعُونَ فيها وداخِلُوها.",
      "مَصۡرِفٗا": "مكاناً يَنْصَرِفُون ويَلْجَؤُون إليه."
    },
    "54": {
      "صَرَّفۡنَا": "بَيَّنَّا ونوَّعْنا بأساليبَ مختلفةٍ.",
      "كُلِّ مَثَلٖ": "كلِّ معنى يَحْصُلُ الاتِّعاظُ به.",
      "جَدَلٗا": "خُصومةً في الباطل."
    },
    "55": {
      "سُنَّةُ ٱلۡأَوَّلِينَ": "سُنَّةُ اللهِ في إهلاكِ السابقين بالاستئصال.",
      "قُبُلٗا": "صُنوفاً وأنواعاً، أو مُوَاجَهَةً ومقابَلَةً."
    },
    "56": {
      "لِيُدۡحِضُواْ بِهِ": "ليُزِيلُوا بجِدالِهم وباطِلِهم.",
      "هُزُوٗا": "استهزاءً وسُخْريَةً."
    },
    "57": {
      "أَكِنَّةً": "أغطيةً مانعةً.",
      "أَن يَفۡقَهُوهُ": "لِئلَّا يَفْهَمُوا القرآنَ؛ عُقوبةً لهم.",
      "وَقۡرٗا": "ثِقَلاً في السَّمعِ."
    },
    "58": {
      "مَوۡعِدٞ": "أي: مُقَدَّرٌ لعذابهِم."
    },
    "59": {
      "وَتِلۡكَ ٱلۡقُرَىٰٓ": "مِنَ الأممِ السابقةِ.",
      "لِمَهۡلِكِهِم": "لهَلاكِهم."
    },
    "60": {
      "لِفَتَىٰهُ": "تلميذِه وخادِمِه يُوشَعَ ابنِ نونٍ.",
      "لَآ أَبۡرَحُ": "لا أزال أسِيرُ.",
      "مَجۡمَعَ ٱلۡبَحۡرَيۡنِ": "مُلتقاهما.",
      "أَمۡضِيَ حُقُبٗا": "أسيرَ زمناً طويلاً."
    },
    "61": {
      "فِي ٱلۡبَحۡرِ سَرَبٗا": "طريقاً فيه، كالشَّقِّ في الأرضِ."
    },
    "62": {
      "جَاوَزَا": "فارَقَا مكانَهما.",
      "غَدَآءَنَا": "طعامَنا أوَّلَ النهارِ.",
      "نَصَبٗا": "تَعَباً."
    },
    "63": {
      "أَرَءَيۡتَ": "أَتَذْكُرُ؟",
      "إِذۡ أَوَيۡنَآ إِلَى ٱلصَّخۡرَةِ": "حين لَجَأْنا إليها للراحةِ.",
      "سَبِيلَهُۥ": "طريقَه.",
      "عَجَبٗا": "يُتعَجَّبُ منه."
    },
    "64": {
      "نَبۡغِ": "نَطْلبُه، وهو علامةٌ على مكانِ العبدِ الصَّالحِ.",
      "فَٱرۡتَدَّا": "رَجَعا.",
      "عَلَىٰٓ ءَاثَارِهِمَا": "على طريقِهما الذي جاءا منه.",
      "قَصَصٗا": "يَتْبَعان آثارَ مسيرِهما، حتى وَصَلا إلى الصَّخْرةِ."
    },
    "65": {
      "عَبۡدٗا مِّنۡ عِبَادِنَآ": "هو الخَضِرُ، وهو نبيٌّ توفَّاه الله.",
      "رَحۡمَةٗ": "نُبُوَّةً."
    },
    "66": {
      "رُشۡدٗا": "إصابةً للحقِّ وصَواباً أسترشِدُ به."
    },
    "68": {
      "خُبۡرٗا": "عِلْماً ومعرفةً بحقيقتِه."
    },
    "70": {
      "فَلَا تَسۡـَٔلۡنِي عَن شَيۡءٍ": "أي: تُنْكِرُه عليَّ في عِلْمِكَ.",
      "أُحۡدِثَ لَكَ مِنۡهُ ذِكۡرٗا": "أبتدِئَكَ ببيانِه وتَوْضيحِ ما خَفِيَ عليك."
    },
    "71": {
      "فَٱنطَلَقَا": "فسار موسى والخَضِرُ يَمْشِيان على الساحلِ.",
      "شَيۡـًٔا إِمۡرٗا": "أمراً عظيماً مُنْكَراً."
    },
    "73": {
      "وَلَا تُرۡهِقۡنِي": "لا تُحَمِّلني وتُكَلِّفني.",
      "مِنۡ أَمۡرِي عُسۡرٗا": "في صُحْبتي إياك وتَعَلُّمي منك مشقَّةً."
    },
    "74": {
      "زَكِيَّةَۢ": "نقيةً طاهرةً لم تبلُغْ حَدَّ التكليفِ.",
      "بِغَيۡرِ نَفۡسٖ": "بغيرِ حَقٍّ من قِصاصٍ عليها.",
      "نُكۡرٗا": "مُنْكَراً عظيماً."
    },
    "76": {
      "مِن لَّدُنِّي عُذۡرٗا": "إلى الغايةِ التي أَعْذُرُكَ في فِراقي بسببِها."
    },
    "77": {
      "ٱسۡتَطۡعَمَآ أَهۡلَهَا": "طَلَبا من أهلِ القريةِ الطعامَ، على وَجْهِ الضِّيافَةِ.",
      "فَأَبَوۡاْ": "امتنعُوا.",
      "يُرِيدُ": "يَقْرُبُ ويُوشِكُ.",
      "أَن يَنقَضَّ": "أن يسقطَ؛ بسببِ مَيَلانِه.",
      "فَأَقَامَهُۥ": "سوَّاه الخَضرُ وعَدَّلَ مَيْلَه."
    },
    "78": {
      "سَأُنَبِّئُكَ": "سأُخْبِرُكَ.",
      "بِتَأۡوِيلِ": "بحقيقةِ مَقْصِدي من أفعالي."
    },
    "79": {
      "لِمَسَٰكِينَ": "محتاجِين لا يملِكُون ما يَكْفيهم ويَسُدُّ حاجتَهم.",
      "أَعِيبَهَا": "أُحْدِثَ فيها عَيْباً بخَرْقِها.",
      "وَرَآءَهُم": "أمامَهم.",
      "كُلَّ سَفِينَةٍ": "صالحةٍ غيرِ مَعِيبةٍ.",
      "غَصۡبٗا": "قَهْراً وظُلْماً."
    },
    "80": {
      "يُرۡهِقَهُمَا": "يَدْفَعَ والدَيه إلى تجاوُزِ حدودِ اللهِ والكفرِ."
    },
    "81": {
      "زَكَوٰةٗ": "دِيناً وصَلاحاً.",
      "رُحۡمٗا": "رحمةً بوالدَيه وبِرّاً بهما."
    },
    "82": {
      "كَنزٞ": "مالٌ مَدْفونٌ من الذَّهَبِ والفِضَّةِ.",
      "يَبۡلُغَآ أَشُدَّهُمَا": "قوَّتَهما وكمالَ عَقْلِهما.",
      "ذَٰلِكَ تَأۡوِيلُ": "الذي بَيَّنْتُ لك أسبابَه هو مآلُ تلك الأمورِ."
    },
    "83": {
      "وَيَسۡـَٔلُونَكَ": "أي: كفارُ قريشٍ، بتَلْقينٍ من اليهود.",
      "ذِي ٱلۡقَرۡنَيۡنِ": "عبدٌ صالحٌ مَلَّكه اللهُ الأرضَ، وأعطاه العِلْمَ والحكمةَ، حتى بَلَغَ سلطانُه المشرقَ والمغربَ، فسُمِّيَ ذا القَرْنين، فكأنه حاز قَرْنَي الدنيا.",
      "ذِكۡرًا": "خَبَراً تتذكَّرون به."
    },
    "84": {
      "مَكَّنَّا لَهُۥ": "سَهَّلْنا لَه التَّصَرُّفَ كَيفَ شاءَ.",
      "سَبَبٗا": "طَرِيقاً يُوصِلُه إلى مُرادِهِ."
    },
    "85": {
      "فَأَتۡبَعَ": "سَلَك وسارَ.",
      "سَبَبًا": "طريقاً نَحْوَ الغَرْبِ."
    },
    "86": {
      "مَغۡرِبَ ٱلشَّمۡسِ": "مَوْضِعَ غُرُوبِها، وَهُوَ نِهَايةُ الأَرْضِ مِنَ الغَرْبِ.",
      "عَيۡنٍ": "نَبْعٍ جارِيةٍ بالماءِ أو غيرِه.",
      "حَمِئَةٖ": "ذاتِ طينٍ أسْودَ.",
      "تُعَذِّبَ": "بالقتلِ أو غيرِه، إنْ لم يُؤمِنُوا.",
      "حُسۡنٗا": "بِدعوتِهم إلى الهُدَى والرَّشادِ."
    },
    "87": {
      "ظَلَمَ": "نفسَه بكُفْرِه بِرَبِّه.",
      "نُكۡرٗا": "مُنْكَراً عَظِيماً في جَهَنَّمَ."
    },
    "88": {
      "ٱلۡحُسۡنَىٰ": "الجنَّةُ.",
      "يُسۡرٗا": "سَهْلاً لا مَشَقَّةَ فِيه."
    },
    "89": {
      "سَبَبًا": "طَرِيقاً نَحْوَ الشَّرْقِ."
    },
    "90": {
      "مَطۡلِعَ ٱلشَّمۡسِ": "مَوْضِعَ طُلُوعِها، وَهُوَ نِهَايةُ الأرْضِ مِنَ الشَّرْقِ.",
      "سِتۡرٗا": "ساتراً مِنَ البِناء أو الْأَشْجَار."
    },
    "91": {
      "كَذَٰلِكَ": "كما وَصَفْنا أمْرَ ذِي القَرنْيَنِ مِن بُلُوغِه المَغْرِبَ والمشْرِقَ.",
      "خُبۡرٗا": "عِلْماً ومَعْرِفةً."
    },
    "93": {
      "ٱلسَّدَّيۡنِ": "الجَبَلَينِ."
    },
    "94": {
      "يَأۡجُوجَ وَمَأۡجُوجَ": "أُمَّتانِ عظِيمتان مِن بَنِي آدَمَ مَوْجُودتانِ.",
      "خَرۡجًا": "نَصِيباً وأجْراً مِنَ المالِ.",
      "سَدّٗا": "حاجِزاً."
    },
    "95": {
      "رَدۡمًا": "حاجِزاً قَوِيّاً."
    },
    "96": {
      "زُبَرَ ٱلۡحَدِيدِ": "قِطَعَه الكَبيرةَ.",
      "ٱلصَّدَفَيۡنِ": "جانِبَي الجبَلَينِ.",
      "أُفۡرِغۡ": "أَصُبَّ.",
      "قِطۡرٗا": "نُحَاساً مُذاباً."
    },
    "97": {
      "يَظۡهَرُوهُ": "يَعْلُوه ويَصْعَدُوا إليه.",
      "نَقۡبٗا": "ثَقْباً؛ لِصَلابَتِه وسَماكَتِه."
    },
    "98": {
      "وَعۡدُ رَبِّي": "وَعْدُ رَبِّي بِخُرُوجِ يأجُوجَ ومَأجُوجَ.",
      "دَكَّآءَ": "مُنْهَدِماً مُسْتَوياً بالأَرض."
    },
    "99": {
      "يَمُوجُ": "يضْطَرِبُ ويَخْتَلِطُ بَعْضُهم في بَعْضٍ.",
      "ٱلصُّورِ": "القَرْنِ الذي يُنْفَخُ فيه للبعثِ."
    },
    "100": {
      "وَعَرَضۡنَا": "أبْرَزْنا."
    },
    "101": {
      "غِطَآءٍ": "سِتْرٍ وحِجَابٍ.",
      "ذِكۡرِي": "هُو القرآنُ والآياتُ الكونيةُ.",
      "لَا يَسۡتَطِيعُونَ سَمۡعًا": "لا يُطِيقُونَ سَمَاعَ الحُجَجِ والبَرَاهِينِ؛ بُغْضاً وعِنَاداً."
    },
    "102": {
      "مِن دُونِيٓ أَوۡلِيَآءَ": "مِنْ غيرِي آلهةً.",
      "أَعۡتَدۡنَا": "أَعْدَدْنا وأحْضَرْنا.",
      "نُزُلٗا": "مَنْزِلاً مُعَدّاً لهم."
    },
    "104": {
      "ضَلَّ سَعۡيُهُمۡ": "ضاعَ عَمَلُهم.",
      "يَحۡسَبُونَ أَنَّهُمۡ يُحۡسِنُونَ صُنۡعًا": "يَظُنُّونَ أنَّهم مُحْسِنُونَ في أعْمَالِهم."
    },
    "105": {
      "فَحَبِطَتۡ": "فبَطَلَتْ.",
      "وَزۡنٗا": "قَدْراً وثِقَلاً."
    },
    "106": {
      "هُزُوًا": "مُسْتَهْزَأً بِهما."
    },
    "107": {
      "جَنَّٰتُ ٱلۡفِرۡدَوۡسِ": "أعلى مَنَازِلِ الجنَّةِ وأَوْسَطُها ، وهي أَفْضَلُها.",
      "نُزُلًا": "مَنْزِلاً مُعدّاً لهم."
    },
    "108": {
      "لَا يَبۡغُونَ": "لا يُرِيدُونَ."
    },
    "109": {
      "مِدَادٗا": "حِبْراً للأقْلامِ.",
      "لَنَفِدَ": "لَفَنِيَ.",
      "كَلِمَٰتُ رَبِّي": "كَلَامُهُ وحُكْمُهُ.",
      "مَدَدٗا": "زِيادةً."
    },
    "110": {
      "يَرۡجُواْ": "يخافُ عذابَ ربِّه ، ويَرْجُو ثَوابَه يومَ لِقَائِه."
    }
  },
  "32": {
    "1": {
      "الٓمٓ": "سَبَقَ الكلامُ على الحُرُوفِ المُقَطَّعةِ في أوَّلِ سُورَةِ البَقَرةِ."
    },
    "2": {
      "لَا رَيۡبَ فِيهِ": "لاشَكَّ فِيه."
    },
    "3": {
      "أَمۡ يَقُولُونَ": "بل أيقُولُ المشرِكُونَ.",
      "ٱفۡتَرَىٰهُ": "اختَلَقَ محمدٌ ﷺ القرآنَ مِن تِلْقاءِ نَفْسِهِ.",
      "نَذِيرٖ": "أي: رَسُولٍ مُنْذِرٍ."
    },
    "4": {
      "ٱسۡتَوَىٰ عَلَى ٱلۡعَرۡشِ": "عَلَا وارْتَفَعَ سُبْحَانَه وَتَعَالَى عَلَى عَرْشِهِ كَما يَليقُ بِجَلَالِهِ.",
      "ٱلۡعَرۡشِ": "هُوَ سَريرُ المُلْكِ الَّذي اسْتَوى عَلَيهِ الرَّحْمَنُ، وَتَحْمِلُهُ الملائِكَةُ، وَهْوَ أَعْظَمُ المْخلُوقاتِ، وهو سَقْفُ الجنَّةِ.",
      "وَلِيّٖ": "ناصِرٍ يَنْصُرُكُم.",
      "تَتَذَكَّرُونَ": "تَتَّعِظُونَ."
    },
    "5": {
      "يُدَبِّرُ ٱلۡأَمۡرَ": "يَقْضِي القَضَاءَ.",
      "يَعۡرُجُ": "يَصْعَدُ."
    },
    "7": {
      "أَحۡسَنَ كُلَّ شَيۡءٍ": "أَحْكَمَهُ وأَتْقَنَهُ.",
      "طِينٖ": "تُرَابٍ."
    },
    "8": {
      "نَسۡلَهُۥ": "ذُرِّيَّتَه.",
      "سُلَٰلَةٖ": "نُطْفَةٍ مَسْلُولَةٍ.",
      "مَهِينٖ": "ذَلِيلٍ."
    },
    "9": {
      "سَوَّىٰهُ": "أتمَّ خَلْقَهُ.",
      "وَٱلۡأَفۡـِٔدَةَ": "القُلُوبَ."
    },
    "10": {
      "ضَلَلۡنَا فِي ٱلۡأَرۡضِ": "هَلَكَتْ أجْسَادُنا وتَفَرَّقَت وصِرْنا تُرَاباً.",
      "كَٰفِرُونَ": "مُنْكِرُونَ."
    },
    "11": {
      "يَتَوَفَّىٰكُم": "يَقبِضُ أَرْوَاحَكُم.",
      "وُكِّلَ بِكُمۡ": "وُكِّلَ بِقَبْضِ أرْوَاحِكُم."
    },
    "12": {
      "نَاكِسُواْ رُءُوسِهِمۡ": "أي: مُطْرِقُوها خِزْياً وَنَدَامَةً.",
      "مُوقِنُونَ": "مُصَدِّقُونَ."
    },
    "13": {
      "هُدَىٰهَا": "رُشْدَها، وَتَوفِيقَها لِلْإِيمانِ.",
      "حَقَّ": "وَجَبَ وثَبَتَ."
    },
    "14": {
      "ٱلۡخُلۡدِ": "الدَّائِمِ."
    },
    "15": {
      "يُؤۡمِنُ": "يُصَدِّقُ.",
      "ذُكِّرُواْ بِهَا": "وُعِظُوا بِها.",
      "خَرُّواْ": "سَقَطُوا."
    },
    "16": {
      "تَتَجَافَىٰ": "تَرْتَفِعُ وتَتَنَحَّى.",
      "عَنِ ٱلۡمَضَاجِعِ": "عَنِ الفُرُشِ الَّتِي يُضْطَجَعُ عَلَيها."
    },
    "17": {
      "مِن قُرَّةِ أَعۡيُنٖ": "مِن موجِباتِ المسَرَّةِ والفَرَحِ."
    },
    "19": {
      "نُزُلَۢا": "ما يُهيَّأُ للنَّزيلِ ضِيافَةً وإكْرَاماً."
    },
    "20": {
      "فَمَأۡوَىٰهُمُ": "المكَانُ الَّذي يَأْوُونَ إليه."
    },
    "21": {
      "ٱلۡعَذَابِ ٱلۡأَدۡنَىٰ": "وهو ما يُصِيبُهُم في الدُّنيا مِنَ البَلاءِ والِمحَنِ.",
      "ٱلۡعَذَابِ ٱلۡأَكۡبَرِ": "وهو ما يُصِيبُهُم يومَ القِيامةِ مِنْ عَذَابِ جَهَنَّمَ."
    },
    "22": {
      "ذُكِّرَ": "وُعِظَ."
    },
    "23": {
      "فِي مِرۡيَةٖ": "في شَكٍّ.",
      "مِن لِّقَآئِهِۦ": "أي: مِن لِقَاءِ مُوسَى عَلَيهِ الصَّلاةُ والسَّلامُ."
    },
    "25": {
      "يَفۡصِلُ": "يَقْضِي."
    },
    "26": {
      "أَوَ لَمۡ يَهۡدِ لَهُمۡ": "أَوَلم يُبَيِّنْ لَهُم.",
      "مِنَ ٱلۡقُرُونِ": "مِنَ الأُمَمِ السَّابِقَةِ.",
      "لَأٓيَٰتٍ": "لَعِبَراً وعِظاتٍ."
    },
    "27": {
      "ٱلۡجُرُزِ": "الأرْضِ اليابِسةِ الغَلِيظَةِ الجرْداءِ الَّتي لا نَباتَ فِيها."
    },
    "28": {
      "هَٰذَا ٱلۡفَتۡحُ": "هذا القضاءُ بين العِبادِ."
    },
    "29": {
      "يُنظَرُونَ": "يُمْهَلُونَ لِيؤْمِنُوا."
    },
    "30": {
      "وَٱنتَظِرۡ": "أي: انْتَظِرْ ما اللهُ صانِعٌ بِهِم."
    }
  },
  "67": {
    "1": {
      "تَبَٰرَكَ ٱلَّذِي": "تَكَاثَرَ خَيرُ اللهِ وبِرُّهُ عَلَى جَمِيعِ خَلْقِهِ.",
      "بِيَدِهِ ٱلۡمُلۡكُ": "التَّصَرُّفُ في مُلْكِ الدُّنيا والآخِرَةِ."
    },
    "2": {
      "لِيَبۡلُوَكُمۡ": "لِيَخْتَبِرَكُم."
    },
    "3": {
      "طِبَاقٗا": "مُتَناسِقَةً.",
      "تَفَٰوُتٖ": "اخْتِلافٍ وَتَبايُنٍ.",
      "فَٱرۡجِعِ ٱلۡبَصَرَ": "فَأَعِدِ النَّظَرَ.",
      "فُطُورٖ": "شُقُوقٍ أو صُدُوعٍ."
    },
    "4": {
      "كَرَّتَيۡنِ": "مَرَّةً بَعْدَ مَرَّةٍ.",
      "يَنقَلِبۡ": "يَرْجِعْ.",
      "خَاسِئٗا": "ذَلِيلاً صاغِراً.",
      "حَسِيرٞ": "مُتْعَبٌ كَلِيلٌ."
    },
    "5": {
      "ٱلدُّنۡيَا": "القَرِيبةَ.",
      "بِمَصَٰبِيحَ": "بِنُجُومٍ عَظِيمَةٍ مُضِيئةٍ.",
      "رُجُومٗا": "شُهُباً مُحْرِقَةً.",
      "لِلشَّيَٰطِينِ": "لِمُسْتَرِقِي السَّمْعِ مِنَ الشَّياطِينِ.",
      "ٱلسَّعِيرِ": "النَّارِ المُوقَدَةِ."
    },
    "6": {
      "وَبِئۡسَ ٱلۡمَصِيرُ": "وَسَاءَ المَرْجِعُ لهم جَهَنَّمُ."
    },
    "7": {
      "أُلۡقُواْ": "طُرِحُوا.",
      "شَهِيقٗا": "صَوْتاً شَدِيداً مُنْكَراً.",
      "تَفُورُ": "تَغْلِي غَلَيَاناً شَدِيداً."
    },
    "8": {
      "تَمَيَّزُ": "تَتَمَزَّقُ.",
      "مِنَ ٱلۡغَيۡظِ": "مِن شِدَّةِ غَضَبِها عَلَى الكُفَّارِ.",
      "أُلۡقِيَ": "طُرِحَ.",
      "فَوۡجٞ": "جَماعةٌ مِنَ النَّاسِ.",
      "خَزَنَتُهَا": "الملائِكةُ المُوكَّلُونَ بأَمْرِها.",
      "نَذِيرٞ": "رَسُولٌ يُحَذِّرُكُم مِنْ هَذا العَذابِ."
    },
    "10": {
      "نَسۡمَعُ": "سَمَاعَ مَن يَطْلُبُ الحقَّ.",
      "نَعۡقِلُ": "نُفَكِّرُ فِيما نُدْعَى إِلَيهِ.",
      "ٱلسَّعِيرِ": "النَّارِ المُوقَدَةِ."
    },
    "11": {
      "فَسُحۡقٗا": "فَبُعْداً عَن رَحْمَةِ اللهِ."
    },
    "12": {
      "بِٱلۡغَيۡبِ": "وَهُمْ غائِبُونَ عَنْ أعْيُنِ النَّاسِ، وَقَبْلَ مُعايَنَةِ العَذابِ.",
      "وَأَجۡرٞ": "ثَوَابٌ."
    },
    "13": {
      "وَأَسِرُّواْ": "وأَخْفُوا.",
      "أَوِ ٱجۡهَرُواْ بِهِۦٓ": "أَعْلِنُوهُ.",
      "بِذَاتِ ٱلصُّدُورِ": "بِما يَتَرَدَّدُ في النَّفْسِ مِنَ الخواطِرِ والنِّياتِ."
    },
    "14": {
      "يَعۡلَمُ": "اللهُ.",
      "مَنۡ خَلَقَ": "المخلُوقِينَ.",
      "ٱللَّطِيفُ": "العالِمُ خَبايا الأُمُورِ والمُدَبِّرُ لَها بِرِفْقٍ وَحِكْمَةٍ.",
      "ٱلۡخَبِيرُ": "العَلِيمُ بِباطِنِ أَمرِهِم."
    },
    "15": {
      "ذَلُولٗا": "سَهْلةً مُمَهَّدَةً تَسْتَقِرُّونَ عَلَيها.",
      "مَنَاكِبِهَا": "نواحِيها وَجَوَانِبِها.",
      "ٱلنُّشُورُ": "البَعْثُ مِن قُبُورِكُم لِلْحِسابِ."
    },
    "16": {
      "ءَأَمِنتُم": "هَلْ أَمِنْتُم؟",
      "مَن فِي ٱلسَّمَآءِ": "الَّذِي فَوقَ السَّماءِ.",
      "يَخۡسِفَ بِكُمُ ٱلۡأَرۡضَ": "يَقْلِبَ ظاهِرَ الأرضِ باطِناً، وباطِنَها ظاهِراً مُصاحِبةً لِذَواتِكم.",
      "تَمُورُ": "تَضْطَرِبُ بِكُم حَتَّى تَهْلِكُوا."
    },
    "17": {
      "حَاصِبٗا": "رِيحاً تَرْجُمُكُم بالحِجارةِ الصَّغِيرةِ.",
      "نَذِيرِ": "تَحْذِيرِي لَكُم."
    },
    "18": {
      "نَكِيرِ": "إِنْكارِي عَلَيهِم بإنْزَالِ العَذابِ بِهِم."
    },
    "19": {
      "صَٰٓفَّٰتٖ": "باسِطاتٍ أَجْنِحَتَها عِنْدَ طَيَرَانِها في الهواءِ.",
      "وَيَقۡبِضۡنَ": "ويَضْمُمْنَ أَجْنِحَتَها."
    },
    "20": {
      "أَمَّنۡ هَٰذَا": "بَلْ مَنْ هَذا.",
      "جُندٞ لَّكُمۡ": "حِزْبٌ لَكُم.",
      "مِن دُونِ ٱلرَّحۡمَٰنِ": "مِن غَيْرِ الرَّحمنِ.",
      "إِن": "ما.",
      "غُرُورٍ": "خِدَاعٍ وضَلَالٍ مِنَ الشَّيطانِ."
    },
    "21": {
      "لَجُّواْ": "اسْتَمَرُّوا في طُغْيانِهِم وَكُفْرِهِم.",
      "عُتُوّٖ": "مُعانَدَةٍ واسْتِكْبارٍ",
      "وَنُفُورٍ": "فِرارٍ مِنَ الحقِّ."
    },
    "22": {
      "مُكِبًّا": "ساقِطاً عَلَى وَجْهِهِ.",
      "أَهۡدَىٰٓ": "أَشَدُّ اسْتِقامةً عَلى الطَّرِيقةِ.",
      "سَوِيًّا": "مُسْتَوِياً."
    },
    "23": {
      "أَنشَأَكُمۡ": "أَوْجَدَكُم مِن العَدَمِ.",
      "وَٱلۡأَفۡـِٔدَةَ": "القُلُوبَ."
    },
    "24": {
      "ذَرَأَكُمۡ": "خَلَقَكُم وَنَشَرَكُم.",
      "تُحۡشَرُونَ": "تُجْمَعُونَ لِلْحِسابِ والجَزَاءِ."
    },
    "26": {
      "نَذِيرٞ": "مُخَوِّفٌ.",
      "مُبِينٞ": "أُبَيِّنُ لَكُمُ الشَّرَائِعَ."
    },
    "27": {
      "زُلۡفَةٗ": "قَرِيباً مِنْهُم.",
      "سِيٓـَٔتۡ وُجُوهُ ٱلَّذِينَ كَفَرُواْ": "ظَهَرَتْ عَلَيها الذِّلَّةُ والكآبةُ.",
      "بِهِۦ تَدَّعُونَ": "تَطْلُبُونَ تَعْجِيلَه في الدُّنيا."
    },
    "28": {
      "أَرَءَيۡتُمۡ": "أَخْبِرُوني.",
      "أَهۡلَكَنِيَ": "أماتَنِي.",
      "يُجِيرُ": "يَحْمِي وَيَمْنَعُ."
    },
    "29": {
      "ءَامَنَّا بِهِۦ": "صَدَّقْنا بِهِ وَعَمِلْنا بِشَرْعِهِ.",
      "تَوَكَّلۡنَا": "اعْتَمَدْنا في كُلِّ أُمُورِنا.",
      "ضَلَٰلٖ": "بُعْدٍ عَن صِراطِ اللهِ المُسْتَقِيمِ."
    },
    "30": {
      "أَرَءَيۡتُمۡ": "أَخْبِرُونِي.",
      "أَصۡبَحَ": "صارَ.",
      "غَوۡرٗا": "ذاهِباً في الأرضِ لا تصِلُونَ إِلَيهِ.",
      "مَعِينِۭ": "جارٍ على وَجْهِ الأَرْضِ تَرَاهُ العُيُونُ."
    }
  },
  "109": {
    "2": {
      "لَآ أَعۡبُدُ مَا تَعۡبُدُونَ": "لا تَحصُلُ منِّي عِبادَةُ ما تَعْبُدُونَ مِنَ الأصْنامِ والآلِهَةِ الزَّائِفَةِ."
    },
    "3": {
      "وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ": "وما أنتُم عابِدُونَ في المسْتَقْبَلِ ما أَعْبُدُ مِنْ إلهٍٍ واحدٍ، هُوَ اللهُ رَبُّ العالَمينَ المُسْتَحِقُّ وَحْدَهُ لِلعِبادةِ."
    },
    "4": {
      "وَلَآ أَنَا۠ عَابِدٞ مَّا عَبَدتُّمۡ": "وَلا أَنا عابِدٌ ما عبدتُم مِنَ الأصْنامِ والآلِهَةِ الباطِلةِ فيما مَضَى مِنَ الأزْمانِ."
    },
    "5": {
      "وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ": "وَلَا أنتُم عابِدُونَ مُسْتَقْبلاً ما أَعْبُدُ."
    },
    "6": {
      "لَكُمۡ دِينُكُمۡ": "الَّذِي أَصْرَرْتُم على اتِّباعِهِ، يختصُّ بِكُم، وأنا بَرِيءٌ مِنْهُ.",
      "وَلِيَ دِينِ": "الَّذِي أنا مُخْتَصٌّ بِهِ لا تَشْرَكُونِي فِيه، وَلَيسَ في الآيةِ إِقْرارٌ لِدِينِهِم."
    }
  },
  "112": {
    "1": {
      "هُوَ ٱللَّهُ أَحَدٌ": "هُو اللهُ المتفرِّدُ بالأُلُوهِيَّةِ والرُّبُوبِيَّةِ والأسْماءِ والصِّفاتِ، لا يُشارِكُه أَحَدٌ فِيها."
    },
    "2": {
      "ٱللَّهُ ٱلصَّمَدُ": "اللهُ وحْدَهُ السَّيِّدُ الكاملُ الصفات، المَقْصُودُ في قَضاءِ الحوائِجِ."
    },
    "3": {
      "لَمۡ يَلِدۡ وَلَمۡ يُولَدۡ": "لَيسَ لَهُ وَلَدٌ ولا والِدٌ ولا صاحِبَةٌ."
    },
    "4": {
      "وَلَمۡ يَكُن لَّهُۥ كُفُوًا أَحَدُۢ": "وَلَمْ يَكُن لَهُ من خَلْقِهِ أحدٌ يُشَابِهُهُ أو يُمَاثِلُهُ، لا في أسمائِهِ ولا في صِفاتِهِ، ولا في أفعالِهِ، تَبارك وَتَعالى وَتَقَدَّسَ."
    }
  },
  "113": {
    "1": {
      "أَعُوذُ بِرَبِّ ٱلۡفَلَقِ": "أَعْتَصِمُ بِرَبِّ الصُّبْحِ."
    },
    "2": {
      "مِن شَرِّ مَا خَلَقَ": "مِن شَرِّ جَمِيعِ المخلوقات وأذاها."
    },
    "3": {
      "غَاسِقٍ": "لَيلٍ شَدِيدِ الظُّلْمَةِ.",
      "إِذَا وَقَبَ": "دَخَلَ ظَلامُهُ في كُلِّ شَيءٍ."
    },
    "4": {
      "ٱلنَّفَّٰثَٰتِ فِي ٱلۡعُقَدِ": "السَّاحِراتِ اللاتِي يَنفُخْنَ فِيما يَعْقِدْنَ مِنْ عُقَدٍ بِقَصْدِ السِّحْرِ."
    },
    "5": {
      "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ": "وَمِن شَرِّ حاسِدٍ مُبْغِضٍ للنَّاسِ، إذا حَسَدَهُم عَلَى ما وَهَبَهُم اللهُ مِنَ النِّعَمِ."
    }
  },
  "114": {
    "1": {
      "أَعُوذُ بِرَبِّ ٱلنَّاسِ": "أَعْتَصِمُ بِرَبِّ النَّاسِ."
    },
    "2": {
      "مَلِكِ ٱلنَّاسِ": "المُتَصرِّفِ في كُلِّ شُؤُونِهِم، الغَنِيِّ عَنْهُم."
    },
    "3": {
      "إِلَٰهِ ٱلنَّاسِ": "الَّذِي لا مَعْبُودَ بِحَقٍّ سِوَاهُ."
    },
    "4": {
      "مِن شَرِّ ٱلۡوَسۡوَاسِ": "مِن أَذَى الشَّيطانِ الَّذِي يُوسْوِسُ عِنْدَ الغَفْلةِ.",
      "ٱلۡخَنَّاسِ": "الَّذِي يَخْتفِي عِنْدَ ذِكْرِ اللهِ."
    },
    "5": {
      "يُوَسۡوِسُ فِي صُدُورِ ٱلنَّاسِ": "يَبُثُّ الشَّرَّ والشُّكُوكَ في صُدُورِ النَّاسِ."
    },
    "6": {
      "مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ": "مِن شياطِينِ الجِنِّ والإِنْسِ."
    }
  }
}
