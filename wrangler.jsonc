{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "azkarapp-api",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-22",
  "triggers": { "crons": ["17 * * * *"] },
  "vars": {
    "APP_ORIGIN": "https://wa-zaker.com",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "azkarapp-production",
      "database_id": "efebe075-434f-4e7d-bec4-ee05232dabfd",
      "migrations_dir": "cloudflare/migrations",
    },
  ],
}
