{"1":{"وَيۡلٞ":"شَرٌّ وَهَلاكٌ.","لِكُلِّ هُمَزَةٖ":"لِكُلِّ مُغْتابٍ للنَّاسِ.","لُمَزَةٍ":"طَعَّانٍ فِيهِم."},"2":{"جَمَعَ مَالٗا وَعَدَّدَهُۥ":"كانَ هَمُّه جَمْعَ المالِ وتَعْدَادَهُ."},"3":{"أَخۡلَدَهُۥ":"جَعَلَه خالِداً في الدُّنيا."},"4":{"لَيُنۢبَذَنَّ":"ليُطْرَحَنَّ.","فِي ٱلۡحُطَمَةِ":"في النَّارِ الَّتِي تُحَطِّم كُلَّ ما يُلْقى فِيها."},"5":{"وَمَآ أَدۡرَىٰكَ":"وأيُّ شيءٍ أَعْلَمَكَ؟ "},"6":{"ٱلۡمُوقَدَةُ":"المسْتَعِرَةُ الَّتِي لا يزُولُ لَهِيبُها."},"7":{"تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ":"من شِدَّتِها تَنفُذُ مِنَ الأجْسام إِلى القُلُوبِ."},"8":{"مُؤۡصَدَةٞ":"مُغْلَقةٌ غَلْقاً مُطْبِقاً."},"9":{"فِي عَمَدٖ":"مُوْثَقِينَ في سَلاسِلَ وأغلالٍ.","مُمَدَّدَةِۭ":"مُطَوَّلَةٍ؛ لئلَّا يَخرُجُوا مِنها."}}