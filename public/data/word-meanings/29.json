{"1":{"الٓمٓ":"سَبَقَ الكلامُ على الحُرُوفِ المُقَطَّعةِ في أوَّلِ سُورَةِ البَقَرةِ."},"2":{"لَا يُفۡتَنُونَ":"لا يُبتَلَونَ."},"4":{"أَن يَسۡبِقُونَا":"أن يُعْجِزُونا ويَفُوتُونا.","سَآءَ":"بِئْسَ."},"5":{"يَرۡجُواْ":"يَتَوَقَّعُ ويَطْمَعُ.","أَجَلَ ٱللَّهِ":"الوَقْتَ المُعَيَّنَ للبَعْثِ والجَزَاءِ."},"6":{"جَٰهَدَ":"أي: الكُفَّارَ ونَفْسَه الأَمَّارةَ بالسُّوءِ."},"7":{"لَنُكَفِّرَنَّ":"لَنَمْحُوَنَّ.","وَلَنَجۡزِيَنَّهُمۡ":"لَنُثِيبَنَّهم."},"8":{"وَوَصَّيۡنَا":"أي: أَمَرْنا.","حُسۡنٗا":"أي: بِرّاً بِهِما وعَطْفاً عَلَيهِما.","جَٰهَدَاكَ":"ألْزَماكَ."},"10":{"فِتۡنَةَ ٱلنَّاسِ":"ابتلاءَهم وتَعْذِيبَهُم."},"12":{"وَلۡنَحۡمِلۡ":"ولْنَتَحَمَّلْ."},"13":{"أَثۡقَالَهُمۡ":"أي: أثْقَالَ ذُنُوبِهِم الْعَظِيمَةَ.","يَفۡتَرُونَ":"يَخْتَلِقُونَ."},"14":{"فَلَبِثَ":"مَكَثَ.","ٱلطُّوفَانُ":"الماءُ الكَثِيرُ الذي غَمَرهُم مِن جَمِيعِ الجِهاتِ."},"15":{"ءَايَةٗ":"عِبْرةً عَظِيمةً."},"17":{"أَوۡثَٰنٗا":"أصْناماً.","تَخۡلُقُونَ إِفۡكًا":"تَفْتَرُونَ كَذِباً.","فَٱبۡتَغُواْ":"فالتَمِسُوا."},"19":{"أَوَ لَمۡ يَرَوۡاْ":"أَوَلم يَعْلَمُوا.","يُبۡدِئُ":"يُنشِئُ ابتداءً.","يُعِيدُهُۥٓ":"يُعِيدُ الخَلْقَ مِن بَعْدِ فَنَائِهِ."},"20":{"يُنشِئُ":"يَخلُقُ.","ٱلنَّشۡأَةَ ٱلۡأٓخِرَةَ":"أي: نَشْأَةً ثانيةً عِنْدَ البعْثِ."},"21":{"تُقۡلَبُونَ":"تُرجَعُونَ."},"22":{"بِمُعۡجِزِينَ":"بِسَابِقِينَ اللهَ."},"23":{"بِـَٔايَٰتِ ٱللَّهِ":"أي: بالقرآنِ.","وَلِقَآئِهِۦٓ":"أي: بالبعثِ بَعْدَ الموتِ."},"24":{"لَأٓيَٰتٖ":"لَأَدِلَّةً واضِحَةً."},"25":{"أَوۡثَٰنٗا":"أصْناماً، أي: اتَّخذتُموها آلِهَةً.","مَوَدَّةَ بَيۡنِكُمۡ":"أي: للتَّوادِّ والتَّواصُل بَيْنَكُم لاجْتِماعِكُم على عِبادَتِها.","يَكۡفُرُ بَعۡضُكُم بِبَعۡضٖ":"أي: يتبرَّأُ بعضُكُم مِن بَعْضٍ.","مَأۡوَىٰكُمُ":"مَنْزِلُكُم الذي تَأْوُونَ إليهِ وتَرْجِعُونَ."},"26":{"فَـَٔامَنَ لَهُۥ":"أي: صَدَّقَ إبراهيمَ عَلَيهِ الصَّلاةُ والسَّلامُ."},"27":{"وَٱلۡكِتَٰبَ":"أي: الكُتُبَ المنزَّلةَ، مِنَ التَّورَاةِ والإنْجِيلِ والزَّبُورِ والقرآنِ.","أَجۡرَهُۥ":"أي: ثَوَابَه."},"28":{"ٱلۡفَٰحِشَةَ":"هي إِتْيانُهم الرِّجالَ في أدْبارِهِم."},"29":{"وَتَقۡطَعُونَ ٱلسَّبِيلَ":"أي: الطَّريقَ على المارَّةِ والمسَافِرِينَ، بأخْذِ أمْوالِهِم، أو قَتْلِهِم، أو إِكْرَاهِهِم على الفاحِشَةِ.","فِي نَادِيكُمُ":"في مَجْلِسِكُم.","ٱلۡمُنكَرَ":"وهو كلُّ فِعْلٍ يُنكِره الشَّرْعُ أو العقْلُ كالسُّخْرِيَةِ مِنَ النَّاسِ وحَذْفِ المارّةِ."},"31":{"رُسُلُنَآ":"أي: مِنَ الَملاَئِكَةِ.","هَٰذِهِ ٱلۡقَرۡيَةِ":"هي «سَدُومُ» قَرْيَةُ قَوْمِ لُوطٍ."},"32":{"مِنَ ٱلۡغَٰبِرِينَ":"مِنَ الباقِينَ في العَذَابِ والهَلَاكِ."},"33":{"سِيٓءَ بِهِمۡ":"اعْتَراهُ الغَمُّ بِمَجِيئِهِم خَوْفاً عَليهِم مِن قَومِهِ.","وَضَاقَ بِهِمۡ ذَرۡعٗا":"أي: عَجَزَ عَن تَدْبِيرِ خَلَاصِهِم."},"34":{"رِجۡزٗا":"عَذَاباً شَدِيداً."},"35":{"مِنۡهَآ":"أي: مِن دِيارِ قَومِ لُوطٍ.","ءَايَةَۢ بَيِّنَةٗ":"أي: آثاراً واضِحةً."},"36":{"وَٱرۡجُواْ":"تَوَقّعُوا، أَوِ اخْشَوا.","وَلَا تَعۡثَوۡاْ":"لا تُفْسدُوا أشدَّ الفَسَادِ."},"37":{"ٱلرَّجۡفَةُ":"الزَّلْزَلةُ الشَّدِيدَةُ.","جَٰثِمِينَ":"مَيِّتِينَ بارِكِينَ على رُكَبِهِم."},"38":{"فَصَدَّهُمۡ":"فصَرفَهُم.","ٱلسَّبِيلِ":"أي: سَبِيلِ اللهِ المُسْتَقِيمِ.","مُسۡتَبۡصِرِينَ":"أي: عُقَلاءَ ذَوِي بَصَائِرَ مُتَمَكِّنِينَ مِن مَّعْرِفَةِ الحقِّ."},"39":{"بِٱلۡبَيِّنَٰتِ":"بالأدِلَّةِ الواضِحةِ.","سَٰبِقِينَ":"فائِتِينَ مِنْ عَذَابِ اللهِ."},"40":{"حَاصِبٗا":"ريحاً عاصِفاً ترمِيهِم بالحَصْباءِ.","ٱلصَّيۡحَةُ":"صَوْتٌ مِنَ السَّماءِ مُهلِكٌ مُرْجِفٌ.","خَسَفۡنَا بِهِ":"جَعَلْنا الأرْضَ تبتَلِعُه وهو حَيٌّ."},"41":{"أَوۡهَنَ ٱلۡبُيُوتِ":"أضْعَفَها."},"43":{"نَضۡرِبُهَا":"أي: نُبَيِّنُها.","وَمَا يَعۡقِلُهَآ":"وَما يَفْهَمُها."},"44":{"لَأٓيَةٗ":"لدَلالَةً عَظِيمةً."},"45":{"ٱلۡفَحۡشَآءِ":"أي: كُلِّ عَمَلٍ قَبِيحٍ.","وَٱلۡمُنكَرِ":"وهو كلُّ فِعْلٍ يُنكِرُه الشَّرعُ أو العَقْلُ."},"46":{"أَهۡلَ ٱلۡكِتَٰبِ":"وهُمُ اليَهُودُ والنَّصارَى."},"47":{"وَمَا يَجۡحَدُ":"وما يُنكِرُ.","بِـَٔايَٰتِنَآ":"أي: بالقرآنِ وما فيه مِن دَلَائِلَ وبَرَاهِينَ.","ٱلۡكَٰفِرُونَ":"أي: المُكابِرُونَ في كُفْرِهِم."},"48":{"لَٱرۡتَابَ":"لَشَكَّ.","ٱلۡمُبۡطِلُونَ":"هُمْ أَهلُ الباطِلِ."},"49":{"هُوَ ءَايَٰتُۢ":"أي: القرآنُ آياتٌ تُتْلى.","بَيِّنَٰتٞ":"واضِحاتٌ.","أُوتُواْ":"أُعْطُوا.","ٱلظَّٰلِمُونَ":"أي: المُعانِدُونَ الَّذينَ يَعْلَمُونَ الحقَّ ولا يَتَّبعُونَه."},"50":{"ءَايَٰتٞ":"أي: مُعْجِزَاتٌ حِسِّيَّةٌ تُثْبِتُ صِدْقَهُ.","عِندَ ٱللَّهِ":"أي: إِنْ شَاءَ أنْزَلَها، وإِنْ شَاءَ مَنَعَها."},"53":{"أَجَلٞ مُّسَمّٗى":"وَقْتٌ مُعَيَّنٌ لا يَتَقَدَّمُ وَلَا يَتَأَخَّرُ.","بَغۡتَةٗ":"فُجَاءَةً."},"54":{"لَمُحِيطَةُۢ":"أي: سَتُحِيطُ بِهِم في الآخِرَةِ."},"58":{"لَنُبَوِّئَنَّهُم":"لَنُنَزِّلَنَّهُم.","غُرَفٗا":"مَنازِلَ عَالِيةً."},"60":{"وَكَأَيِّن مِّن دَآبَّةٖ":"أي: كَثِيرٌ مِنَ الدَّوابِّ.","لَا تَحۡمِلُ رِزۡقَهَا":"أي: لا تُطِيقُ حَمْلَهُ ولا ادِّخارَهُ."},"61":{"فَأَنَّىٰ يُؤۡفَكُونَ":"فَكَيفَ يُصرَفُونَ عَن تَوحِيدِهِ؟"},"62":{"يَبۡسُطُ":"يُوَسِّعُ.","وَيَقۡدِرُ":"يُضَيِّقُ."},"63":{"مِنۢ بَعۡدِ مَوۡتِهَا":"مِن بَعْدِ قَحْطِ الأرْضِ وَجَفافِها."},"64":{"لَهِيَ ٱلۡحَيَوَانُ":"لَهِيَ الحَيَاةُ الدَّائِمَةُ الَّتي لا يُنَغِّصُها شَيءٌ."},"65":{"فِي ٱلۡفُلۡكِ":"في السُّفُن."},"67":{"وَيُتَخَطَّفُ ٱلنَّاسُ":"أي: يُسْتَلَبُونَ قَتْلاً وأسْراً.","أَفَبِٱلۡبَٰطِلِ":"أي: بالشِّركِ."},"68":{"ٱفۡتَرَىٰ":"اخْتَلَقَ.","مَثۡوٗى":"مَسْكَنٌ."},"69":{"جَٰهَدُواْ فِينَا":"أي: الكُفَّارَ والنَّفْسَ والشَّيطانَ.","لَنَهۡدِيَنَّهُمۡ سُبُلَنَا":"لَنُرْشِدَنَّهُم طُرُقَنا."}}