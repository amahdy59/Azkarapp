{"1":{"وَضُحَىٰهَا":"أَقْسَمَ اللهُ بإشْرَاقِ الشَّمْسِ ضُحىً."},"2":{"تَلَىٰهَا":"تَبِعَها في الطُّلُوعِ والأُفُول."},"3":{"جَلَّىٰهَا":"جَلَّى الظُّلْمةَ وكَشَفَها."},"4":{"يَغۡشَىٰهَا":"يُغَطِّي الأَرْضَ فيكُونُ ما عَلَيها مُظْلِماً."},"5":{"وَمَا بَنَىٰهَا":"وَبِنائِها المُحْكَمِ."},"6":{"وَمَا طَحَىٰهَا":"وبَسْطِها."},"7":{"وَمَا سَوَّىٰهَا":"وَإِكْمالِ اللهِ خَلْقَها لأداءِ مُهِمَّتِها."},"8":{"فَأَلۡهَمَهَا":"فَبيَّنَ لَها.","فُجُورَهَا":"طَرِيقَ الشَّرِّ.","وَتَقۡوَىٰهَا":"وَطَرِيقَ الخيرِ."},"9":{"أَفۡلَحَ":"فاز.","زَكَّىٰهَا":"طَهَّرَها، ونَمَّاها بالخيرِ."},"10":{"خَابَ":"خَسِرَ.","دَسَّىٰهَا":"أَخْفَى نَفْسَهُ في المعاصِي."},"11":{"بِطَغۡوَىٰهَآ":"بِبُلُوغِها الغايةَ في العِصْيانِ."},"12":{"ٱنۢبَعَثَ":"نَهَضَ لِعَقْرِ النَّاقةِ.","أَشۡقَىٰهَا":"أَكْثَرُ القبيلةِ شَقاوَةً."},"13":{"نَاقَةَ ٱللَّهِ":"احْذَرُوا أَن تَمَسُّوا النَّاقَةَ بسُوءٍ.","وَسُقۡيَٰهَا":"واحذَرُوا أن تَعْتَدُوا على سَقْيِها."},"14":{"فَعَقَرُوهَا":"فَنَحَرُوها.","فَدَمۡدَمَ عَلَيۡهِمۡ":"فَأَطْبَقَ عليهِم العُقُوبةَ.","فَسَوَّىٰهَا":"فَجَعَلَها عَلَيهِم على السَّواءِ، فلم يُفْلِتْ مِنهُم أَحَدٌ."},"15":{"عُقۡبَٰهَا":"تَبِعةَ ما أَنزَلَهُ بِهِم مِنَ العِقابِ."}}