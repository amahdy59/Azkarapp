{"1":{"طسٓمٓ":"سَبَقَ الكَلَامُ على الحُرُوفِ المُقَطَّعةِ في أوَّلِ سُورَةِ البَقَرةِ."},"2":{"ٱلۡكِتَٰبِ":"القرآنِ."},"3":{"بَٰخِعٞ نَّفۡسَكَ":"مُهْلِكُها غَمّاً وحُزْناً."},"4":{"ءَايَةٗ":"مُعْجِزَةً.","خَٰضِعِينَ":"مُنْقادِينَ قَهْراً."},"5":{"مُحۡدَثٍ":"أي: مُجَدَّدٍ إنْزَالُه."},"7":{"أَوَ لَمۡ يَرَوۡاْ":"أوَلَم يَنْظُرُوا."},"8":{"لَأٓيَةٗ":"لَدَلَالةً واضِحَةً."},"11":{"أَلَا يَتَّقُونَ":"ألَا يَخافُونَ عِقابَ اللهِ تعالى؟"},"14":{"ذَنۢبٞ":"وهو قَتْلُ القِبْطِيِّ."},"15":{"بِـَٔايَٰتِنَآ":"بِمُعْجزاتِنا وحُجَجِنا.","إِنَّا مَعَكُم":"أي: بالعِلْمِ، والحِفْظِ، والنُّصْرَةِ."},"18":{"أَلَمۡ نُرَبِّكَ":"ألم نَرْعَكَ.","وَلِيدٗا":"صَغِيراً."},"19":{"فَعۡلَتَكَ":"أي: قَتْلَ القِبْطِيِّ.","مِنَ ٱلۡكَٰفِرِينَ":"أي: من الجاحِدِينَ لِنِعْمَتِي."},"20":{"مِنَ ٱلضَّآلِّينَ":"مِنَ المُخْطِئِينَ لا المتعَمِّدِينَ."},"21":{"حُكۡمٗا":"أي: نُبُوَّةً وحِكْمَةً."},"22":{"تَمُنُّهَا عَلَيَّ":"تَعُدُّها نِعْمَةً مِنْكَ عَليَّ.","عَبَّدتَّ":"جَعَلْتَهُم عَبِيداً، تَذْبَحُ مَنْ تَشَاءُ، وتَتْرُكُ مَنْ تَشَاءُ مِنْ أبْنائِهِم، وَتَسْتَبْقِي نِساءَهُم لِلْخِدْمَةِ والامْتِهانِ."},"30":{"بِشَيۡءٖ مُّبِينٖ":"أي: بِبُرْهانٍ قاطِعٍ."},"33":{"بَيۡضَآءُ":"أي: مِنْ غَيرِ مَرَضٍ ولا بَرَصٍ."},"34":{"لِلۡمَلَإِ":"لأشْرَافِ قَوْمِهِ.","لَسَٰحِرٌ عَلِيمٞ":"أي: ساحِرٌ ماهِرٌ."},"36":{"أَرۡجِهۡ":"أخِّرْهُ.","ٱلۡمَدَآئِنِ":"المُدُنِ.","حَٰشِرِينَ":"جامِعِينَ للسَّحَرةِ."},"45":{"تَلۡقَفُ":"تَبْتَلِعُ بِسُرْعَةٍ.","مَا يَأۡفِكُونَ":"ما يَكْذِبُونَهُ ويُمَوِّهُونَهُ."},"49":{"مِنۡ خِلَٰفٖ":"أي: بِقَطْعِ اليَدِ اليُمْنَى والرِّجْلِ اليُسْرَى، أو عَكْسِ ذَلِك.","وَلَأُصَلِّبَنَّكُمۡ":"وَلَأُبالِغَنَّ في شَدِّ أطْرَافِكُم، ورَبْطِ أجْسَادِكُم على جُذُوعِ النَّخْلِ."},"50":{"لَا ضَيۡرَ":"لَا ضَرَرَ عَلَينا فِيما يُصِيبُنا.","مُنقَلِبُونَ":"رَاجِعُونَ."},"51":{"أَوَّلَ ٱلۡمُؤۡمِنِينَ":"أي: مِن قَومِ فِرْعَونَ."},"52":{"أَنۡ أَسۡرِ بِعِبَادِيٓ":"أي: اخْرُجْ بِهِم لَيْلاً.","مُتَّبَعُونَ":"يَتَّبِعُكُم فِرْعَونُ وَجُنُودُه."},"53":{"ٱلۡمَدَآئِنِ":"المُدُنِ.","حَٰشِرِينَ":"جامِعِينَ لِلْجَيشِ."},"54":{"لَشِرۡذِمَةٞ":"لَطَائِفَةٌ حَقِيرَةٌ قَلِيلةُ العَدَدِ."},"55":{"لَنَا لَغَآئِظُونَ":"لَمُغْضِبُونا بِخُرُوجِهِم مِنْ غَيْرِ إذْنٍ مِنَّا."},"56":{"حَٰذِرُونَ":"مُتَيَقِّظُونَ."},"57":{"جَنَّٰتٖ":"بَساتِينَ."},"60":{"مُشۡرِقِينَ":"وقْتَ شُرُوقِ الشَّمْسِ."},"61":{"ٱلۡجَمۡعَانِ":"جَمْعُ مُوسَى وهُم بنُو إسْرَائيلَ، وجَمْعُ فِرْعَونَ وهم القِبْطُ.","لَمُدۡرَكُونَ":"لَمُلحَقُون من قِبَلِ فِرْعَونَ وجُنُودِهِ."},"63":{"فَٱنفَلَقَ":"أي: انْشَقَّ البَحْرُ إلى اثْنَي عَشْرَ طَرِيقاً.","فِرۡقٖ":"قِطْعةٍ من البحْرِ مُرْتَفِعَةٍ.","كَٱلطَّوۡدِ":"كالجَبَلِ المُتَطاوِلِ في السَّماءِ."},"64":{"وَأَزۡلَفۡنَا":"وقَرَّبْنا.","ثَمَّ":"هُنَاك.","ٱلۡأٓخَرِينَ":"وهم فِرْعَونُ وقَوْمُه."},"67":{"لَأٓيَةٗ":"لَعِبرةً عَجِيبةً."},"71":{"لَهَا عَٰكِفِينَ":"على عِبادتِها مُقِيمِينَ على الدَّوامِ."},"75":{"أَفَرَءَيۡتُم":"هَل تأمَّلْتُم ما أنْتُم عَلَيه؟"},"82":{"يَوۡمَ ٱلدِّينِ":"يومَ الجَزَاءِ."},"83":{"حُكۡمٗا":"عِلْماً وفَهْماً."},"84":{"لِسَانَ صِدۡقٖ":"ثَنَاءً حَسَناً.","فِي ٱلۡأٓخِرِينَ":"أي: في الَّذينَ يأتُونَ بَعْدِي إلى يومِ القِيَامَةِ."},"87":{"وَلَا تُخۡزِنِي":"وَلَا تَفْضَحْنِي."},"89":{"بِقَلۡبٖ سَلِيمٖ":"أي: مِنَ النِّفاقِ والكُفْرِ."},"90":{"وَأُزۡلِفَتِ":"قُرِّبَتْ."},"91":{"وَبُرِّزَتِ":"أُظْهِرَتْ.","لِلۡغَاوِينَ":"للضَّالِينَ عَن طَرِيقِ الهِدَايةِ."},"94":{"فَكُبۡكِبُواْ فِيهَا":"أُلْقُوا في جَهَنَّمَ على وُجُوهِهِم مرَّةً بَعْدَ مَرَّةٍ إلى أنِ اسْتَقرُّوا في قَعْرِها."},"96":{"يَخۡتَصِمُونَ":"يَتَنازَعُون."},"97":{"إِن كُنَّا":"إِنَّنَا كُنَّا."},"98":{"نُسَوِّيكُم بِرَبِّ ٱلۡعَٰلَمِينَ":"نَجْعَلُكُم مِثْلَ رَبِّ العالَمِينَ."},"100":{"شَٰفِعِينَ":"فَيُخَلِّصُونَا مِنَ الْعَذَابِ."},"101":{"حَمِيمٖ":"قَرِيبٍ ومُشْفِقٍ."},"102":{"كَرَّةٗ":"رَجْعَةً إلى الدُّنيا."},"111":{"ٱلۡأَرۡذَلُونَ":"أي: أَسَافلُ النَّاسِ وأَرَاذِلُهم."},"116":{"مِنَ ٱلۡمَرۡجُومِينَ":"مِنَ المقْتُولِينَ رَمْياً بالحِجَارَةِ."},"118":{"فَٱفۡتَحۡ":"فَاحْكُمْ."},"119":{"ٱلۡمَشۡحُونِ":"المَمْلُوءِ بالنَّاسِ والدَّوابِّ والمتَاعِ."},"128":{"رِيعٍ":"مكانٍ مُرْتَفِعٍ.","ءَايَةٗ":"بِنَاءً شَامِخاً."},"129":{"مَصَانِعَ":"حُصُوناً أو قُصُوراً.","تَخۡلُدُونَ":"أي: تَبْقَونَ في الدُّنيا ولا تَمُوتُونَ."},"130":{"بَطَشۡتُم":"أَخَذْتُم بِعُنْفٍ.","جَبَّارِينَ":"قاهِرِينَ ظالِمِين."},"132":{"أَمَدَّكُم":"أَنْعَمَ عليكُم وأَعْطَاكُم."},"133":{"بِأَنۡعَٰمٖ":"مِنَ الإِبِلِ، والبَقَرِ، والغَنَمِ."},"134":{"وَجَنَّٰتٖ":"حَدَائِقَ وبَسَاتِينَ."},"137":{"إِنۡ هَٰذَآ":"مَا هَذَا.","خُلُقُ ٱلۡأَوَّلِينَ":"دِينُ الأوَّلِينَ وعادَاتُهُم."},"146":{"فِي مَا هَٰهُنَآ":"أي: في الدُّنيا."},"147":{"جَنَّـٰتٖ":"حَدَائق وبَسَاتين.","وَعُيُونٖ":"عُيون الماءِ الجارية."},"148":{"طَلۡعُهَا":"ثَمَرُها.","هَضِيمٞ":"مُنْكَسِرٌ مِنْ لِينِهِ ورُطُوبَتِه."},"149":{"وَتَنۡحِتُونَ":"وتصنعون من الجِبال بُيوتاً بِحَفْرها وبَرْيِها.","فَٰرِهِينَ":"ماهِرِين بنَحْتِها."},"151":{"ٱلۡمُسۡرِفِينَ":"المتجاوزين الحَدَّ في الكُفْر والمعاصي."},"153":{"مِنَ ٱلۡمُسَحَّرِينَ":"مِنَ المغْلُوبِ على عُقُولِهِم بِكَثْرَةِ السِّحرِ."},"154":{"بِـَٔايَةٍ":"بِحُجَّةٍ واضِحَةٍ."},"155":{"لَهَا شِرۡبٞ":"لها نَصِيبٌ مِنَ الماءِ."},"156":{"وَلَا تَمَسُّوهَا بِسُوٓءٖ":"ولا تنالوها بِشَيْءٍ مِمّا يسُوءُها: كالضَّرْبِ أو القَتْلِ أو نحوِ ذلكَ.","فَيَأۡخُذَكُمۡ":"فَيَحِلَّ بكم ويُهْلِكَكُم."},"157":{"فَعَقَرُوهَا":"فَنَحَرُوها.","نَٰدِمِينَ":"مُتَحَسِّرِين مُتأَسِّفين عَلى ما بَدَرَ مِنْهُم."},"165":{"أَتَأۡتُونَ ٱلذُّكۡرَانَ":"أَتَنْكِحُونَ الرِّجالَ؟"},"166":{"وَتَذَرُونَ":"وَتَتْرُكُونَ.","عَادُونَ":"مُتَجَاوِزُونَ ما أباحَهُ اللهُ لَكُم مِنَ الحَلَالِ إلى الحَرَامِ."},"168":{"مِنَ ٱلۡقَالِينَ":"مِنَ المُبْغِضِينَ أَشَدَّ البُغْضِ."},"171":{"فِي ٱلۡغَٰبِرِينَ":"في الباقِينَ في العذابِ والهلاكِ."},"172":{"دَمَّرۡنَا":"أَهْلَكْنا."},"176":{"أَصۡحَٰبُ لۡـَٔيۡكَةِ":"أَصْحَابُ الشَّجَرِ الْمُلْتَفِّ."},"181":{"مِنَ ٱلۡمُخۡسِرِينَ":"مِنَ النَّاقِصِينَ للحُقُوقِ بالتَّطفِيفِ."},"182":{"بِٱلۡقِسۡطَاسِ":"بالميزانِ."},"183":{"وَلَا تَبۡخَسُواْ":"ولا تَنْقُصُوا.","وَلَا تَعۡثَوۡاْ":"ولا تُفْسِدُوا أَشَدَّ الإِفْسَادِ."},"184":{"وَٱلۡجِبِلَّةَ ٱلۡأَوَّلِينَ":"والخَلَائِقَ من الأُمَمِ المتقدِّمةِ."},"185":{"مِنَ ٱلۡمُسَحَّرِينَ":"مِنَ المغلُوبِ على عُقُولِهِم بِكَثْرَةِ السِّحْرِ."},"187":{"كِسَفٗا":"قِطَعَ عَذَابٍ."},"189":{"يَوۡمِ ٱلظُّلَّةِ":"أي: أظَلَّتْهُم سَحَابَةٌ، ثُمَّ أمْطَرَتْهُم نَاراً."},"193":{"ٱلرُّوحُ ٱلۡأَمِينُ":"جِبْرِيلُ عَلَيهِ السَّلامُ."},"196":{"وَإِنَّهُۥ":"وإِنَّ ذِكْرَ هَذَا القُرآنِ.","زُبُرِ ٱلۡأَوَّلِينَ":"كُتُبِ الرُّسُلِ السَّابِقِينَ."},"198":{"ٱلۡأَعۡجَمِينَ":"الَّذِينَ لا يتكَلَّمُونَ باللُّغةِ العَربيةِ."},"200":{"سَلَكۡنَٰهُ":"أدْخَلْناه."},"202":{"بَغۡتَةٗ":"فَجْأَةً."},"203":{"مُنظَرُونَ":"مُمْهَلُون لِنُؤمِنَ."},"205":{"مَتَّعۡنَٰهُمۡ سِنِينَ":"أي: طَوَّلْنا لَهُم أَعْمَارَهُم."},"207":{"مَآ أَغۡنَىٰ عَنۡهُم":"أي: لم يَنْفَعْهُم."},"209":{"ذِكۡرَىٰ":"أي: تَذْكِيرٌ وتَنْبِيهٌ."},"211":{"وَمَا يَنۢبَغِي لَهُمۡ":"ولا يَصِحُّ مِنْهُم."},"212":{"لَمَعۡزُولُونَ":"لمحْجُوبُونَ."},"214":{"عَشِيرَتَكَ":"قَبِيلَتَكَ."},"215":{"وَٱخۡفِضۡ جَنَاحَكَ":"أَلِنْ جانِبَكَ وتَوَاضَعْ."},"219":{"وَتَقَلُّبَكَ":"وَتَصرُّفَكَ، أو تَقَلُّبَكَ في الرُّكُوعِ والسُّجُودِ والقِيامِ."},"222":{"أَفَّاكٍ":"كَذَّابٍ.","أَثِيمٖ":"كَثِيرِ الآثامِ."},"223":{"يُلۡقُونَ ٱلسَّمۡعَ":"يُلْقُونَ ما سَمِعُوه مِنَ السَّماءِ إلى الكُهَّانِ."},"224":{"ٱلۡغَاوُۥنَ":"الضَّالُّونَ عَنِ الحقِّ."},"225":{"كُلِّ وَادٖ":"كلِّ فَنٍّ مِنْ فُنُونِ الكَذِبِ.","يَهِيمُونَ":"يخُوضُونَ."},"227":{"يَنقَلِبُونَ":"يَرْجِعُونَ إِليهِ."}}