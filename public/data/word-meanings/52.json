{"1":{"وَٱلطُّورِ":"هُوَ الجَبَلُ الَّذِي كَلَّمَ اللهُ عَلَيهِ مُوسَى عَلَيهِ السَّلامُ."},"2":{"مَسۡطُورٖ":"مَكْتُوبٍ، وَهُو القُرآنُ."},"3":{"فِي رَقّٖ مَّنشُورٖ":"مَكْتُوبٍ في صَحِيفةٍ مَبْسُوطَةٍ."},"4":{"وَٱلۡبَيۡتِ ٱلۡمَعۡمُورِ":"هو فَوْقَ السَّماءِ السَّابِعةِ، تَطُوفُ بِه الملائِكةُ دائِماً."},"5":{"وَٱلسَّقۡفِ ٱلۡمَرۡفُوعِ":"هو السَّماءُ الدُّنيا، جَعَلَها اللهُ سَقْفاً للأرْضِ."},"6":{"ٱلۡمَسۡجُورِ":"الممْلُوءِ بالمياهِ."},"8":{"دَافِعٖ":"مانِعٍ يَمْنَعُه حِينَ وقُوعِهِ."},"9":{"تَمُورُ":"تَتَحرَّكُ وتَضْطَرِبُ."},"10":{"وَتَسِيرُ":"تَزُولُ عَنْ أماكِنِها، وَتَسيرُ كَسَيرِ السَّحابِ."},"11":{"فَوَيۡلٞ":"فَهَلَاكٌ."},"12":{"فِي خَوۡضٖ":"في انْدِفاعٍ في الكَلَامِ الباطِلِ.","يَلۡعَبُونَ":"يَسْتَهْزِئُونَ."},"13":{"يُدَعُّونَ":"يُدْفَعُونَ.","دَعًّا":"دَفْعاً بِعُنْفٍ وَمهانَةٍ."},"16":{"ٱصۡلَوۡهَا":"ادْخُلُوها واحْتَرِقُوا بِنارِها."},"18":{"فَٰكِهِينَ":"طَيِّبَةً أَنْفُسُكُم، مُتَمَتِّعِينَ عَلَى وَجْهِ السُّرُورِ."},"19":{"هَنِيٓـَٔۢا":"أَكْلاً وَشُرْباً هَنِيئاً أي: سائِغاً."},"20":{"مُتَّكِـِٔينَ":"جالِسِين عَلَى وَجْهِ التَّمَكُّن والرَّاحةِ.","سُرُرٖ":"جَمْعُ سَرِيرٍ وهو ما يُضْطَجَعُ عَلَيهِ؛ وهو مَجْلِسُ المنَعَّمِينَ.","مَّصۡفُوفَةٖ":"مُتَقابِلَةٍ.","وَزَوَّجۡنَٰهُم":"قَرَنَّاهُم.","بِحُورٍ":"بِنِساءٍ شَدِيداتِ بَياضِ العَينِ وَسَوادها.","عِينٖ":"واسِعاتِ العُيونِ حِسانِهِنَّ."},"21":{"وَمَآ أَلَتۡنَٰهُم":"وما نَقَصْنَاهُم.","رَهِينٞ":"مَحْبُوسٌ مقْرُونٌ."},"22":{"وَأَمۡدَدۡنَٰهُم":"وَزِدْناهُم."},"23":{"يَتَنَٰزَعُونَ":"يَتَعاطَونَ، وَيُناوِلُ بعضُهم بَعْضاً.","كَأۡسٗا":"إِناءً مَمْلُوءاً مِنَ الخَمْرِ.","لَغۡوٞ":"كَلَامٌ لا فَائِدةَ فِيهِ.","تَأۡثِيمٞ":"إِثْمٌ ومَعْصِيَةٌ."},"24":{"مَكۡنُونٞ":"مَصُونٌ في أَصْدَافِهِ."},"26":{"مُشۡفِقِينَ":"خائِفِينَ مِنْ عَذابِ رَبِّنا."},"27":{"ٱلسَّمُومِ":"نَارِ جَهَنَّمَ وَحَرَارَتِها."},"28":{"ٱلۡبَرُّ":"المُحْسِنُ."},"29":{"بِكَاهِنٖ":"يُخْبِرُ بالغَيبِ دُونَ عِلْمٍ."},"30":{"نَتَرَبَّصُ":"نَنْتَظِرُ.","رَيۡبَ ٱلۡمَنُونِ":"حوادِثَ الدَّهرِ فَيَمُوتُ."},"32":{"أَحۡلَٰمُهُم":"عُقُولُهم.","طَاغُونَ":"مُتَجاوِزُونَ الحدَّ."},"33":{"تَقَوَّلَهُۥ":"اخْتَلَقَهُ."},"37":{"ٱلۡمُصَۜيۡطِرُونَ":"المُتَسَلِّطُونَ."},"38":{"سُلَّمٞ":"دَرَجٌ وَمَصْعَدٌ إلى السَّماءِ.","يَسۡتَمِعُونَ":"الكَلامَ الَّذِي يَجْرِي في السَّماءِ وَيَسْتَرِقُونَهُ.","بِسُلۡطَٰنٖ":"بِحُجَّةٍ."},"40":{"مَغۡرَمٖ":"غَرَامةٍ مَطْلُوبَةٍ مِنْهُم."},"42":{"كَيۡدٗا":"مَكْراً.","ٱلۡمَكِيدُونَ":"يَعُودُ ضَرَرُ مَكْرِهِم عَلَيهِم."},"44":{"كِسۡفٗا":"قِطَعاً كِباراً مِنَ العَذَابِ.","مَرۡكُومٞ":"مُتَراكِمٌ بَعْضُهُ فَوْقَ بَعْضٍ."},"45":{"فَذَرۡهُمۡ":"فَدَعْهُم.","يُصۡعَقُونَ":"يُهلَكُونَ."},"46":{"لَا يُغۡنِي":"لا يَدْفَعُ."},"47":{"عَذَابٗا دُونَ ذَٰلِكَ":"مِنَ القَتْلِ، والسَّبْيِ، وعَذابِ القَبْرِ."},"48":{"بِأَعۡيُنِنَا":"بِمَرْأىً مِنَّا وَحِفْظٍ واعْتِناءٍ.","حِينَ تَقُومُ":"إلى الصَّلاةِ، وحِينَ تَقُومُ مِنَ النَّومِ."},"49":{"وَإِدۡبَٰرَ ٱلنُّجُومِ":"عِنْدَ صَلَاةِ الصُّبْحِ، حِينَ يُغَطِّي ضَوءُ الصُّبْحِ النُّجُومَ."}}