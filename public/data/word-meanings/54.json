{"1":{"ٱلسَّاعَةُ":"القِيامَةُ.","وَٱنشَقَّ":"انْفَلَقَ فِلْقَتَينِ."},"2":{"ءَايَةٗ":"بُرْهاناً عَلَى صِدْقِ الرَّسُولِ مُحَمَّدٍ ﷺ.","مُسۡتَمِرّٞ":"ذاهِبٌ مُضْمَحِلٌّ لَا دَوامَ لَهُ."},"3":{"أَهۡوَآءَهُمۡ":"ما تُحِبُّهُ أَنفُسُهُم مِنَ الضَّلالِ والتَّكْذِيبِ.","أَمۡرٖ":"مِنْ خَيرٍ أَوْ شَرٍّ.","مُسۡتَقِرّٞ":"واقِعٌ بأَهْلِهِ يَوْمَ القِيامَةِ."},"4":{"مُزۡدَجَرٌ":"كِفايَةٌ لِرَدْعِهم."},"5":{"حِكۡمَةُۢ":"هَذا القُرْآنُ فِيهِ حِكْمَةٌ عَظِيمةٌ.","بَٰلِغَةٞ":"بالِغَةٌ غايَتَها.","فَمَا":"فأيُّ شَيءٍ.","تُغۡنِ":"تَدْفَعُ أَوْ تَنْفَعُ.","ٱلنُّذُرُ":"الإِنْذاراتُ."},"6":{"فَتَوَلَّ":"فَأَعْرِضْ.","ٱلدَّاعِ":"المَلَكُ بنَفْخِهِ في «القَرْنِ».","نُكُرٍ":"فَظِيعٍ مُنْكَرٍ، وهو موقِفُ الحِسابِ."},"7":{"خُشَّعًا":"ذَلِيلَةً.","ٱلۡأَجۡدَاثِ":"القُبُورِ.","مُنتَشِرٞ":"مُنْبَثٌّ عَلَى وَجْهِ الأرْضِ."},"8":{"مُهۡطِعِينَ":"مُسْرِعِينَ مادِّينَ أَعْناقَهُم.","ٱلدَّاعِ":"صوتِ المَلَكِ.","عَسِرٞ":"شَدِيدُ الْهَوْلِ."},"9":{"وَٱزۡدُجِرَ":"وانْتَهَرُوا نوحاً -عليه السلام- مُتَوَعِّدِينَ إِيَّاهُ بأنْواعِ الأَذَى."},"10":{"مَغۡلُوبٞ":"ضَعِيفٌ عَن مُقاوَمةِ هَؤُلَاءِ.","فَٱنتَصِرۡ":"لِي بِعِقابٍ مِنْ عِنْدِكَ."},"11":{"مُنۡهَمِرٖ":"كَثِيرٍ مُتَدَفِّقٍ."},"12":{"وَفَجَّرۡنَا":"وَشَقَقْنا.","عُيُونٗا":"مِنْ عُيُونٍ مُتَفَجِّرَةٍ بالماءِ.","فَٱلۡتَقَى ٱلۡمَآءُ":"فَالْتَقَى ماءُ السَّماءِ وماءُ الأرْضِ.","عَلَىٰٓ أَمۡرٖ قَدۡ قُدِرَ":"عَلَى إِهْلَاكِهِم الَّذِي قَدَّرَهُ اللهُ لَهُم."},"13":{"ذَاتِ أَلۡوَٰحٖ":"سَفِينَةٍ ذاتِ ألْوَاحٍ.","وَدُسُرٖ":"وَمَسامِيرَ شُدَّتْ بِها."},"14":{"بِأَعۡيُنِنَا":"بِمَرْأىً مِنَّا وحِفْظٍ."},"15":{"وَلَقَد تَّرَكۡنَٰهَآ":"وَلَقَدْ أَبْقَينا قِصَّةَ نُوحٍ.","ءَايَةٗ":"عِبْرةً.","مُدَّكِرٖ":"مُتَّعِظٍ."},"17":{"يَسَّرۡنَا":"سَهَّلْنا.","لِلذِّكۡرِ":"لِلتِّلاوَةِ، والحِفْظِ، والفَهْمِ، والتَّدَبُّرِ."},"19":{"صَرۡصَرٗا":"شَدِيدَةَ البَرْدِ والصَّوتِ.","نَحۡسٖ":"شُؤْمٍ.","مُسۡتَمِرّٖ":"اسْتَمَرَّ بِهِمُ العَذابُ إلَى أَن وَافَى بِهِمْ جَهَنَّمَ."},"20":{"تَنزِعُ ٱلنَّاسَ":"تَقْلَعُ النَّاسَ مِنَ الأرْضِ، فتَصْرَعُهم عَلَى رُؤوسِهِم، فَتَنْدَقُّ رِقابُهُم وَتَنْفَصِلُ عَنْ أَجْسامِهِم.","أَعۡجَازُ":"أُصُولُ.","مُنقَعِرٖ":"مُنْقَلِعٍ."},"23":{"بِٱلنُّذُرِ":"بالآياتِ الَّتِي أُنْذِرُوا بِها."},"24":{"ضَلَٰلٖ":"بُعْدٍ عَنِ الصَّوابِ.","وَسُعُرٍ":"جُنُونٍ."},"25":{"أَءُلۡقِيَ":"أَأُنْزِلَ.","ٱلذِّكۡرُ":"الوَحْيُ والقُرآنُ.","أَشِرٞ":"صاحِبُ بَطَرٍ وتَكَبُّرٍ."},"27":{"مُرۡسِلُواْ":"مُخْرِجُو.","فِتۡنَةٗ":"اخْتِباراً.","فَٱرۡتَقِبۡهُمۡ":"فَانْتَظِرْ ما يَحُلُّ عَلَيهِم مِنَ العَذَابِ.","وَٱصۡطَبِرۡ":"واصْبِرْ عَلَى الأَذَى الَّذِي يُصِيبُكَ مِنَ المدْعُوِّينَ."},"28":{"وَنَبِّئۡهُمۡ":"وَأَخْبِرْهُم.","قِسۡمَةُۢ":"مَقْسُومٌ.","بَيۡنَهُمۡ":"بَيْنَ ثَمُودَ والنَّاقَةِ.","كُلُّ شِرۡبٖ":"كُلُّ نَصِيبٍ مِن الشَّرابِ.","مُحۡتَضَرٞ":"يَحْضُرُهُ صاحِبُهُ وَيَسْتَحِقُّهُ."},"29":{"فَتَعَاطَىٰ":"فَتَناوَلَ النَّاقَةَ بِيَدِهِ لِيَعْقِرَها.","فَعَقَرَ":"فَقَتَلَ."},"31":{"كَهَشِيمِ":"كالشَّجَرِ اليابِسِ الَّذِي يَسْقُطُ وَيَتَناثَرُ.","ٱلۡمُحۡتَظِرِ":"الَّذِي يُرِيدُ أَن يَعْمَلَ سِياجاً لِحِفْظِ المواشِي فَيَحْتَطِبُ لِذَلِكَ."},"34":{"حَاصِبًا":"رِيحاً شَدِيدَةً تَرْمِيهِم بِحِجارَةٍ.","بِسَحَرٖ":"في آخِرِ الليلِ."},"35":{"نَجۡزِي":"نُثِيبُ.","مَن شَكَرَ":"مَنْ آمَنَ بِاللهِ وَوَحّدَهُ."},"36":{"وَلَقَدۡ أَنذَرَهُم":"خَوَّفَهُم.","بَطۡشَتَنَا":"بَأْسَنَا وَعَذَابَنا.","فَتَمَارَوۡاْ":"فَشَكُّوا.","بِٱلنُّذُرِ":"بالإنْذارِ."},"38":{"صَبَّحَهُم بُكۡرَةً":"جاءَهُم وَقْتَ الصَّباحِ.","مُسۡتَقِرّٞ":"نازلٌ بِهم."},"41":{"ءَالَ فِرۡعَوۡنَ":"أَتْباعَ فِرْعَونَ.","ٱلنُّذُرُ":"الإِنْذارُ تِلْو الإنْذارِ مِن مُوسَى -عَلَيهِ السَّلامُ- بالعُقُوبةِ عَلَى كُفْرِهِم."},"42":{"بِـَٔايَٰتِنَا":"بِأَدلَّتِنا الدَّالّةِ عَلَى وَحْدَانِيَّتِنا وَنُبُوَّةِ أَنْبِيائِنَا.","فَأَخَذۡنَٰهُمۡ":"فَعاقَبْناهُم.","عَزِيزٖ":"لا يُغالَبُ.","مُقۡتَدِرٍ":"قادِرٍ عَلَى هَلَاكِكُم."},"43":{"أَكُفَّارُكُمۡ":"يا مَعْشَرَ العَرَبِ.","بَرَآءَةٞ":"مِنَ العذَابِ ألَّا يُصِيبَكُم ما أَصابَهُم.","ٱلزُّبُرِ":"الكُتُبِ المنَزَّلةِ عَلَى الأنبياءِ المُتقَدِّمِينَ."},"44":{"نَحۡنُ جَمِيعٞ":"نَحْنُ يَدٌ وَاحِدَةٌ عَلَى مَن خالَفَنا.","مُنتَصِرٞ":"نَغْلِبُ غَيرَنا."},"45":{"ٱلۡجَمۡعُ":"جَمْعُ كُفَّارِ مَكَّةَ أمامَ المُؤمِنِينَ."},"46":{"أَدۡهَىٰ":"أَفْظَعُ وَأَعْظَمُ.","وَأَمَرُّ":"أَشدُّ مَرارَةً مِنَ القَتْلِ والأَسْرِ."},"47":{"ضَلَٰلٖ":"تِيهٍ عَنِ الحقِّ.","وَسُعُرٖ":"جُنُونٍ أو نارٍ تَسْتَعِرُ عَلَيهِم."},"48":{"يُسۡحَبُونَ":"يُجَرُّونَ.","مَسَّ سَقَرَ":"شِدَّةَ عَذابِ جَهَنَّمَ."},"49":{"بِقَدَرٖ":"بمِقْدارٍ قَدَّرْناهُ، وسَبَق عِلْمُنا بِهِ، وكِتابَتُنا لَهُ في اللَّوحِ المَحْفُوظِ."},"50":{"وَٰحِدَةٞ":"قَوْلَةٌ وَاحِدَةٌ، وهي «كُنْ».","كَلَمۡحِۭ بِٱلۡبَصَرِ":"فَيُوجَدُ في أقْصَرِ وَقْتٍ."},"51":{"أَشۡيَاعَكُمۡ":"أَشْباهَكُم في الكُفْرِ مِنَ الأُمَمِ السَّابِقَةِ.","مُدَّكِرٖ":"مُتَّعِظٍ."},"52":{"ٱلزُّبُرِ":"الكُتُبِ الَّتِي كَتَبَتْهَا الحَفَظَةُ."},"53":{"مُسۡتَطَرٌ":"مُسَطَّرٌ في صَحائِفِهم."},"55":{"مَقۡعَدِ صِدۡقٍ":"مَجْلِسِ حَقٍّ.","مَلِيكٖ":"اللهِ الملِكِ العَظِيمِ.","مُقۡتَدِرِۭ":"عَظِيمِ القُدْرَةِ."}}