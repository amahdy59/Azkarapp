{"1":{"هَلۡ":"قَدْ.","ٱلۡغَٰشِيَةِ":"القِيامةِ الَّتِي تَغْشَى النَّاسَ بأهْوالِها."},"2":{"وُجُوهٞ":"وُجُوهُ الكُفَّارِ.","خَٰشِعَةٌ":"ذَلِيلةٌ بالعذابِ."},"3":{"عَامِلَةٞ":"مُجْهَدَةٌ بالعَمَلِ.","نَاصِبَةٞ":"مُتْعَبَةٌ."},"4":{"تَصۡلَىٰ":"تُقاسِي ناراً.","حَامِيَةٗ":"شَدِيدَة التَّوَهُّجِ."},"5":{"ءَانِيَةٖ":"بَلَغَتْ مُنْتَهى الحرارةِ."},"6":{"ضَرِيعٖ":"نَبْتٍ ذي شَوْكٍ لَاصِقٍ بالأرْضِ."},"7":{"وَلَا يُغۡنِي مِن جُوعٖ":"ولا يَسُدُّ جُوعَهُ."},"8":{"وُجُوهٞ":"وُجُوهُ المؤمِنينَ.","نَاعِمَةٞ":"ذاتُ نِعْمَةٍ وَكَرَامةٍ."},"9":{"لِسَعۡيِهَا":"لِعَمَلِها الَّذِي عَمِلَتْهُ في الدُّنيا.","رَاضِيَةٞ":"في الآخِرَةِ حِينَ أُعْطِيَتِ الجنَّةَ بِعَمَلِها."},"10":{"عَالِيَةٖ":"رَفِيعةِ المكانِ والمكانةِ."},"11":{"لَٰغِيَةٗ":"كَلِمةَ لَغْوٍ."},"12":{"جَارِيَةٞ":"تَتَدَفَّقُ مِياهُها."},"14":{"مَوۡضُوعَةٞ":"مُعَدَّةٌ للشَّارِبِينَ."},"15":{"وَنَمَارِقُ":"وَوَسائِدُ ومَرافِقُ.","مَصۡفُوفَةٞ":"بَعضُها بِجَنبِ بَعْضٍ."},"16":{"وَزَرَابِيُّ":"وبُسُطٌ.","مَبۡثُوثَةٌ":"كَثِيرةٌ مَفْرُوشَةٌ."},"18":{"كَيۡفَ رُفِعَتۡ":"عَنِ الأرْضِ بِلا عَمَدٍ؟"},"19":{"نُصِبَتۡ":"رُفِعتْ حتَّى كانتْ بارزةً على وَجْهِ الأرضِ."},"20":{"سُطِحَتۡ":"بُسِطَتْ ومُهِّدتْ."},"21":{"فَذَكِّرۡ":"فَعِظْ.","مُذَكِّرٞ":"واعِظٌ."},"22":{"بِمُصَيۡطِرٍ":"بِمُسَلَّطٍ، فَتُكْرِهَهُم على الإيمانِ."},"23":{"تَوَلَّىٰ":"أَعْرَضَ وَأصَرَّ عَلى الكُفْرِ."},"24":{"ٱلۡعَذَابَ ٱلۡأَكۡبَرَ":"النَّارَ."},"25":{"إِيَابَهُمۡ":"مَرْجِعَهُم بَعْدَ الموتِ."},"26":{"حِسَابَهُم":"جَزاءَهُم."}}