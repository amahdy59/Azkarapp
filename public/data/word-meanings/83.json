{"1":{"وَيۡلٞ":"عذابٌ شَدِيدٌ.","لِلۡمُطَفِّفِينَ":"وَهُمُ الَّذِينَ يَبْخَسُونَ المِكْيالَ والِميزانَ."},"2":{"ٱلَّذِينَ إِذَا ٱكۡتَالُواْ عَلَى ٱلنَّاسِ":"الَّذِينَ إذا اشْتَرَوا مِنَ النَّاسِ مَكِيلاً أو مَوزُوناً.","يَسۡتَوۡفُونَ":"يَطْلُبُونَ وفاءَ نَصِيبِهِم."},"3":{"وَإِذَا كَالُوهُمۡ":"وَإذا باعُوا النَّاس مَكِيلاً.","وَزَنُوهُمۡ":"بَاعُوا النَّاسَ مَوزُوناً.","يُخۡسِرُونَ":"يَنْقُصُونَ في المِكيالِ والِميزانِ."},"4":{"يَظُنُّ":"يَعْتَقِدُ."},"7":{"كَلَّآ":"ليسَ الأَمْرُ كَما يَظُنُّ هَؤُلاءِ الكُفَّارُ، أنَّهم غَيرُ مَبْعُوثِينَ.","كِتَٰبَ ٱلۡفُجَّارِ":"صَحِيفةَ أَعْمالِ المُشْرِكِينَ.","لَفِي سِجِّينٖ":"أَسْفَلِ الأرْضِ السَّابِعَةِ."},"8":{"وَمَآ أَدۡرَىٰكَ":"وأيُّ شَيءٍ أعْلَمكَ؟ "},"9":{"مَرۡقُومٞ":"مَكْتُوبٌ كِتابَةً بَيِّنةً."},"10":{"وَيۡلٞ":"عذابٌ شَدِيدٌ."},"11":{"بِيَوۡمِ ٱلدِّينِ":"بُوقُوعِ يَومِ الجَزاءِ."},"12":{"مُعۡتَدٍ":"ظالِمٍ.","أَثِيمٍ":"كَثِيرِ الإِثْمِ."},"13":{"أَسَٰطِيرُ ٱلۡأَوَّلِينَ":"أباطِيلُ السَّابِقِينَ."},"14":{"رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُواْ يَكۡسِبُونَ":"غَطَّى عَلى قُلُوبِهِم كَثْرَةُ ما يَرْتَكِبُونَهُ مِنَ الذُّنُوبِ."},"15":{"عَن رَّبِّهِمۡ":"عَن رُؤْيَةِ رَبِّهِم جَلَّ وَعَلَا.","لَمَحۡجُوبُونَ":"لَمَمْنُوعُونَ."},"16":{"لَصَالُواْ ٱلۡجَحِيمِ":"لَدَاخِلُو النَّارِ."},"18":{"كَلَّا":"حَقّاً.","كِتَٰبَ":"صَحائِفَ أَعْمالِ.","ٱلۡأَبۡرَارِ":"الأَتْقِيَاءِ.","لَفِي عِلِّيِّينَ":"لَفِي المراتِبِ العالِيَةِ في الجنَّةِ."},"20":{"كِتَٰبٞ مَّرۡقُومٞ":"مَكْتُوبٌ كِتابَةً بَيِّنةً."},"21":{"يَشۡهَدُهُ":"يَطَّلِعُ عَلَيهِ.","ٱلۡمُقَرَّبُونَ":"الملائكةُ المُقرَّبُونَ مِنَ اللهِ."},"22":{"ٱلۡأَبۡرَارَ":"أَهْلَ الصِّدقِ والطَّاعَةِ.","لَفِي نَعِيمٍ":"لَفِي الجنَّةِ يَتَنَعَّمُونَ."},"23":{"ٱلۡأَرَآئِكِ":"الأَسِرَّةِ.","يَنظُرُونَ":"يَنْظُرُونَ إلى رَبِّهِم، وَإلى ما أَعَدَّ لَهُم مِنْ خَيراتٍ."},"24":{"نَضۡرَةَ ٱلنَّعِيمِ":"بَهْجَةَ النَّعِيمِ وحُسْنَه."},"25":{"رَحِيقٖ":"خَمْرٍ صافِيةٍ.","مَخۡتُومٍ":"مُحْكَمٍ إِناؤُها."},"26":{"خِتَٰمُهُۥ":"آخِرُهُ.","مِسۡكٞ":"رائِحَةُ مِسْكٍ.","فَلۡيَتَنَافَسِ ٱلۡمُتَنَٰفِسُونَ":"فَليَتَسابَقِ المُتَسابِقُونَ."},"27":{"وَمِزَاجُهُۥ مِن تَسۡنِيمٍ":"وخَلْطُه مِنْ عَينٍ في الجنَّةِ تُعْرَفُ بـ «تَسْنِيمٍ»."},"28":{"يَشۡرَبُ بِهَا":"أَيْ: مِنْهاَ.","ٱلۡمُقَرَّبُونَ":"الأَبْرارُ المقَرَّبون مِن اللهِ، المُكَرَّمون في الجَنَّةِ."},"29":{"أَجۡرَمُواْ":"ارْتَكَبُوا الإثمَ العَظِيمَ، وهو الشِّرْكُ.","يَضۡحَكُونَ":"يَهْزَؤُونَ."},"30":{"يَتَغَامَزُونَ":"يُشِيرُونَ بأطْرافِ العُيُونِ سُخْرِيَةً بِهم."},"31":{"وَإِذَا ٱنقَلَبُوٓاْ":"رَجَعُوا.","فَكِهِينَ":"مُتَفَكِّهِينَ بالسُّخْرِيَةِ مِنَ المُؤْمِنِينَ."},"32":{"رَأَوۡهُمۡ":"رَأَى هَؤُلاءِ الكُفَّارُ أَصْحابَ مُحَمَّدٍ ﷺ."},"33":{"حَٰفِظِينَ":"رُقَباءَ عَلَى أصْحابِ مُحَمَّدٍ ﷺ."},"35":{"ٱلۡأَرَآئِكِ":"المجالِسِ الفاخِرَةِ.","يَنظُرُونَ":"يَنْظُرُ المؤمِنُونَ إلى ما أَعْطاهُم اللهُ مِنَ الكَرَامةِ والنَّعِيم في الجنَّةِ."},"36":{"هَلۡ ثُوِّبَ ٱلۡكُفَّارُ":"هل جُوزِي الكُفَّارُ مِن جِنْسِ أَعمالِهِم؟"}}