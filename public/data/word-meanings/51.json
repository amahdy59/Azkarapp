{"1":{"وَٱلذَّٰرِيَٰتِ":"الرِّياحِ المُثِيرَاتِ للتُّرَابِ."},"2":{"فَٱلۡحَٰمِلَٰتِ":"فالسُّحُبِ الحامِلاتِ.","وِقۡرٗا":"ثِقَلاً عَظِيماً مِنَ الماءِ."},"3":{"فَٱلۡجَٰرِيَٰتِ":"فَالسُّفُنِ الجارِياتِ في البِحارِ.","يُسۡرٗا":"جَرْياً ذا يُسْرٍ وسُهُولةٍ."},"4":{"فَٱلۡمُقَسِّمَٰتِ":"فالملائِكةِ المُقَسِّماتِ.","أَمۡرًا":"أَمْرَ اللهِ في خَلْقِهِ."},"5":{"لَصَادِقٞ":"لَكائِنٌ حقٌّ يَقِينٌ."},"6":{"ٱلدِّينَ":"الحِسابَ.","لَوَٰقِعٞ":"لَكَائِنٌ لَا مَحالةَ."},"7":{"ذَاتِ ٱلۡحُبُكِ":"ذاتِ الخَلْقِ الحَسَنِ."},"8":{"مُخۡتَلِفٖ":"مُضْطَرِبٍ."},"9":{"يُؤۡفَكُ":"يُصْرَفُ."},"10":{"قُتِلَ":"لُعِنَ.","ٱلۡخَرَّٰصُونَ":"الكَذّابُونَ الظَّانُّونَ غيرَ الحقِّ."},"11":{"غَمۡرَةٖ":"لُجَّةٍ مِنَ الكُفْرِ.","سَاهُونَ":"غافِلُونَ."},"12":{"أَيَّانَ":"مَتَى.","يَوۡمُ ٱلدِّينِ":"يومُ الجَزَاءِ."},"13":{"يُفۡتَنُونَ":"يُعَذَّبُونَ بالإحْرَاقِ بالنَّارِ."},"14":{"فِتۡنَتَكُمۡ":"عَذَابَكُم"},"16":{"ءَاخِذِينَ":"قابِلينَ على وَجْهِ الرِّضا.","ءَاتَىٰهُمۡ":"أعْطاهُم.","مُحۡسِنِينَ":"فاعِلِينَ الحَسَناتِ والطَّاعاتِ."},"17":{"يَهۡجَعُونَ":"يَنامُونَ."},"18":{"وَبِٱلۡأَسۡحَارِ":"جَمْعُ سَحَر، وَهُو آخِرُ الليلِ."},"19":{"حَقّٞ":"واجِبٌ ثابِتٌ.","لِلسَّآئِلِ":"الَّذِي يُظْهِرُ فَقْرَهُ، فَيسْأَلُ النَّاسَ.","وَٱلۡمَحۡرُومِ":"الفَقِيرِ المُتَعَفِّفِ."},"20":{"لِلۡمُوقِنِينَ":"لِأَهْلِ اليقِينِ بِأنَّ اللهَ وَرَسُولَه حَقٌّ."},"21":{"وَفِيٓ أَنفُسِكُمۡ":"وَفي خَلْقِ أَنْفُسِكُم دَلَائِلُ وَعِبَرٌ."},"22":{"رِزۡقُكُمۡ":"مادَّةُ رِزْقِكُم، مِنَ الأمْطارِ، وصُنُوفِ الأقْدَارِ.","وَمَا تُوعَدُونَ":"مِنَ الجَزاءِ في الدُّنيا والآخِرةِ."},"23":{"مِثۡلَ مَآ أَنَّكُمۡ تَنطِقُونَ":"فَتَحَقَّقَ الوعِيدُ مِثْلَ نُطْقِكُم الَّذِي لا تَشُكُّونَ فِيهِ."},"24":{"ضَيۡفِ إِبۡرَٰهِيمَ":"هُم مِن الملائِكةِ."},"25":{"سَلَٰمٗا":"سَلَّمنا سَلَاما.","سَلَٰمٞ":"أَمْرِي سَلامٌ لَكُم.","مُنكَرُونَ":"لا أَعْرِفُهُم."},"26":{"فَرَاغَ":"فَمَال خِفْيَةً."},"28":{"فَأَوۡجَسَ":"أَحَسَّ في نَفْسِهِ.","بِغُلَٰمٍ عَلِيمٖ":"هو إسْحاقُ عَلَيهِ السَّلامُ."},"29":{"صَرَّةٖ":"صَيْحَةٍ.","فَصَكَّتۡ":"فَلَطَمَتْ.","عَقِيمٞ":"لا تَحْمِلُ."},"31":{"فَمَا خَطۡبُكُمۡ":"فَمَا شَأنُكُم؟"},"32":{"قَوۡمٖ مُّجۡرِمِينَ":"هُم قَومُ لُوطٍ عَلَيهِ السَّلامُ."},"34":{"مُسَوَّمَةً":"عَلَيها عَلَامةٌ، وَكُلُّ حَجَرٍ عَلَيهِ اسْمُ صاحِبِهِ.","لِلۡمُسۡرِفِينَ":"للمُفَرِّطِينَ بِكُفْرِهِم وشُيُوعِ الفاحِشَةِ فِيهِم."},"36":{"بَيۡتٖ":"بيتِ لُوطٍ عَلَيهِ السَّلامُ."},"37":{"تَرَكۡنَا":"أَبْقينَا.","ءَايَةٗ":"أَثَراً مِن العَذَابِ والخَرَابِ يُتَّعظُ بِه."},"38":{"بِسُلۡطَٰنٖ":"بِحُجَّةٍ."},"39":{"فَتَوَلَّىٰ":"فَأَعْرَضَ.","بِرُكۡنِهِۦ":"بِقُوَّتِهِ وجانِبِهِ."},"40":{"فَأَخَذۡنَٰهُ":"فَأَهْلَكْنَاهُ.","فَنَبَذۡنَٰهُمۡ":"فَطَرَحْناهُم.","ٱلۡيَمِّ":"البَحْرِ.","مُلِيمٞ":"مُسْتَوْجِبٌ العِقابَ، آتٍ بِما يَلُومُهُ اللهُ عَلَيهِ."},"41":{"ٱلۡعَقِيمَ":"التي لا بَرَكَةَ فِيها وَلَا تَأْتِي بِخَيرٍ."},"42":{"مَا تَذَرُ":"ما تَدَعُ.","كَٱلرَّمِيمِ":"العَظْمِ الَّذِي بَلِيَ فَتَفَتَّتَ."},"43":{"تَمَتَّعُواْ":"مُباحٌ لكُم أَن تَتَمَتَّعُوا بِنِعَمِ الدُّنيا الزّائِلةِ.","حَتَّىٰ حِينٖ":"إِلى آجالِكُم."},"44":{"فَعَتَوۡاْ":"تَكَبَّرُوا فَأَعْرَضُوا.","فَأَخَذَتۡهُمُ":"فَأَصَابَتْهُم.","ٱلصَّٰعِقَةُ":"الصَّيحَةُ العَظِيمَةُ المُهْلِكَةُ.","يَنظُرُونَ":"إلى عُقُوبَتِهِم بأَعْيُنِهِم فَيَكُونُ أَشَدَّ للعُقُوبَةِ."},"45":{"قِيَامٖ":"نُهُوضٍ ودِفاعٍ."},"47":{"بَنَيۡنَٰهَا":"خَلَقْناهَا وَجَعَلْناهَا سَقْفاً لِلأَرْضِ.","بِأَيۡيْدٖ":"بِقُوَّةٍ.","لَمُوسِعُونَ":"لَمُقْتَدِرُونَ، مِنْ “أوْسَعَ” إِذا كَانَ ذَا وُسْعٍ، أي: قُدْرةٍ."},"48":{"فَرَشۡنَٰهَا":"جَعَلْنَاهَا فِراشاً لاسْتِقْرَارِ الخَلْقِ عَلَيها.","ٱلۡمَٰهِدُونَ":"المُوطِّئُونَ الَمُهَيِّئُونَ."},"49":{"زَوۡجَيۡنِ":"صِنْفَينِ: ذَكَراً وأُنْثَى."},"50":{"فَفِرُّوٓاْ":"فارِقُوا الشِّرْكَ المُسَبِّبَ لِعَذابِكُم."},"53":{"أَتَوَاصَوۡاْ":"هَلْ أوْصَى بَعْضُهُم بَعْضاً؟","طَاغُونَ":"مُتَعَدُّونَ، طُغَاةٌ عَنْ أَمْرِ رَبِّهِم."},"54":{"فَتَوَلَّ عَنۡهُمۡ":"فأَعْرِضْ عَنْهُم.","فَمَآ أَنتَ بِمَلُومٖ":"فَلَيسَ عَلَيكَ لَوْمٌ في ذَنْبِهِم."},"55":{"ٱلذِّكۡرَىٰ":"التَّذْكِيرَ والمَوعِظَةَ."},"56":{"لِيَعۡبُدُونِ":"إرَادَةَ أَن يَعْبُدُونِي إِرَادَةً شَرْعِيَّةً دِينِيَّةً، وقَدْ تَقَعُ العِبادة وَقَدْ لَا تَقَعُ."},"58":{"ٱلۡمَتِينُ":"الشَّدِيدُ الكامِلُ في قُوَّتِهِ."},"59":{"ذَنُوبٗا":"حَظّاً ونَصِيباً."},"60":{"فَوَيۡلٞ":"عَذابٌ وَهَلاكٌ."}}