{"1":{"طسٓ":"سَبَقَ الكَلامُ على الحُرُوفِ المُقَطَّعةِ في أوَّلِ سُورَةِ البَقَرةِ."},"4":{"يَعۡمَهُونَ":"يَتَرَدَّدُونَ ويَتَحَيَّرُونَ."},"7":{"ءَانَسۡتُ":"أَبْصَرْتُ ما يُؤْنِسُ.","بِشِهَابٖ قَبَسٖ":"بِشُعْلَةِ نارٍ مَقْبُوسَةٍ، أي: مأخُوذَةٍ.","تَصۡطَلُونَ":"تَسْتَدْفِئُونَ بِها."},"8":{"بُورِكَ مَن فِي ٱلنَّارِ":"أي: إنَّ اللهَ باركَ مَن فِي النَّارِ، ومَنْ حَولَها مِنَ الملائِكَةِ."},"10":{"تَهۡتَزُّ":"تَتَحَرَّكُ بخِفَّةٍ.","جَآنّٞ":"حَيَّةٌ خَفِيفَةٌ في سُرْعَةِ حَرَكَتِها.","وَلَّىٰ":"هرَبَ.","وَلَمۡ يُعَقِّبۡ":"لم يَرْجِعْ."},"12":{"فِي جَيۡبِكَ":"في فَتْحَةِ قَمِيصِكَ الَّتي يُدْخَلُ منها الرَّأسُ.","مِنۡ غَيۡرِ سُوٓءٖ":"مِنْ غَيرِ بَرَصٍ ولا مَرَضٍ.","فِي تِسۡعِ ءَايَٰتٍ":"وهي: اليدُ، والْعَصَا، والسِّنونَ، ونَقْصُ الثَّمراتِ، والطُّوفانُ، والجَرَادُ، والقُمَّلُ، والضَّفادِعُ، والدَّمُ."},"13":{"مُبۡصِرَةٗ":"واضِحَةً هادِيةً."},"14":{"وَجَحَدُواْ بِهَا":"أنْكَرُوهَا بألْسِنَتِهِم.","وَعُلُوّٗا":"تَرَفُّعاً واسْتِكْباراً عَنِ الإيمانِ بِها."},"16":{"وَوَرِثَ سُلَيۡمَٰنُ دَاوُۥدَ":"أي: نُبوَّتَه وعِلْمَه ومُلْكَه.","مَنطِقَ ٱلطَّيۡرِ":"فَهْمَ أغْرَاضِه كلِّها مِنْ أصْواتِه.","وَأُوتِينَا":"وأُعْطِينا."},"17":{"وَحُشِرَ":"وجُمِعَ.","فَهُمۡ يُوزَعُونَ":"فهم يُكَفُّونَ عَنِ التَّفرُّقِ، فكان على كُلِّ جِنْسٍ مَن يَرُدُّ أوَّلَهم على آخِرِهم كي يقِفُوا ويسِيرُوا مُنْتَظِمِينَ."},"18":{"لَا يَحۡطِمَنَّكُمۡ":"أي: لا تُمَكِّنوهُم مِن قَتْلِكُم وإهْلَاكِكُم."},"19":{"أَوۡزِعۡنِيٓ":"أَلْهِمْنِي ووَفِّقْنِي."},"21":{"بِسُلۡطَٰنٖ مُّبِينٖ":"بِحُجَّةٍ تُبيِّنُ عُذْرَه في غِيابِه."},"22":{"أَحَطتُ":"عَلِمْتُ الأمرَ مِن جَميعِ جِهاتِهِ.","سَبَإِۭ":"بَلَدٍ باليمنِ، سُمِّي باسْمِ «سَبأِ بنِ يَشْجُبَ»، ويقَعُ شَرْقَ صَنْعَاء، ويُسَمَّى الآنَ «مَأْرِباً»."},"23":{"وَلَهَا عَرۡشٌ":"أي: سَرِيرُ المُلْكِ، تَجْلِسُ عليه لإدارةِ مُلْكِها."},"24":{"فَصَدَّهُمۡ":"فَصَرَفَهُم."},"25":{"ٱلۡخَبۡءَ":"المخْبُوءَ المسْتُورَ."},"27":{"سَنَنظُرُ":"أي: سَنَتَأَمَّلُ."},"28":{"تَوَلَّ عَنۡهُمۡ":"تَنَحَّ عَنْهُم."},"31":{"أَلَّا تَعۡلُواْ عَلَيَّ":"ألَّا تَتَكَبَّرُوا عليَّ."},"32":{"يَٰٓأَيُّهَا ٱلۡمَلَؤُاْ":"يا أيُّها الأشْرَافُ.","أَفۡتُونِي":"أشِيرُوا عَليَّ.","قَاطِعَةً أَمۡرًا":"مُبْرِمَةً أمْراً.","تَشۡهَدُونِ":"تَحْضُرُونِ."},"33":{"وَأُوْلُواْ بَأۡسٖ":"أصْحَابُ نَجْدةٍ وبَلَاءٍ في الحرْبِ."},"35":{"فَنَاظِرَةُۢ":"فمُنتَظِرةٌ."},"37":{"لَا قِبَلَ لَهُم بِهَا":"لا طَاقَةَ لَهُم بِمُقَاوَمَتِها.","صَٰغِرُونَ":"ذَلِيلُونَ مُهَانُونَ."},"39":{"عِفۡرِيتٞ":"مارِدٌ قويٌّ شَدِيدٌ."},"40":{"أَن يَرۡتَدَّ":"أن يَرْجِعَ.","طَرۡفُكَ":"نَظَرُكَ.","لِيَبۡلُوَنِيٓ":"لِيَخْتَبِرَنِي.","أَمۡ أَكۡفُرُ":"أي: بِتَرْكِ شُكْرِ النِّعْمةِ."},"41":{"نَكِّرُواْ":"غيِّرُوا."},"42":{"وَأُوتِينَا ٱلۡعِلۡمَ":"وأُعْطِينا العِلْمَ بِاللهِ وبِقُدْرَتِه."},"44":{"ٱلصَّرۡحَ":"القَصْرَ.","حَسِبَتۡهُ لُجَّةٗ":"ظنَّتْهُ ماءً تتردَّدُ أَمْوَاجُه.","مِن قَوَارِيرَ":"مِن زُجَاجٍ صافٍ شَفَّافٍ."},"45":{"يَخۡتَصِمُونَ":"يَتَنَازَعُونَ."},"46":{"بِٱلسَّيِّئَةِ قَبۡلَ ٱلۡحَسَنَةِ":"أي: بالكُفْرِ قَبْلَ الإيمانِ."},"47":{"ٱطَّيَّرۡنَا بِكَ":"تَشَاءَمْنا بِكَ، لأنَّنا أُصِبْنا بالشَّدائِدِ.","طَٰٓئِرُكُمۡ":"شُؤْمُكُم.","عِندَ ٱللَّهِ":"أي: قَدَّرَهُ اللهُ عَلَيكُم.","تُفۡتَنُونَ":"تُمتَحَنُونَ وتُخْتَبرُونَ."},"48":{"رَهۡطٖ":"رِجَالٍ مِنْ أبْنَاءِ الأشْرَافِ."},"49":{"تَقَاسَمُواْ بِٱللَّهِ":"تحَالَفُوا باللهِ.","لَنُبَيِّتَنَّهُۥ":"لَنَأْتِيَنَّهُ بَغْتَةً في الليلِ، فَنْقتُلَهُ.","مَا شَهِدۡنَا":"ما حَضَرْنا."},"50":{"وَمَكَرُواْ":"دبَّرُوا الشَّرَّ بِحِيلَةٍ."},"51":{"دَمَّرۡنَٰهُمۡ":"أهْلكْناهُم."},"52":{"خَاوِيَةَۢ":"خَالِيةً خَرِبةً."},"56":{"يَتَطَهَّرُونَ":"يَتَنَزَّهُونَ عَنْ إِتْيانِ الرِّجالِ."},"57":{"مِنَ ٱلۡغَٰبِرِينَ":"مِنَ الباقِينَ في العَذَابِ والهَلَاكِ."},"59":{"ٱصۡطَفَىٰٓ":"اخْتارَ."},"60":{"حَدَآئِقَ ذَاتَ بَهۡجَةٖ":"بَسَاتِينَ ذاتَ مَنْظَرٍ حَسَنٍ.","يَعۡدِلُونَ":"يَنْحَرِفُونَ عَن طَرِيقِ الحقِّ إلى طَرِيقِ الباطِلِ وهو الشِّركُ."},"61":{"قَرَارٗا":"مُسْتَقَرّاً.","خِلَٰلَهَآ":"وَسَطَها.","رَوَٰسِيَ":"جِبالاً ثَوَابِتَ.","ٱلۡبَحۡرَيۡنِ":"العَذْبِ والمِلْحِ.","حَاجِزًا":"فاصِلاً يَمْنَعُ اخْتِلَاطَهُما."},"62":{"ٱلۡمُضۡطَرَّ":"الَّذي أَصابَه بَلَاءٌ وَشِدَّةٌ.","خُلَفَآءَ":"أي: تَخْلُفُونَ مَنْ سَبَقَكُم في الأرضِ."},"63":{"بُشۡرَۢا":"تُبَشِّرُ بالمَطَرِ."},"64":{"يَبۡدَؤُاْ ٱلۡخَلۡقَ":"يُنْشِئُه.","بُرۡهَٰنَكُمۡ":"حُجَّتَكُم."},"65":{"أَيَّانَ يُبۡعَثُونَ":"مَتَى يُبْعثُونَ مِن قُبُورِهِم."},"66":{"بَلِ ٱدَّٰرَكَ عِلۡمُهُمۡ فِي ٱلۡأٓخِرَةِ":"بَلْ تَكَامَلَ علمُهُم بِها عِنْدَما بُعِثُوا يومَ القيامةِ.","فِي شَكّٖ مِّنۡهَا":"أي: مِنَ الآخِرةِ في الدُّنيا.","عَمُونَ":"أي: غافِلُونَ، فَقُلُوبُهُم عَمْيَاءُ."},"67":{"لَمُخۡرَجُونَ":"لمَبْعُوثُونَ مِن قُبُورِنا."},"68":{"أَسَٰطِيرُ ٱلۡأَوَّلِينَ":"الأكاذيبُ الَّتي كَتَبها المتقدِّمُونَ."},"70":{"ضَيۡقٖ":"حَرَجٍ وضِيقِ صَدْرٍ."},"72":{"رَدِفَ لَكُم":"لَحِقَكُم، أو اقْتَرَبَ لَكُم."},"74":{"مَا تُكِنُّ":"ما تُخْفِي.","وَمَا يُعۡلِنُونَ":"وما يُظْهِرُونَ."},"75":{"غَآئِبَةٖ":"هو كلُّ ما يَغيبُ ويَخْفى عَلى الخَلْقِ.","كِتَٰبٖ مُّبِينٍ":"وَاضِحٍ، وهو اللَّوْحُ المحْفُوظ."},"80":{"مُدۡبِرِينَ":"مُعْرِضِينَ."},"82":{"وَقَعَ ٱلۡقَوۡلُ":"أي: وَجَبَ العَذَابُ.","دَآبَّةٗ":"هي مِنْ أشْراطِ السَّاعةِ الكُبْرى.","تُكَلِّمُهُمۡ":"تُحدِّثُهُم.","لَا يُوقِنُونَ":"لا يُصَدِّقُونَ."},"83":{"نَحۡشُرُ":"نَجْمَعُ.","فَهُمۡ يُوزَعُونَ":"فهم يُكَفُّونَ عَنِ التَّفَرُّقِ، فكان على كُلِّ جِنْسٍ مَنْ يَرُدُّ أوَّلَهم على آخِرِهِم ثُمَّ يُسَاقُون جميعاً."},"87":{"ٱلصُّورِ":"القَرْنِ الَّذي يُنفَخُ فيهِ للبَعْثِ.","فَفَزِعَ":"خافَ خَوْفاً شَدِيداً مِنْ هَوْلِ النَّفخَةِ.","دَٰخِرِينَ":"صاغِرِينَ مُطِيعِينَ."},"88":{"تَحۡسَبُهَا جَامِدَةٗ":"تَظُنُّها ثابِتةً في أماكِنِها.","مَرَّ ٱلسَّحَابِ":"مِثْلَ السَّحابِ الَّذي تُسَيِّرُه الرِّياحُ."},"90":{"فَكُبَّتۡ وُجُوهُهُمۡ فِي ٱلنَّارِ":"أي: أُلقُوا على وُجُوهِهِم فِيها."},"91":{"حَرَّمَهَا":"جَعَلها حَرَماً آمِناً لا يُسْفَكُ فيها دَمٌ."}}