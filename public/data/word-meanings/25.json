{"1":{"تَبَارَكَ":"تَكَاثَرَ خَيْرُه، وعَظُمَتْ بَرَكَاتُه.","ٱلۡفُرۡقَانَ":"القُرآنَ، الفارقَ بَيْنَ الحقِّ والْبَاطِلِ.","نَذِيرًا":"مُخَوِّفاً."},"2":{"فَقَدَّرَهُۥ":"أي: فَهَيَّأَه لِمَا يَصْلُحُ لَهُ وَيلِيقُ بِهِ."},"3":{"نُشُورٗا":"بَعْثاً بَعْدَ الموتِ."},"4":{"هَٰذَآ":"أي: القرآنُ.","إِفۡكٌ":"كَذِبٌ وبُهْتانٌ.","ٱفۡتَرَىٰهُ":"اختَلَقَه وتَقَوَّلَه.","قَوۡمٌ ءَاخَرُونَ":"أي: من الَّذينَ أسْلَمُوا مِنْ أَهْلِ الكِتابِ.","وَزُورٗا":"كَذِباً عظِيماً."},"5":{"أَسَٰطِيرُ ٱلۡأَوَّلِينَ":"الأكاذيبُ الَّتي كَتَبها المتقدِّمُونَ.","ٱكۡتَتَبَهَا":"طَلَبَ كِتابَتَها.","تُمۡلَىٰ عَلَيۡهِ":"تُقْرَأُ عَلَيهِ لِيَحْفَظَها."},"6":{"ٱلسِّرَّ":"هو كلُّ ما يَغِيبُ ويَخْفَى."},"8":{"جَنَّةٞ":"أي: بُسْتانٌ مُثْمِرٌ.","مَسۡحُورًا":"مَجْنُوناً، غَلَبَ السِّحرُ على عَقْلِه."},"10":{"جَنَّٰتٖ":"بَسَاتِينَ وحَدَائقَ.","قُصُورَۢا":"بُيُوتاً مُشَيَّدةً."},"11":{"وَأَعۡتَدۡنَا":"وجَعَلْناه مُعَدّاً لهم.","سَعِيرًا":"أي: ناراً مُشْتَعِلةً تُسَعَّر بهم."},"12":{"تَغَيُّظٗا":"صَوْتَ غَلَيانٍ وفَوَرانٍ.","وَزَفِيرٗا":"النَّفَسَ الخارِجَ مِنَ الجَوفِ بِشِدَّةٍ."},"13":{"مِنۡهَا":"أي: مِن جَهَنَّمَ.","مُقَرَّنِينَ":"مُقَيَّدةً أيدِيهِم إلى أعْناقِهِم.","ثُبُورٗا":"هَلَاكاً."},"15":{"وَمَصِيرٗا":"ومَرْجِعاً."},"16":{"مَّسۡـُٔولٗا":"أي: يَسْأَلُ اللهَ عِبَادُه المتَّقُونَ."},"18":{"سُبۡحَٰنَكَ":"تَنْزِيهاً لَكَ يا رَبَّنا.","مَا كَانَ يَنۢبَغِي لَنَآ":"ما كان يَحِقُّ ولا يَصِحُّ لَنا.","أَوۡلِيَآءَ":"المُرادُ به: آلهةٌ نَعْبُدُهُم.","نَسُواْ ٱلذِّكۡرَ":"غَفَلُوا عَن دَلَائِلِ الوَحْدَانيَّةِ.","بُورٗا":"هَالِكِينَ أو فَاسِدِين."},"19":{"صَرۡفٗا":"دَفْعاً.","يَظۡلِم":"أي: يُشْرِكْ بِاللهِ."},"20":{"فِتۡنَةً":"ابْتِلاءً واخْتِباراً."},"21":{"لَا يَرۡجُونَ":"لَا يخافُونَ.","أَوۡ نَرَىٰ":"أي: عِيَاناً.","ٱسۡتَكۡبَرُواْ فِيٓ أَنفُسِهِمۡ":"أَضْمَرُوا الاسْتِكْبارَ عَنِ الحَقِّ في قُلُوبِهِم.","وَعَتَوۡ":"تَجاوَزُوا الحدَّ في الطُّغيانِ."},"22":{"حِجۡرٗا مَّحۡجُورٗا":"حَرَاماً محرَّماً عَلَيكُمُ الجنَّةُ."},"23":{"هَبَآءٗ":"أي: كالْهبَاءِ وهو ما يُرَى في ضَوءِ الشَّمسِ مِن دقِيقِ الغُبارِ.","مَنثُورًا":"مُفَرَّقاً."},"24":{"مَقِيلٗا":"مَكَاناً للرَّاحَةِ وقتَ القَيْلُولَةِ."},"25":{"تَشَقَّقُ ٱلسَّمَآءُ":"تَتَفَتَّحُ السَّمَواتُ.","بِٱلۡغَمَٰمِ":"بالسَّحَابِ الأبيضِ الرَّقِيقِ."},"26":{"عَسِيرٗا":"صَعْباً شَدِيداً."},"27":{"يَعَضُّ ٱلظَّالِمُ عَلَىٰ يَدَيۡهِ":"أي: تَحَسُّراً."},"28":{"خَلِيلٗا":"صَدِيقاً."},"29":{"ٱلذِّكۡرِ":"أي: القرآنِ والإيمانِ به.","خَذُولٗا":"كثيرَ الخِذْلَانِ لِمَنْ يُوالِيهِ، والخِذْلَانُ: التَّخَلِّي عَنِ النُّصْرَةِ."},"30":{"مَهۡجُورٗا":"مَتْرُوكاً، تُرِكَ الإيمانُ به والعَمَلُ بِمَا فِيه."},"31":{"ٱلۡمُجۡرِمِينَ":"أي: الكَافِرِينَ والمُشْرِكِينَ."},"32":{"لَوۡلَا":"هَلَّا.","جُمۡلَةٗ وَٰحِدَةٗ":"أي: دُفْعةً وَاحِدَةً.","لِنُثَبِّتَ بِهِۦ فُؤَادَكَ":"لنُقَوِّيَ به قَلْبَكَ.","وَرَتَّلۡنَٰهُ تَرۡتِيلٗا":"أي: أَنْزَلْناه وفرَّقْناه آيةً بعْدَ آيةٍ."},"33":{"بِمَثَلٍ":"بِحُجَّةٍ أو شُبْهَةٍ."},"35":{"وَزِيرٗا":"مُعِيناً لِتَبْلِيغِ الرِّسالةِ."},"36":{"فَدَمَّرۡنَٰهُمۡ":"فَأَهْلَكْناهُم."},"37":{"ءَايَةٗ":"عِبْرةً.","وَأَعۡتَدۡنَا":"هَيَّأنا."},"38":{"وَأَصۡحَٰبَ ٱلرَّسِّ":"أصْحابَ البِئْرِ.","وَقُرُونَۢا":"وأُمَماً."},"39":{"ضَرَبۡنَا لَهُ ٱلۡأَمۡثَٰلَ":"بَيَّنّا لجَمِيعِ الأُمَمِ الحُجَجَ، وأَزَلْنا عَنْهم الشُّبُهَاتِ.","تَبَّرۡنَا":"أهْلَكْنا."},"40":{"ٱلۡقَرۡيَةِ":"هي «سَدُومُ» قَرْيَةُ قَومِ لُوطٍ.","مَطَرَ ٱلسَّوۡءِ":"أي: بالحِجارةِ مِنَ السَّماءِ.","لَا يَرۡجُونَ نُشُورٗا":"لا يتَوَقَّعُونَ بَعْثاً بَعْدَ الموتِ."},"41":{"هُزُوًا":"مُسْتَهْزَأً بِه."},"42":{"إِن كَادَ":"إنَّه قارَبَ."},"43":{"وَكِيلًا":"حَفِيظاً يَحْفَظُه مِنِ اتِّباعِ هَوَاهُ."},"44":{"كَٱلۡأَنۡعَٰمِ":"كَالْبَهائِمِ لا يَفْهَمُونَ."},"45":{"مَدَّ ٱلظِّلَّ":"بَسَطَه مِن طُلُوعِ الفَجْرِ إلى طُلُوعِ الشَّمسِ.","سَاكِنٗا":"ثَابِتاً، لَا تُزِيلُهُ الشَّمْسُ.","دَلِيلٗا":"أي: يُسْتَدَلُّ بأحْوالِ الشَّمسِ على أَحْوالِ الظِّلِّ."},"46":{"قَبۡضٗا يَسِيرٗا":"أي: يَتَقَلَّصُ الظِّلُّ تَدْرِيجيّاً بِقَدْرِ ارْتِفاعِ الشَّمسِ."},"47":{"لِبَاسٗا":"ساتِراً بِظَلَامِهِ.","سُبَاتٗا":"رَاحَةً لَكُم.","نُشُورٗا":"تَنْتَشِرُونَ فِيهِ لِمَعَاشِكُم."},"49":{"أَنۡعَٰمٗا":"بَهَائِمَ.","وَأَنَاسِيَّ":"أُناساً."},"50":{"صَرَّفۡنَٰهُ بَيۡنَهُمۡ":"أنْزَلْنا المَطَرَ على أَنْحاءٍ مُخْتَلِفَةٍ.","كُفُورٗا":"جُحُوداً بالنِّعمَةِ."},"52":{"وَجَٰهِدۡهُم بِهِۦ":"وَجَاهِدِ الْكُفَّارَ بالقُرآنِ والبُرْهانِ."},"53":{"مَرَجَ":"خَلَطَ وأرْسَلَ.","عَذۡبٞ فُرَاتٞ":"حُلْوٌ شَدِيدُ الحَلَاوَةِ.","أُجَاجٞ":"شَدِيدُ المُلُوحَةِ.","بَيۡنَهُمَا بَرۡزَخٗا":"حاجِزاً بين البَحْرَينِ يَمْنَعُ اخْتِلاطَ أَحَدِهِمَا بالآخَر."},"54":{"ٱلۡمَآءِ":"هو مَنِيُّ الرَّجلِ والمرْأةِ.","وَصِهۡرٗا":"القَرابَةَ النَّاشِئَةَ مِنَ الزَّوَاجِ بَيْنَ الزَّوْجِ وأهْلِ زَوْجتِهِ."},"55":{"عَلَىٰ رَبِّهِۦ ظَهِيرٗا":"مُعِيناً للشَّيطانِ على رَبِّهِ."},"59":{"ثُمَّ ٱسۡتَوَىٰ":"أي: عَلَا وارْتَفَعَ كَمَا يَلِيقُ بِجَلَالِهِ.","ٱلۡعَرۡشِ":"هو سريرُ المُلْكِ الَّذِي اسْتَوى عليه الرَّحْمَنُ وَتَحْمِلُهُ الملائِكةُ، وهو أَعْظَمُ المخْلُوقاتِ، وهو سَقْفُ الجنَّةِ."},"60":{"نُفُورٗا":"تَبَاعُداً عَنِ الإِيمانِ."},"61":{"تَبَارَكَ":"تَكَاثَرَ خَيْرُه، وعَظُمَتْ بَرَكَاتُهُ.","بُرُوجٗا":"مَنَازِلَ للكَواكِبِ والنُّجُومِ.","سِرَٰجٗا":"شَمْساً تُضِيءُ."},"62":{"خِلۡفَةٗ":"يَخْلُفُ أحدُهما الآخَرَ؛ فَيَتَعاقَبَانِ.","أَن يَذَّكَّرَ":"أن يَعْتَبرَ."},"63":{"هَوۡنٗا":"أي: بسَكِينَةٍ وتَوَاضُعٍ.","قَالُواْ سَلَٰمٗا":"أي: قالُوا قَوْلاً سَدِيداً يَسْلَمُونَ بهِ مِنَ الأذَى."},"64":{"يَبِيتُونَ":"يَقْضُونَ لَيالِيَهُم."},"65":{"ٱصۡرِفۡ":"ادْفَعْ.","غَرَامًا":"لِزَاماً، يُلَازِمُ صَاحِبَهُ."},"67":{"لَمۡ يُسۡرِفُواْ":"لم يَتَجَاوَزُوا حَدَّ الاعْتِدالِ.","وَلَمۡ يَقۡتُرُواْ":"ولم يُضَيِّقوا في الإنْفَاقِ.","قَوَامٗا":"وَسَطاً بَيْنَ التَّبذِيرِ والتَّضْيِيقِ."},"68":{"لَا يَدۡعُونَ":"لا يَعْبُدُونَ.","أَثَامٗا":"عِقاباً."},"69":{"وَيَخۡلُدۡ فِيهِۦ":"وَيَبْقَى فيه على الدَّوَامِ.","مُهَانًا":"ذلِيلاً حَقِيراً."},"71":{"مَتَابٗا":"توبةً."},"72":{"ٱلزُّورَ":"شَهَادَةً كَاذِبَةً.","بِٱللَّغۡوِ":"بِكُلِّ ساقِطٍ مِن قَوْلٍ أو فِعْلٍ.","مَرُّواْ كِرَامٗا":"مُكْرِمِينَ أَنْفُسَهُم بالإِعْرَاضِ عَنْهُ."},"73":{"لَمۡ يَخِرُّواْ":"لم يَسْقُطُوا وَلَمْ يَقَعُوا.","صُمّٗا وَعُمۡيَانٗا":"أي: لا يَسْمَعُونَ ولا يُبْصِرُونَ، والمعنى: إنَّما يَخِرُّونَ عَلَيها سامِعِينَ مُبْصِرِينَ مُنْتَفِعِينَ."},"74":{"قُرَّةَ أَعۡيُنٖ":"مَوْضِعَ سُرُورٍ وفَرَحٍ."},"75":{"ٱلۡغُرۡفَةَ":"المرادُ منها أعلى مَنَازِلِ الجنَّةِ وأَفْضَلُها."},"77":{"مَا يَعۡبَؤُاْ بِكُمۡ":"لا يُبَالي بكُم.","لِزَامَۢا":"أي: عَذَاباً دَائماً مُلَازِماً لَكُم."}}