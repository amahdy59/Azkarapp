{"1":{"فَاطِرِ":"مُبْدِعٍ عَلى غَيرِ مِثالٍ سَبَقَ.","أُوْلِيٓ أَجۡنِحَةٖ":"أَصْحابَ أجْنِحَةٍ."},"2":{"مَا يَفۡتَحِ":"أي: ما يُرسِلْ ويُعْطِ.","رَحۡمَةٖ":"نِعْمَةٍ.","مُمۡسِكَ":"مانِعَ.","مُرۡسِلَ":"مُعْطِيَ."},"3":{"فَأَنَّىٰ تُؤۡفَكُونَ":"فَكَيفَ تُصْرَفُونَ عَن تَوحِيدِهِ؟."},"5":{"وَعۡدَ ٱللَّهِ":"أي: بالبعْثِ والثَّوَابِ والعِقابِ.","حَقّٞ":"ثابِتٌ وكائِنٌ لا محالةَ.","فَلَا تَغُرَّنَّكُمُ":"فَلَا تَخْدَعَنَّكُم.","ٱلۡغَرُورُ":"الشَّيطانُ."},"6":{"حِزۡبَهُۥ":"أي: أَتْبَاعَهُ.","ٱلسَّعِيرِ":"النَّارِ الموقَدَةِ."},"7":{"أَجۡرٞ كَبِيرٌ":"وهو الجنَّةُ."},"8":{"زُيِّنَ لَهُۥ":"أي: حَسَّنَ له الشَّيطانُ.","سُوٓءُ عَمَلِهِۦ":"عَمَلُه السَّيِّئُ والقبيحُ.","فَلَا تَذۡهَبۡ نَفۡسُكَ عَلَيۡهِمۡ حَسَرَٰتٍ":"فلا تُهْلِكْ نفسَك حُزْناً على كُفْرِهِم."},"9":{"فَتُثِيرُ":"فَتُحَرِّكُ.","مَيِّتٖ":"جَدْب.","بَعۡدَ مَوۡتِهَا":"بَعْدَ يُبْسِها وَجَفافِها.","ٱلنُّشُورُ":"بَعْثُ الموتى مِن قُبُورِهِم للجزاءِ."},"10":{"يَصۡعَدُ":"يَرْتَقِي.","ٱلۡكَلِمُ ٱلطَّيِّبُ":"الكلامُ الطَّيِّبُ مِن ذِكْرٍ ودُعاءٍ وتِلَاوَةٍ.","يَرۡفَعُهُۥ":"أي: يَرفَعُه اللهُ إلَيهِ ويَقْبَلُه.","يَمۡكُرُونَ ٱلسَّيِّـَٔاتِ":"أي: يَمْكُرُونَ المكَراتِ السَّيِّئاتِ، وهي مَذْكُورةٌ في قوله تعالى:","يَبُورُ":"يَفسُدُ وَيَبْطُلُ."},"11":{"مِن نُّطۡفَةٖ":"هي مَنِيُّ الرجلِ يَقْذِفُه في رَحِمِ امْرَأَتِه.","أَزۡوَٰجٗا":"ذُكُوراً وإناثاً تَزَوَّجَ بعضُهم بَعْضاً.","لَا تَضَعُ":"لاتَلِدُ.","مُعَمَّرٖ":"طَوِيلِ العُمُرِ."},"12":{"فُرَاتٞ":"حُلْوٌ شَدِيدُ الحَلَاوَةِ.","سَآئِغٞ شَرَابُهُۥ":"سَهْلٌ مُرُورُهُ في الْحَلْقِ.","أُجَاجٞ":"شَدِيدُ المُلوحَةِ.","لَحۡمٗا طَرِيّٗا":"هو السَّمَكُ.","حِلۡيَةٗ":"هي اللُّؤلُؤُ والمَرْجانُ.","ٱلۡفُلۡكَ":"السُّفُنَ.","مَوَاخِرَ":"جوارِيَ تَشُقُّ الماءَ شَقّاً.","لِتَبۡتَغُواْ":"لِتَطْلُبُوا."},"13":{"يُولِجُ":"يُدخِلُ.","لِأَجَلٖ مُّسَمّٗى":"لِوقْتٍ مَعْلُومٍ.","قِطۡمِيرٍ":"القِشْرَةِ الرَّقيقَةِ على نَوَاةِ التَّمْرَةِ."},"14":{"وَلَا يُنَبِّئُكَ":"وَلَا يُخْبِرُكَ."},"15":{"ٱلۡفُقَرَآءُ":"المحْتاجُونَ."},"17":{"بِعَزِيزٖ":"بمُمْتَنِعٍ."},"18":{"وَلَا تَزِرُ":"لَا تَحْمِلُ.","وَازِرَةٞ":"أي: نفسٌ مُذْنِبَةٌ.","مُثۡقَلَةٌ":"أي: نَفْسٌ أَثْقَلَتْها الذُّنوبُ.","حِمۡلِهَا":"ذُنُوبِها التي أَثْقَلَتْها.","يَخۡشَوۡنَ":"يخافُونَ.","تَزَكَّىٰ":"تَطَهَّرَ مِنَ الشِّرْكِ والمعاصِي.","ٱلۡمَصِيرُ":"المرْجِعُ."},"19":{"ٱلۡأَعۡمَىٰ":"مَن فَقَدَ بَصَرَه، والمُرادُ بِه هُنا الكافِرُ؛ لأنَّهُ عَمِيَ عَن دِينِ الحقِّ."},"21":{"ٱلۡحَرُورُ":"الرِّيحُ الحارَّةُ."},"23":{"نَذِيرٌ":"رَسُولٌ مُنْذِرٌ مِنْ عَذَابِ اللهِ."},"24":{"بَشِيرٗا وَنَذِيرٗا":"بَشِيراً لِأَهْلِ الطَّاعةِ ونَذِيراً لِأَهْلِ المعْصِيةِ.","نَذِيرٞ":"نَبِيٌّ مُنْذِرٌ مِنْ عَذَابِ اللهِ."},"25":{"بِٱلۡبَيِّنَٰتِ":"بالمعْجِزاتِ الواضِحةِ.","وَبِٱلزُّبُرِ":"بالكُتُبِ التي فيها مَوَاعِظُ.","وَبِٱلۡكِتَٰبِ ٱلۡمُنِيرِ":"الكُتُبِ الَّتي أنارَتْ طَرِيقَ الشَّرْعِ والهِدَايَةِ، ومِنْها القرآنُ الكريمُ."},"27":{"جُدَدُۢ":"جَمْعُ جُدَّةٍ، وهي الطَّرِيقَةُ والخِطَّةُ في الشَّيءِ تكونُ واضِحةً فِيهِ.","وَغَرَابِيبُ":"جمع غِرْبِيبٍ، وهو شَديدُ السَّوادِ يُشْبِهُ لَونُه لَونَ الغُرابِ."},"29":{"لَن تَبُورَ":"لَن تَكْسُدَ، ولَن تَهْلِكَ."},"32":{"ٱلَّذِينَ ٱصۡطَفَيۡنَا":"الَّذِينَ اخْتَرْناهُم.","ظَالِمٞ لِّنَفۡسِهِۦ":"أي: بِأن وَقَعَ في بَعْضِ المعاصِي.","مُقۡتَصِدٞ":"أي: بِأَدَاءِ الواجِباتِ واجْتِنابِ المُحَرَّماتِ.","سَابِقُۢ بِٱلۡخَيۡرَٰتِ":"أي: مُسارعٌ مُجْتَهِدٌ في الأعْمالِ الصَّالحةِ فَرْضِها ونَفْلِها."},"33":{"يُحَلَّوۡنَ":"يُزيَّنُونَ بالحِلْيةِ.","أَسَاوِرَ":"مُفْرَدُه سِوارٌ: وهو ما يُلْبَسُ في اليدِ مِنَ الحُلِيِّ ويُحِيطُ بالمِعْصَمِ.","حَرِيرٞ":"ثِيابٌ رَقِيقَةٌ."},"34":{"ٱلۡحَزَنَ":"أي: كُلَّ ما يُحْزِنُ ويَغُمُّ."},"35":{"أَحَلَّنَا":"أنزَلَنا.","دَارَ ٱلۡمُقَامَةِ":"دَارَ الإقامةِ الدَّائمةِ، وهي الجنَّةُ.","نَصَبٞ":"تَعَبٌ ومَشَقَّةٌ.","لُغُوبٞ":"إعياءٌ مِنَ التَّعَبِ وفُتُورٌ."},"36":{"لَا يُقۡضَىٰ عَلَيۡهِمۡ":"أي: بالموتِ.","كَفُورٖ":"مُتَمادٍ في الكُفْرِ مُصِرٍّ عليه."},"37":{"يَصۡطَرِخُونَ":"يَصْرُخُونَ بِشِدَّةٍ مُسْتَغِيثِينَ.","مَا يَتَذَكَّرُ فِيهِ مَن تَذَكَّرَ":"أي: مِثْلُه كافٍ للاتِّعاظِ لِمَنْ أَرَادَ أن يَتَّعِظَ.","ٱلنَّذِيرُ":"وهو الرَّسولُ ﷺ."},"39":{"خَلَٰٓئِفَ":"يَخْلُفُ بَعْضُكُم بَعْضاً.","مَقۡتٗا":"بُغْضاً وغَضَباً.","خَسَارٗا":"هَلَاكاً وخُسْرَاناً."},"40":{"أَرَءَيۡتُمۡ شُرَكَآءَكُمُ":"أَخْبِرُونِي عَن شُركائِكُم.","ءَاتَيۡنَٰهُمۡ":"أَعْطَيناهُم.","غُرُورًا":"خِدَاعاً."},"42":{"جَهۡدَ أَيۡمَٰنِهِمۡ":"مُجْتَهِدِينَ فِيها بالحَلِفِ بأغْلَظِها.","نُفُورًا":"بُعْداً عَنِ الحقِّ وفِرَاراً مِنْه."},"43":{"لَا يَحِيقُ":"لا يُحِيطُ ولا يَنْزِلُ.","ٱلۡمَكۡرُ ٱلسَّيِّئُ":"أي: وبالُ مَكْرِهِم السَّيِّئِ.","سُنَّتَ ٱلۡأَوَّلِينَ":"طَرِيقَةَ اللهِ فِيهِم وعادَتَهُ بِتَعْذِيبِهِم لِتكْذِيبِهِم."},"44":{"لِيُعۡجِزَهُۥ":"لِيَفُوتَه."},"45":{"يُؤَاخِذُ":"يُعاقِبُ.","يُؤَخِّرُهُمۡ":"يُمْهِلُهُم."}}