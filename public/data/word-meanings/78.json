{"1":{"عَمَّ":"عَنْ أيِّ شَيءٍ.","يَتَسَآءَلُونَ":"يَسْأَلُ بعضُ كُفَّارِ قُريشٍ بَعْضاً."},"2":{"ٱلنَّبَإِ ٱلۡعَظِيمِ":"الخبرِ العَظِيمِ الشَّأنِ، وهو القُرآنُ العَظِيمُ الَّذي يُنْبِئُ عَنِ البَعْثِ."},"4":{"كَلَّا":"ليسَ الأمْرُ كَما يَزْعُمُ هَؤلاءِ المشْرِكُونَ.","سَيَعۡلَمُونَ":"أي: عاقبةَ تَكْذِيبِهِم."},"6":{"مِهَٰدٗا":"مُمَهَّدَةً لَكُم كالفِراشِ."},"7":{"أَوۡتَادٗا":"رَواسِيَ."},"8":{"أَزۡوَٰجٗا":"أَصْنافاً ذَكَراً وَأُنْثَى."},"9":{"سُبَاتٗا":"راحةً لأبدانِكُم."},"10":{"لِبَاسٗا":"تَلْبَسُكُم ظُلْمَتُهُ، كَما يَسْتُرُ الثَّوبُ لَابِسَهُ."},"11":{"مَعَاشٗا":"تَنتَشِرُونَ فِيه لِمصَالِحِكُم."},"12":{"سَبۡعٗا":"سَبْعَ سَمَواتٍ.","شِدَادٗا":"مَتِينَةَ البِناءِ، مُحْكَمةَ الخَلْقِ والإنْشَاءِ."},"13":{"سِرَاجٗا":"شَمْساً.","وَهَّاجٗا":"وقَّاداً مُضِيئاً."},"14":{"ٱلۡمُعۡصِرَٰتِ":"السُّحُبِ المُمْطِرَةِ.","ثَجَّاجٗا":"منصَبّاً بِكَثْرَةٍ."},"16":{"أَلۡفَافًا":"مُلْتَفَّةً بعْضُها بِبَعْضٍ."},"17":{"يَوۡمَ ٱلۡفَصۡلِ":"أي: القضاءِ بينَ الخلْقِ، وهوَ يومُ القِيامَةِ.","مِيقَٰتٗا":"وَقْتاً ومِيعاداً مُحَدَّداً للأوَّلِينَ والآخِرِينَ."},"18":{"يُنفَخُ فِي ٱلصُّورِ":"يَنفُخُ المَلَكُ في «القَرْنِ» إيذانًا بالبَعْثِ.","أَفۡوَاجٗا":"أُمَماً، كلُّ أُمَّةٍ مع إمامِهِم."},"19":{"وَفُتِحَتِ":"شُقِّقَتْ وصُدِّعتْ.","أَبۡوَٰبٗا":"ذاتَ أبوابٍ كَثِيرةٍ."},"20":{"وَسُيِّرَتِ ٱلۡجِبَالُ":"وَنُسِفَتِ الجِبالُ.","سَرَابًا":"يَظُنُّ مَن يَراهُ مِن بُعْدٍ ماءً، وهو في الحقِيقَةِ هَبَاءٌ."},"21":{"مِرۡصَادٗا":"تَرْقُبُ مَنْ يجتازُها."},"22":{"لِلطَّٰغِينَ":"للكافِرِينَ الَّذِينَ طَغَوا.","مَـَٔابٗا":"مَرْجِعاً."},"23":{"لَٰبِثِينَ":"ماكِثِينَ.","أَحۡقَابٗا":"دُهُوراً مُتَعاقِبةً لا تَنْقَطِعُ."},"24":{"لَا يَذُوقُونَ":"لا يُحِسُّونَ.","بَرۡدٗا":"نَسِيماً بارداً.","شَرَابًا":"ماءً يُرْوي."},"25":{"حَمِيمٗا":"ماءً حارّاً.","وَغَسَّاقٗا":"وَصَدِيدَ أَهْلِ النَّارِ."},"26":{"وِفَاقًا":"مُوافِقاً لأَعْمالِهِم."},"27":{"لَا يَرۡجُونَ حِسَابٗا":"لا يَتَوَقَّعُونَ وُقُوعَ الجَزَاءِ يَومَ القِيامَةِ."},"28":{"بِـَٔايَٰتِنَا":"بِما جاءَتْهُم بِهِ الرُّسُلُ."},"29":{"كِتَٰبٗا":"كَتَبْناهُ في اللَّوحِ المَحْفُوظِ."},"31":{"مَفَازًا":"فَوْزاً بِدُخُولِهِم الجنَّةَ."},"33":{"وَكَوَاعِبَ":"نَوَاهِدَ، أَثْدَاؤُهنَّ مُرْتَفِعَةٌ لم تَتَدَلَّ.","أَتۡرَابٗا":"مُسْتَوِياتٍ في سِنٍّ واحِدةٍ."},"34":{"دِهَاقٗا":"مَمْلُوءةً خَمْراً."},"35":{"لَا يَسۡمَعُونَ فِيهَا لَغۡوٗا":"باطِلاً مِنَ القول.","وَلَا كِذَّٰبٗا":"ولا تَكْذِيباً."},"36":{"حِسَابٗا":"كَثِيراً كافياً لَهُم."},"37":{"لَا يَمۡلِكُونَ مِنۡهُ خِطَابٗا":"لا يَسْتَطِيعُونَ خِطاباً يُبَلِّغُونَهُ إلى اللهِ."},"38":{"ٱلرُّوحُ":"جِبْريِلُ.","صَفّٗا":"مُصْطَفِّينَ.","صَوَابٗا":"حَقّاً وسَدَاداً."},"39":{"ٱلۡيَوۡمُ ٱلۡحَقُّ":"الثابِتُ الَّذِي لا رَيْبَ في وُقُوعِهِ.","مَـَٔابٗا":"مَرْجِعاً."},"40":{"أَنذَرۡنَٰكُمۡ":"حَذَّرْناكُم.","مَا قَدَّمَتۡ يَدَاهُ":"ما عَمِلَ من خِيرٍ أو شَرٍّ.","يَٰلَيۡتَنِي كُنتُ تُرَٰبَۢا":"فلم أُبْعَثْ."}}