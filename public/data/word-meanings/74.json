{"1":{"ٱلۡمُدَّثِّرُ":"المتَغَطِّي بِثِيابِهِ."},"2":{"قُمۡ":"أي: مِن مَضْجَعِكَ.","فَأَنذِرۡ":"فَحَذِّر النَّاس مِنْ عَذابِ اللهِ."},"3":{"وَرَبَّكَ فَكَبِّرۡ":"وخُصَّ رَبَّكَ وَحْدَهُ بالتَّعْظِيمِ والعِبادَةِ."},"4":{"وَثِيَابَكَ فَطَهِّرۡ":"أي: مِنَ النَّجاساتِ."},"5":{"وَٱلرُّجۡزَ فَٱهۡجُرۡ":"ودُمْ على هَجْر أَعْمالِ الشِّرْكِ كُلِّها."},"6":{"وَلَا تَمۡنُن تَسۡتَكۡثِرُ":"وَلَا تُعْطِ العَطِيَّةَ كَي تَلْتَمِسَ أَكْثَرَ مِنْها."},"7":{"وَلِرَبِّكَ فَٱصۡبِرۡ":"وَلِمَرْضاةِ رَبِّكَ فاصْبِرْ عَلَى الأَوامِرِ والنَّواهِي."},"8":{"نُقِرَ":"نُفِخَ نَفْخَةَ البعثِ والنُّشُورِ.","ٱلنَّاقُورِ":"القَرْنِ الَّذِي يُنْفَخُ فِيهِ."},"11":{"ذَرۡنِي وَمَنۡ خَلَقۡتُ وَحِيدٗا":"دَعْنِي -أيُّها الرَّسُولُ- أَنا والَّذِي خَلَقْتُه في بَطْنِ أُمِّهِ وَحِيداً لا مالَ لَهُ ولا وَلدَ."},"12":{"مَمۡدُودٗا":"مبسُوطاً واسِعاً."},"13":{"شُهُودٗا":"حاضِرِينَ مَعَهُ في «مكَّةَ» لَا يغِيبُونَ عَنْهُ."},"14":{"وَمَهَّدتُّ لَهُۥ":"وَيَسَّرتُ لَهُ سُبُلَ العيشِ."},"15":{"أَنۡ أَزِيدَ":"أي: في مالِهِ وَوَلَدِهِ."},"16":{"كَلَّآ":"ليس الأمرُ كما يَزْعُمُ.","لِأٓيَٰتِنَا":"للقرآنِ.","عَنِيدٗا":"معانِداً مُكَذِّباً."},"17":{"سَأُرۡهِقُهُۥ":"سَأُكَلِّفُه.","صَعُودًا":"مَشَقَّةً مِنَ العذَابِ."},"18":{"فَكَّرَ":"في نَفْسِهِ.","وَقَدَّرَ":"وَهَيَّأ ما يقُولُه مِنَ الطَّعنِ في مُحَمَّدٍ ﷺ والقرآنِ."},"19":{"فَقُتِلَ":"فَلُعِنَ، واسْتَحَقَّ بِذَلِكَ الهَلاكَ.","كَيۡفَ قَدَّرَ":"كَيفَ أَعَدَّ في نفسهِ هَذا الطَّعْنَ."},"21":{"نَظَرَ":"تَأَمَّلَ فيما قَدَّرَ وَهَيَّأَ مِنَ الطَّعْنِ في القرآنِ."},"22":{"عَبَسَ":"قَطَّبَ وَجْهَهُ.","وَبَسَرَ":"واشْتَدَّ في العُبُوسِ."},"23":{"أَدۡبَرَ":"رَجَعَ مُعْرِضاً عَنِ الحقِّ.","وَٱسۡتَكۡبَرَ":"وَتَعَاظَمَ أَن يَعْتَرِفَ بِهِ."},"24":{"إِنۡ هَٰذَآ":"ما الَّذِي يَقُولُه مُحَمَّدٌ.","يُؤۡثَرُ":"يُنْقلُ عَنِ الأوّلِينَ."},"25":{"قَوۡلُ ٱلۡبَشَرِ":"كلامُ المخلُوقِينَ، تَعَلَّمَهُ مُحَمَّدٌ مِنْهُم، ثُمَّ ادَّعى أَنَّهُ مِنْ عندِ اللهِ."},"26":{"سَأُصۡلِيهِ":"سَأُدْخِلُهُ.","سَقَرَ":"جَهَنَّمَ."},"27":{"وَمَآ أَدۡرَىٰكَ":"وما أَعلَمَكَ.","مَا سَقَرُ":"أيُّ شَيءٍ جَهَنَّمُ؟"},"28":{"لَا تُبۡقِي":"لا تَتْرُكُ مِنْ أجْزَاءِ المُعَذَّبِينَ شَيئاً.","وَلَا تَذَرُ":"وَلَا تَتْرُكُ مَنْ فيها مَيِّتاً، وَلَكِنَّها تُحْرِقُهُم كُلَّما جُدِّدَ خَلْقُهُم."},"29":{"لَوَّاحَةٞ":"حَرَّاقَةٌ، مُغيِّرةٌ، مُسَوِّدةٌ.","لِلۡبَشَرِ":"للجُلودِ، مُفْردُها: بَشَرةٌ."},"30":{"عَلَيۡهَا":"يَلِي أَمْرَ جَهَنَّمَ وَيَتَسَلَّطُ على أَهْلِها بالعَذابِ.","تِسۡعَةَ عَشَرَ":"مَلَكاً مِنَ الزَّبانِيَةِ الأَشِدَّاءِ."},"31":{"أَصۡحَٰبَ ٱلنَّارِ":"خَزَنَةَ النَّارِ.","عِدَّتَهُمۡ":"ذِكْرَ عَدَدِهِم.","فِتۡنَةٗ":"اخْتِباراً.","لِيَسۡتَيۡقِنَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ":"ليَحْصُلَ اليقِينُ لِليهُودِ والنَّصَارى.","وَلَا يَرۡتَابَ":"وَلَا يَشُكَّ.","مَرَضٞ":"نِفاقٌ.","مَاذَآ أَرَادَ ٱللَّهُ بِهَٰذَا مَثَلٗا":"ما الَّذِي أَرَادَهُ اللهُ بِهذا العَدَدِ؟","كَذَٰلِكَ":"بِمِثْلِ ذَلِكَ الَّذِي ذُكِرَ.","جُنُودَ رَبِّكَ":"عَدَدَهُم.","هِيَ":"النَّارُ.","ذِكۡرَىٰ":"تَذْكِرَةٌ وَمَوْعِظَةٌ."},"32":{"كَلَّا":"ليسَ الأمرُ كَما ذَكَرُوا."},"33":{"إِذۡ أَدۡبَرَ":"حِينَ وَلَّى وَذَهَبَ."},"34":{"أَسۡفَرَ":"أَضَاءَ."},"35":{"إِنَّهَا":"إِنَّ النَّارَ.","ٱلۡكُبَرِ":"العَظائِمِ."},"36":{"نَذِيرٗا":"إِنْذاراً وَتَخْوِيفاً."},"37":{"يَتَقَدَّمَ":"يَتَقَرَّبَ إلى رَبِّهِ بِفِعْلِ الطَّاعاتِ.","أَوۡ يَتَأَخَّرَ":"بِفِعْلِ المعاصِي."},"38":{"بِمَا كَسَبَتۡ":"مِنْ أَعْمالِ الخيرِ والشَّرِ.","رَهِينَةٌ":"مَحْبُوسَةٌ مَرْهُونَةٌ بِكَسْبِها."},"39":{"إِلَّآ أَصۡحَٰبَ ٱلۡيَمِينِ":"وهم المسْلِمُونَ المخلِصُونَ."},"40":{"يَتَسَآءَلُونَ":"يَسْأَلُ بَعْضُهُم بَعْضاً."},"41":{"عَنِ ٱلۡمُجۡرِمِينَ":"عَنِ الكافِرِينَ الَّذينَ أَجْرمُوا في حَقِّ أَنْفُسِهِم."},"42":{"مَا سَلَكَكُمۡ":"ما الَّذِي أَدْخَلَكُم.","سَقَرَ":"جَهَنَّمَ."},"45":{"نَخُوضُ":"نَتَحَدَّثُ بالباطِلِ.","مَعَ ٱلۡخَآئِضِينَ":"مَعَ أَهْلِ الضَّلالةِ."},"46":{"بِيَوۡمِ ٱلدِّينِ":"بِيومِ الحِسابِ والجزَاءِ."},"47":{"ٱلۡيَقِينُ":"الموتُ."},"48":{"شَفَٰعَةُ":"طَلَبُ قَضَاءِ حاجَةِ المشْفُوعِ لَهُ عِنْدَ المَشْفُوعِ عنْدَهُ.","ٱلشَّٰفِعِينَ":"الملائِكَةِ والنَّبِيِّينَ وَغَيرِهِم."},"49":{"فَمَا لَهُمۡ":"فما لِهؤُلَاءِ المشْرِكِينَ.","عَنِ ٱلتَّذۡكِرَةِ":"عَنِ القُرآنِ وما فِيهِ مِنَ الموَاعِظِ.","مُعۡرِضِينَ":"مُنْصَرِفِينَ."},"50":{"حُمُرٞ":"حُمُرٌ وَحْشِيَّةٌ.","مُسۡتَنفِرَةٞ":"شَدِيدَةُ النِّفارِ."},"51":{"قَسۡوَرَةِۭ":"أَسَدٍ كَاسِرٍ."},"52":{"صُحُفٗا":"كُتُباً.","مُنَشَّرَةٗ":"مَفْتُوحَةً مَقْرُوءَةً."},"53":{"كَلَّا":"ليسَ الأمرُ كَما زَعَمُوا.","لَا يَخَافُونَ ٱلۡأٓخِرَةَ":"لا يُصَدِّقُونَ بالبَعْثِ والجزَاءِ."},"54":{"كَلَّآ":"حَقّاً.","إِنَّهُۥ":"إِنَّ القُرآنَ.","تَذۡكِرَةٞ":"مَوْعِظَةٌ بَلِيغَةٌ كافِيَةٌ لِاتِّعاظِهِم."},"55":{"ذَكَرَهُۥ":"اتَّعظَ بِما فِيهِ وانْتَفَعَ بِهُدَاهُ."},"56":{"وَمَا يَذۡكُرُونَ":"وَما يَتَّعِظُونَ بِه.","هُوَ أَهۡلُ ٱلتَّقۡوَىٰ":"المُسْتَحِقُّ لِأَن يُتَّقَى وَيُطاعَ.","وَأَهۡلُ ٱلۡمَغۡفِرَةِ":"والجديرُ بأن يَغْفِرَ لِمَنْ آمنَ بِهِ وَأطاعَهُ."}}