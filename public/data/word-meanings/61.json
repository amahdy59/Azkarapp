{"2":{"مَا لَا تَفۡعَلُونَ":"ما لا تَقُومُونَ بالوفاءِ بهِ."},"3":{"مَقۡتًا":"بُغْضاً."},"4":{"صَفّٗا":"أي مَصْفُوفِينَ.","مَرۡصُوصٞ":"مُتَراصٌّ مُحْكَمٌ."},"5":{"زَاغُوٓاْ":"مالُوا عَنِ الحقِّ مع عِلْمِهِم به.","أَزَاغَ ٱللَّهُ قُلُوبَهُمۡ":"صَرَفَها عَن قَبُولِ الهِدايَةِ.","ٱلۡفَٰسِقِينَ":"الخارِجِينَ عَن طاعة الله ورسوله."},"6":{"لِمَا بَيۡنَ يَدَيَّ":"لِمَا جَاءَ قَبْلي.","وَمُبَشِّرَۢا":"ومُخْبِراً بِمَجِيءِ الرَّسُولِ ﷺ.","بِٱلۡبَيِّنَٰتِ":"بالدَّلائِلِ الواضِحاتِ الدَّالّةِ عَلى نُبُوَّتِهِ."},"7":{"وَمَنۡ أَظۡلَمُ":"لا أَحَدَ أَظْلَمُ.","ٱفۡتَرَىٰ":"اختَلَقَ."},"8":{"لِيُطۡفِـُٔواْ نُورَ ٱللَّهِ":"لِيَقْضُوا عَلَى دِينِ اللهِ.","مُتِمُّ نُورِهِۦ":"سيُتِمُّ هَذا الإسلامَ حَتَّى يَنْتَشِرَ."},"9":{"بِٱلۡهُدَىٰ":"بالقُرآنِ.","وَدِينِ ٱلۡحَقِّ":"ودِينِ الإسْلامِ.","لِيُظۡهِرَهُۥ":"ليُعْلِيَهُ."},"12":{"مِن تَحۡتِهَا":"مِن تَحْتِ قُصُورِها وأَشْجارِها.","عَدۡنٖ":"إقامَةٍ دائِمَةٍ."},"13":{"وَأُخۡرَىٰ":"وَنِعْمَةٌ أُخْرَى.","قَرِيبٞ":"عاجِلٌ."},"14":{"لِلۡحَوَارِيِّـۧنَ":"هُمْ أَصْفِياءُ عِيسَى -عَلَيهِ السَّلامُ- وخُلَّصُ أصحابِهِ.","ظَٰهِرِينَ":"غالِبِينَ: إما بالحُجَّةِ، أو بِبِعْثَةِ مُحَمَّدٍ ﷺ."}}