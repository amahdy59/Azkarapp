{"1":{"طسٓمٓ":"سَبَقَ الكلامُ على الحُرُوفِ المُقَطَّعةِ في أوَّلِ سُورةِ البَقَرةِ."},"3":{"نَبَإِ مُوسَىٰ":"خَبَرِ مُوسَى.","بِٱلۡحَقِّ":"بالصِّدْقِ."},"4":{"عَلَا":"تَجَبَّرَ وتكَبَّرَ.","شِيَعٗا":"طَوائِفَ مُتَفَرِّقةً.","وَيَسۡتَحۡيِۦ نِسَآءَهُمۡ":"أي: يَسْتَبْقِيهِنَّ للخِدْمَةِ والامْتِهانِ."},"5":{"أَن نَّمُنَّ":"أن نَتَفَضَّلَ.","أَئِمَّةٗ":"قادَةً في الخيرِ.","ٱلۡوَٰرِثِينَ":"أي: وَرِثُوا أرضَ مِصْرَ بَعْدَ هَلَاكِ فِرْعَونَ وقَومِهِ."},"6":{"وَنُمَكِّنَ لَهُمۡ":"ونُثَبِّتَ لهم.","يَحۡذَرُونَ":"يَخافُونَ."},"7":{"وَأَوۡحَيۡنَآ":"وألْهَمْنا.","فِي ٱلۡيَمِّ":"في نَهْرِ النِّيلِ."},"8":{"فَٱلۡتَقَطَهُۥٓ":"فأخَذَهُ.","لِيَكُونَ":"أي: في المآلِ والعاقِبَةِ."},"9":{"قُرَّتُ عَيۡنٖ":"مَصْدرُ سُرورٍ وسَعادةٍ تَقَرُّ العَينُ بِهِ."},"10":{"فُؤَادُ":"قَلْبُ.","فَٰرِغًا":"خالِياً مِن كلِّ شَيءٍ؛ ليمْلَأَه هَمُّ مُوسَى وذِكْرُه.","لَتُبۡدِي بِهِۦ":"لَتُظْهِرُ أَنَّ مُوسَى ابْنُهَا.","أَن رَّبَطۡنَا":"أن ثبَّتناها بالصَّبرِ والثَّباتِ."},"11":{"قُصِّيهِ":"اتَّبعِي أثَرَ مُوسَى، وتَعَرَّفي خَبَرَه.","عَن جُنُبٖ":"عن بُعدٍ."},"12":{"وَحَرَّمۡنَا عَلَيۡهِ":"أي: مَنَعْنَاهُ مِن قَبُولِ الرَّضاعَةِ.","يَكۡفُلُونَهُۥ":"يقُومُونَ بإرْضاعِه وتَرْبِيَتِهِ.","نَٰصِحُونَ":"مُشْفِقُونَ."},"13":{"كَيۡ تَقَرَّ عَيۡنُهَا":"كَي تُسَرَّ أمُّ مُوسَى بِسَلَامَةِ وَلَدِها ورُجُوعِهِ إِليها."},"14":{"أَشُدَّهُۥ":"أي: مُنْتَهى قُوَّتِه.","وَٱسۡتَوَىٰٓ":"أي: تكَامَلَ عَقْلُه.","ءَاتَيۡنَٰهُ حُكۡمٗا وَعِلۡمٗا":"أعْطَيناه حِكْمَةً وفَهْماً، ومَعْرِفَةً بالدِّينِ."},"15":{"عَلَىٰ حِينِ غَفۡلَةٖ":"وَقْتِ غَفْلَةِ أَهْلِها.","فَٱسۡتَغَٰثَهُ":"فَطَلَبَ الغَوثَ والنَّصْرَ مِن مُوسَى عَلَيهِ الصَّلاةُ والسَّلامُ.","مِن شِيعَتِهِۦ":"أي: مِن بَنِي إسْرَائِيلَ، قَومِ مُوسَى عَلَيهِ الصَّلاةُ والسَّلامُ.","ٱلَّذِي مِنۡ عَدُوِّهِۦ":"أي: القِبْطِيِّ الَّذي كان مِن قَومِ فِرْعَونَ.","فَوَكَزَهُۥ":"ضَرَبَه مُوسَى بجُمْعِ كَفِّه.","فَقَضَىٰ عَلَيۡهِ":"قَتَلَه."},"17":{"ظَهِيرٗا":"مُعِيناً."},"18":{"يَتَرَقَّبُ":"يَتَوَقَّعُ المكْرُوهَ، ويُرَاقِبُ ما يَحْدُثُ.","يَسۡتَصۡرِخُهُۥ":"يَطْلُبُ مِنْهُ النَّصْرَ.","لَغَوِيّٞ":"لَشَدِيدُ الضَّلالِ وسُوءِ النَّظرِ."},"19":{"أَن يَبۡطِشَ":"أن يَأْخُذَ بقوَّةٍ وعُنْفٍ."},"20":{"أَقۡصَا ٱلۡمَدِينَةِ":"آخِرِ المدينةِ.","ٱلۡمَلَأَ":"أَشْرَافَ القَومِ وَسَادَتَهُم.","يَأۡتَمِرُونَ":"يَتَشَاورُونَ في شَأْنِكَ.","ٱلنَّٰصِحِينَ":"المُشْفِقِينَ."},"22":{"تِلۡقَآءَ مَدۡيَنَ":"جِهَةَ مَدْيَنَ.","سَوَآءَ ٱلسَّبِيلِ":"أي: الطَّرِيقَ المُسْتَويَ إلى مَدْيَنَ."},"23":{"وَرَدَ":"بَلَغَ.","أُمَّةٗ":"جَمَاعةً.","تَذُودَانِ":"تَحبِسَانِ غَنَمَهُما عَنِ الماءِ.","مَا خَطۡبُكُمَا":"ما شَأْنُكمَا؟","يُصۡدِرَ ٱلرِّعَآءُ":"يَنْصَرِفَ الرُّعاةُ بِمَواشِيهِم عَنِ الماءِ."},"24":{"تَوَلَّىٰٓ إِلَى ٱلظِّلِّ":"رَجَعَ إليه."},"27":{"تَأۡجُرَنِي":"تَكُونَ لي أَجِيراً في رَعْيِ الغَنَمِ.","حِجَجٖ":"سِنِينَ."},"28":{"أَيَّمَا ٱلۡأَجَلَيۡنِ":"أيَّ المُدَّتَينِ.","قَضَيۡتُ":"وَفَّيتُ به وأتْمَمْتُه.","فَلَا عُدۡوَٰنَ عَلَيَّ":"لا اعْتِدَاءَ ولا ظُلْمَ عليَّ بالمطالَبَةِ بأكْثَرَ مِنْه.","وَكِيلٞ":"شاهِدٌ وحَفِيظٌ."},"29":{"ٱلۡأَجَلَ":"المُدَّةَ المُتَّفَقَ عَلَيها وهي عَشْرُ سِنِينَ.","ءَانَسَ":"أبصَرَ ما يُؤْنِسُ.","جَذۡوَةٖ":"جَمْرَةٍ وشُعْلَةٍ.","تَصۡطَلُونَ":"تَسْتَدْفِئُونَ بِها."},"30":{"شَٰطِيِٕ":"جانِبِ.","ٱلۡبُقۡعَةِ":"القِطْعَةِ مِنَ الأرْضِ."},"31":{"تَهۡتَزُّ":"تتحرَّكُ بخِفَّةٍ.","جَآنّٞ":"حَيَّةٌ خَفِيفَةٌ في سُرْعَةِ حرَكَتِها.","وَلَّىٰ":"هَرَبَ.","وَلَمۡ يُعَقِّبۡ":"لم يَرْجِعْ.","أَقۡبِلۡ":"تَقَدَّمْ."},"32":{"ٱسۡلُكۡ":"أَدْخِلْ.","فِي جَيۡبِكَ":"في فَتْحَةِ قَمِيصِكَ الَّتِي يُدْخَلُ مِنْها الرَّأسُ.","مِنۡ غَيۡرِ سُوٓءٖ":"مِنْ غَيرِ مَرَضٍ ولا بَرَصٍ.","جَنَاحَكَ":"يَدَكَ.","مِنَ ٱلرَّهۡبِ":"لِتَأْمَنَ مِنَ الخَوْفِ.","وَمَلَإِيْهِۦٓ":"أشْرَافِ قومهِ."},"34":{"رِدۡءٗا":"مُعِيناً."},"35":{"سَنَشُدُّ عَضُدَكَ":"سَنُقَوِّيكَ وَنُعِيْنُكَ.","سُلۡطَٰنٗا":"حُجَّةً أو مَهَابَةً في قُلُوبِ الأعْدَاءِ."},"37":{"عَٰقِبَةُ ٱلدَّارِ":"العاقِبةُ المحْمُودَةُ في الدَّارِ الآخِرَةِ."},"38":{"ٱلۡمَلَأُ":"الأشْرَافُ مِن قَومِه.","فَأَوۡقِدۡ":"فَأَشْعِلْ.","صَرۡحٗا":"قَصْراً.","أَطَّلِعُ":"أَنظُرُ."},"40":{"فَنَبَذۡنَٰهُمۡ فِي ٱلۡيَمِّ":"فَطَرَحْنَاهُمْ في البَحْرِ، فَأَغْرَقْنَاهُم."},"42":{"مِنَ ٱلۡمَقۡبُوحِينَ":"مِنَ المذْمُومِينَ والمُبْعَدِينَ مِن كُلِّ خَيْرٍ."},"43":{"ٱلۡقُرُونَ ٱلۡأُولَىٰ":"الأُمَمَ الماضِيَةَ."},"44":{"قَضَيۡنَآ إِلَىٰ مُوسَى":"عَهِدْنا إليهِ وكَلَّفْناهُ.","ٱلۡأَمۡرَ":"أي: أَمْرَ الرِّسَالَةِ.","مِنَ ٱلشَّٰهِدِينَ":"مِنَ الحاضِرِينَ في ذلك الوقتِ."},"45":{"أَنشَأۡنَا":"خَلَقْنا.","قُرُونٗا":"أُمَماً.","فَتَطَاوَلَ عَلَيۡهِمُ ٱلۡعُمُرُ":"امْتَدَّ عَلَيهِمُ الزَّمانُ.","ثَاوِيٗا":"مُقِيماً."},"46":{"ٱلطُّورِ":"جَبَلِ طُورِ سَيناءَ."},"47":{"بِمَا قَدَّمَتۡ أَيۡدِيهِمۡ":"أي: بِسَبَبِ أَعْمالِهِم السَّيِّئَةِ."},"48":{"أُوتِيَ":"أُعْطِيَ.","سِحۡرَانِ":"أي: التَّوراةُ والقرآنُ حَسَبَ زَعْمِهِم، أو هُما ذَوَا سِحْرٍ، أي: مُوسَى ومُحَمَّدٌ -عليهما الصَّلاةُ والسَّلامُ- حَسَبَ زَعْمِهِم."},"51":{"وَصَّلۡنَا لَهُمُ ٱلۡقَوۡلَ":"أي: نَزَّلْنا عَلَيهِم القرآنَ يَتْبَعُ بَعْضُهُ بَعْضاً."},"53":{"مُسۡلِمِينَ":"أي: مُخْلِصِينَ للهِ بالتوحيدِ."},"54":{"وَيَدۡرَءُونَ":"يَدْفَعُونَ."},"55":{"ٱللَّغۡوَ":"السَّاقِطَ مِنَ القَوْلِ.","لَا نَبۡتَغِي":"لا نُرِيدُ ولا نُحِبُّ."},"56":{"لَا تَهۡدِي":"أي: هِدايةَ توفِيقٍ."},"57":{"نُتَخَطَّفۡ":"نُخْتلَسْ ونُسْتَلَبْ قَتْلاً وأسْراً.","أَوَ لَمۡ نُمَكِّن لَّهُمۡ حَرَمًا ءَامِنٗا":"أولم نَجْعَلْهُم يَنْعَمُونَ بالأمْنِ والتَّمكِينِ في البلدِ الحرامِ.","يُجۡبَىٰٓ إِلَيۡهِ":"يُجْلَبُ إليه."},"58":{"وَكَمۡ":"كَثِيراً.","بَطِرَتۡ مَعِيشَتَهَا":"طَغَتْ وكَفَرتْ نِعْمَةَ العَيشِ الرَّغَدِ.","ٱلۡوَٰرِثِينَ":"أي: للعِباد بَعْدَ إهْلَاكِهم."},"59":{"فِيٓ أُمِّهَا":"وهي مَكَّة المكَرَّمةُ، وتُعْرَفُ بأمِّ القُرَى."},"60":{"وَمَآ أُوتِيتُم":"وما أُعْطِيتُم."},"61":{"وَعۡدًا حَسَنٗا":"أي: بِدُخُولِ الجنَّةِ.","مِنَ ٱلۡمُحۡضَرِينَ":"أي: مِمَّن أُحْضِرُوا لِلْحِسابِ والعَذَابِ."},"63":{"حَقَّ عَلَيۡهِمُ ٱلۡقَوۡلُ":"وَجَبَ لهم العَذابُ.","أَغۡوَيۡنَآ":"أَضْلَلْنا.","تَبَرَّأۡنَآ إِلَيۡكَ":"أي: مِنْ عِبادتِهم إيَّانا."},"66":{"فَعَمِيَتۡ عَلَيۡهِمُ ٱلۡأَنۢبَآءُ":"فَخَفِيَتْ عَلَيهِمُ الأَخْبارُ الَّتي كانُوا يَحْتَجُّونَ بِها."},"68":{"ٱلۡخِيَرَةُ":"الاخْتِيارُ."},"69":{"مَا تُكِنُّ":"ما تُخْفِي."},"70":{"ٱلۡأُولَىٰ":"الحَيَاةِ الأُولَى هي الدُّنيا.","وَٱلۡأٓخِرَةِ":"الدَّارِ الآخرةِ."},"71":{"أَرَءَيۡتُمۡ":"أي: أَخْبِرُونِي.","سَرۡمَدًا":"دَائِماً مُسْتَمِرّاً.","بِضِيَآءٍ":"بنُورٍ."},"72":{"تَسۡكُنُونَ فِيهِ":"تَسْتَقِرُّونَ فِيه مِنَ التَّعَبِ."},"73":{"لِتَسۡكُنُواْ فِيهِ":"لِتَسْتَقِرُّوا في اللَّيلِ، وتَرْتَاحَ أَبْدَانُكُم.","لِتَبۡتَغُواْ مِن فَضۡلِهِۦ":"لِتطْلُبُوا وتَلْتَمِسُوا مِنْ رِزْقِهِ."},"75":{"وَنَزَعۡنَا":"وأَخْرَجْنا.","شَهِيدٗا":"وهو نَبِيُّ كُلِّ أُمَّةٍ.","هَاتُواْ بُرۡهَٰنَكُمۡ":"أَحْضِرُوا حُجَّتَكُم.","يَفۡتَرُونَ":"يَخْتَلِقُونَ."},"76":{"فَبَغَىٰ عَلَيۡهِمۡ":"تَكَبَّرَ عَلَيهِم.","وَءَاتَيۡنَٰهُ":"وأعْطَيناهُ.","ٱلۡكُنُوزِ":"الأمْوَالِ المدَّخَرَةِ في الخَزَائِنِ.","لَتَنُوٓأُ بِٱلۡعُصۡبَةِ":"لَتُثْقِلُ الجَمَاعَةَ الكَثِيرَةَ.","أُوْلِي ٱلۡقُوَّةِ":"أَصْحابِ القُوَّةِ.","لَا تَفۡرَحۡ":"لا تَبْطَرْ فَرَحاً بِكَثْرَةِ المالِ."},"77":{"وَٱبۡتَغِ":"وَالْتَمِسْ.","ءَاتَىٰكَ":"أَعْطَاكَ.","وَلَا تَنسَ نَصِيبَكَ":"ولا تَترُكْ حَظَّكَ مِنَ الدُّنيا.","وَلَا تَبۡغِ":"وَلَا تَلْتمِسْ."},"78":{"أُوتِيتُهُۥ":"أُعْطِيتُ هَذا المالَ.","مِنَ ٱلۡقُرُونِ":"مِنَ الأُمَمِ."},"79":{"أُوتِيَ":"أُعطِيَ.","لَذُو حَظٍّ":"لَصَاحِبُ نَصِيبٍ."},"80":{"أُوتُواْ":"أُعطُوا.","وَيۡلَكُمۡ":"زَجْرٌ لهم عَنْ هَذا التَّمَنِّي.","وَلَا يُلَقَّىٰهَآ":"أي: لا يُعطَى تِلْكَ الخَصْلَةَ أوِ الجنَّةَ."},"81":{"فَخَسَفۡنَا بِهِۦ":"أي: فَجَعَلْنا الأرضَ تَبْتَلِعُهُ وهو حَيٌّ.","فِئَةٖ":"جَماعَةٍ."},"82":{"وَيۡكَأَنَّ":"كَلِمَةُ تَندُّمٍ وتَفَجُّعٍ، أي: أَلمْ تَعْلَمْ.","يَبۡسُطُ":"يُوسِّعُ.","وَيَقۡدِرُ":"يُضَيِّقُ.","مَنَّ":"أَنْعَمَ.","وَيۡكَأَنَّهُۥ":"أَلَمْ تَعْلَمْ."},"83":{"عُلُوّٗا":"تَكَبُّراً.","وَٱلۡعَٰقِبَةُ":"أي: العاقِبةُ المحْمُودَةُ، وهي الجنَّةُ."},"85":{"فَرَضَ":"أي: أَنْزَلَ وأَوْجَبَ عَلَيكَ العَمَلَ بِمُقْتَضَاه.","لَرَآدُّكَ":"لَمُرْجِعُكَ.","إِلَىٰ مَعَادٖ":"المرادُ بِهِ هُنا «مَكَّةُ».","ضَلَٰلٖ مُّبِينٖ":"انحِرافٍ واضِحٍ."},"86":{"تَرۡجُوٓاْ":"تَتَوَقَّعُ وتَنْتَظِرُ.","أَن يُلۡقَىٰٓ":"أي: أن يُنزَّلَ.","ظَهِيرٗا":"مُعِيناً."},"87":{"وَلَا يَصُدُّنَّكَ":"ولا يَصْرِفُنَّكَ."},"88":{"إِلَّا وَجۡهَهُۥ":"إلّا إيَّاهُ، أو إلّا ما أُرِيدَ به وَجْهُه.","لَهُ ٱلۡحُكۡمُ":"القَضَاءُ النَّافِذُ ، يَقْضِي بما شَاءَ."}}