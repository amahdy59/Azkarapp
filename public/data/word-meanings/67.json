{"1":{"تَبَٰرَكَ ٱلَّذِي":"تَكَاثَرَ خَيرُ اللهِ وبِرُّهُ عَلَى جَمِيعِ خَلْقِهِ.","بِيَدِهِ ٱلۡمُلۡكُ":"التَّصَرُّفُ في مُلْكِ الدُّنيا والآخِرَةِ."},"2":{"لِيَبۡلُوَكُمۡ":"لِيَخْتَبِرَكُم."},"3":{"طِبَاقٗا":"مُتَناسِقَةً.","تَفَٰوُتٖ":"اخْتِلافٍ وَتَبايُنٍ.","فَٱرۡجِعِ ٱلۡبَصَرَ":"فَأَعِدِ النَّظَرَ.","فُطُورٖ":"شُقُوقٍ أو صُدُوعٍ."},"4":{"كَرَّتَيۡنِ":"مَرَّةً بَعْدَ مَرَّةٍ.","يَنقَلِبۡ":"يَرْجِعْ.","خَاسِئٗا":"ذَلِيلاً صاغِراً.","حَسِيرٞ":"مُتْعَبٌ كَلِيلٌ."},"5":{"ٱلدُّنۡيَا":"القَرِيبةَ.","بِمَصَٰبِيحَ":"بِنُجُومٍ عَظِيمَةٍ مُضِيئةٍ.","رُجُومٗا":"شُهُباً مُحْرِقَةً.","لِلشَّيَٰطِينِ":"لِمُسْتَرِقِي السَّمْعِ مِنَ الشَّياطِينِ.","ٱلسَّعِيرِ":"النَّارِ المُوقَدَةِ."},"6":{"وَبِئۡسَ ٱلۡمَصِيرُ":"وَسَاءَ المَرْجِعُ لهم جَهَنَّمُ."},"7":{"أُلۡقُواْ":"طُرِحُوا.","شَهِيقٗا":"صَوْتاً شَدِيداً مُنْكَراً.","تَفُورُ":"تَغْلِي غَلَيَاناً شَدِيداً."},"8":{"تَمَيَّزُ":"تَتَمَزَّقُ.","مِنَ ٱلۡغَيۡظِ":"مِن شِدَّةِ غَضَبِها عَلَى الكُفَّارِ.","أُلۡقِيَ":"طُرِحَ.","فَوۡجٞ":"جَماعةٌ مِنَ النَّاسِ.","خَزَنَتُهَا":"الملائِكةُ المُوكَّلُونَ بأَمْرِها.","نَذِيرٞ":"رَسُولٌ يُحَذِّرُكُم مِنْ هَذا العَذابِ."},"10":{"نَسۡمَعُ":"سَمَاعَ مَن يَطْلُبُ الحقَّ.","نَعۡقِلُ":"نُفَكِّرُ فِيما نُدْعَى إِلَيهِ.","ٱلسَّعِيرِ":"النَّارِ المُوقَدَةِ."},"11":{"فَسُحۡقٗا":"فَبُعْداً عَن رَحْمَةِ اللهِ."},"12":{"بِٱلۡغَيۡبِ":"وَهُمْ غائِبُونَ عَنْ أعْيُنِ النَّاسِ، وَقَبْلَ مُعايَنَةِ العَذابِ.","وَأَجۡرٞ":"ثَوَابٌ."},"13":{"وَأَسِرُّواْ":"وأَخْفُوا.","أَوِ ٱجۡهَرُواْ بِهِۦٓ":"أَعْلِنُوهُ.","بِذَاتِ ٱلصُّدُورِ":"بِما يَتَرَدَّدُ في النَّفْسِ مِنَ الخواطِرِ والنِّياتِ."},"14":{"يَعۡلَمُ":"اللهُ.","مَنۡ خَلَقَ":"المخلُوقِينَ.","ٱللَّطِيفُ":"العالِمُ خَبايا الأُمُورِ والمُدَبِّرُ لَها بِرِفْقٍ وَحِكْمَةٍ.","ٱلۡخَبِيرُ":"العَلِيمُ بِباطِنِ أَمرِهِم."},"15":{"ذَلُولٗا":"سَهْلةً مُمَهَّدَةً تَسْتَقِرُّونَ عَلَيها.","مَنَاكِبِهَا":"نواحِيها وَجَوَانِبِها.","ٱلنُّشُورُ":"البَعْثُ مِن قُبُورِكُم لِلْحِسابِ."},"16":{"ءَأَمِنتُم":"هَلْ أَمِنْتُم؟","مَن فِي ٱلسَّمَآءِ":"الَّذِي فَوقَ السَّماءِ.","يَخۡسِفَ بِكُمُ ٱلۡأَرۡضَ":"يَقْلِبَ ظاهِرَ الأرضِ باطِناً، وباطِنَها ظاهِراً مُصاحِبةً لِذَواتِكم.","تَمُورُ":"تَضْطَرِبُ بِكُم حَتَّى تَهْلِكُوا."},"17":{"حَاصِبٗا":"رِيحاً تَرْجُمُكُم بالحِجارةِ الصَّغِيرةِ.","نَذِيرِ":"تَحْذِيرِي لَكُم."},"18":{"نَكِيرِ":"إِنْكارِي عَلَيهِم بإنْزَالِ العَذابِ بِهِم."},"19":{"صَٰٓفَّٰتٖ":"باسِطاتٍ أَجْنِحَتَها عِنْدَ طَيَرَانِها في الهواءِ.","وَيَقۡبِضۡنَ":"ويَضْمُمْنَ أَجْنِحَتَها."},"20":{"أَمَّنۡ هَٰذَا":"بَلْ مَنْ هَذا.","جُندٞ لَّكُمۡ":"حِزْبٌ لَكُم.","مِن دُونِ ٱلرَّحۡمَٰنِ":"مِن غَيْرِ الرَّحمنِ.","إِن":"ما.","غُرُورٍ":"خِدَاعٍ وضَلَالٍ مِنَ الشَّيطانِ."},"21":{"لَجُّواْ":"اسْتَمَرُّوا في طُغْيانِهِم وَكُفْرِهِم.","عُتُوّٖ":"مُعانَدَةٍ واسْتِكْبارٍ","وَنُفُورٍ":"فِرارٍ مِنَ الحقِّ."},"22":{"مُكِبًّا":"ساقِطاً عَلَى وَجْهِهِ.","أَهۡدَىٰٓ":"أَشَدُّ اسْتِقامةً عَلى الطَّرِيقةِ.","سَوِيًّا":"مُسْتَوِياً."},"23":{"أَنشَأَكُمۡ":"أَوْجَدَكُم مِن العَدَمِ.","وَٱلۡأَفۡـِٔدَةَ":"القُلُوبَ."},"24":{"ذَرَأَكُمۡ":"خَلَقَكُم وَنَشَرَكُم.","تُحۡشَرُونَ":"تُجْمَعُونَ لِلْحِسابِ والجَزَاءِ."},"26":{"نَذِيرٞ":"مُخَوِّفٌ.","مُبِينٞ":"أُبَيِّنُ لَكُمُ الشَّرَائِعَ."},"27":{"زُلۡفَةٗ":"قَرِيباً مِنْهُم.","سِيٓـَٔتۡ وُجُوهُ ٱلَّذِينَ كَفَرُواْ":"ظَهَرَتْ عَلَيها الذِّلَّةُ والكآبةُ.","بِهِۦ تَدَّعُونَ":"تَطْلُبُونَ تَعْجِيلَه في الدُّنيا."},"28":{"أَرَءَيۡتُمۡ":"أَخْبِرُوني.","أَهۡلَكَنِيَ":"أماتَنِي.","يُجِيرُ":"يَحْمِي وَيَمْنَعُ."},"29":{"ءَامَنَّا بِهِۦ":"صَدَّقْنا بِهِ وَعَمِلْنا بِشَرْعِهِ.","تَوَكَّلۡنَا":"اعْتَمَدْنا في كُلِّ أُمُورِنا.","ضَلَٰلٖ":"بُعْدٍ عَن صِراطِ اللهِ المُسْتَقِيمِ."},"30":{"أَرَءَيۡتُمۡ":"أَخْبِرُونِي.","أَصۡبَحَ":"صارَ.","غَوۡرٗا":"ذاهِباً في الأرضِ لا تصِلُونَ إِلَيهِ.","مَعِينِۭ":"جارٍ على وَجْهِ الأَرْضِ تَرَاهُ العُيُونُ."}}