{"1":{"كُوِّرَتۡ":"لُفَّتْ، وَذَهَبَ ضَوْءُها."},"2":{"ٱنكَدَرَتۡ":"تَنَاثَرَتْ، فَذَهَبَ نُورُها."},"3":{"سُيِّرَتۡ":"سُيِّرَتْ عن وَجْهِ الأرْضِ فَصَارَتْ هَباءً."},"4":{"ٱلۡعِشَارُ":"النُوقُ الحوامِلُ.","عُطِّلَتۡ":"تُرِكَتْ وَأُهْمِلَتْ."},"5":{"ٱلۡوُحُوشُ":"الحيواناتُ الوَحْشِيَّةُ.","حُشِرَتۡ":"جُمِعَتْ واخْتَلَطَتْ، لِيَقْتَصَّ اللهُ مِن بَعْضِها لِبَعْضٍ."},"6":{"سُجِّرَتۡ":"أُوقِدَتْ."},"7":{"زُوِّجَتۡ":"قُرِنَتْ بأَمثالِها."},"8":{"ٱلۡمَوۡءُۥدَةُ":"الطِّفْلةُ المدفُونةُ حَيَّةً.","سُئِلَتۡ":"سُؤالَ تَطْيِيبٍ لها وَلَومٍ لِوائِدِها."},"10":{"ٱلصُّحُفُ":"صُحُفُ الأَعْمالِ.","نُشِرَتۡ":"عُرِضَتْ."},"11":{"كُشِطَتۡ":"أُزِيلَتْ مِن مَكانِها."},"12":{"سُعِّرَتۡ":"أُوقِدَتْ."},"13":{"أُزۡلِفَتۡ":"قُرِّبَتْ مِنْ أهْلِها."},"14":{"أَحۡضَرَتۡ":"قَدَّمَتْ من خَيرٍ أو شَرٍّ."},"15":{"بِٱلۡخُنَّسِ":"بِالنُّجُومِ المُخْتَفِيَةِ أَنْوَارُها نهاراً."},"16":{"ٱلۡجَوَارِ":"الجارِيةِ.","ٱلۡكُنَّسِ":"المسْتَتِرَةِ في أَبْراجِها."},"17":{"عَسۡعَسَ":"أَقْبَلَ بِظَلامِهِ."},"18":{"تَنَفَّسَ":"ظَهَرَ ضِياؤُه."},"19":{"إِنَّهُۥ":"إِنَّ القُرآنَ.","رَسُولٖ كَرِيمٖ":"هو جِبْرِيلُ، عَلَيه السَّلامُ."},"20":{"ذِي ٱلۡعَرۡشِ":"صَاحِبِ العَرْشِ، وَهُوَ اللهُ.","مَكِينٖ":"صاحبِ مَكانَةٍ رَفِيعَةٍ."},"21":{"ثَمَّ":"هُنَاكَ.","أَمِينٖ":"مُؤْتَمَنٍ على الوَحْيِ الَّذِي يَنْزِلُ بِه."},"22":{"صَاحِبُكُم":"مُحَمَّدٌ ﷺ الَّذِي تَعْرِفُونَهُ."},"23":{"وَلَقَدۡ رَءَاهُ":"وَلَقَدْ رَأَى مُحَمَّدٌ ﷺ جِبْرِيلَ.","بِٱلۡأُفُقِ ٱلۡمُبِينِ":"بالأُفُقِ العَظِيمِ."},"24":{"عَلَى ٱلۡغَيۡبِ":"بِتَبْلِيغ الوَحْيِ.","بِضَنِينٖ":"ببَخِيلٍ."},"25":{"رَجِيمٖ":"مَطْرُودٍ مِن رَحْمَةِ اللهِ."},"26":{"فَأَيۡنَ تَذۡهَبُونَ":"فَأَينَ تَذْهَبُ بِكُم عُقُولُكُم في التَّكْذِيبِ بالقُرآنِ بَعْدَ هذِه الحُجَجِ القاطِعَةِ؟ "},"27":{"ذِكۡرٞ":"مَوعِظَةٌ."},"28":{"يَسۡتَقِيمَ":"على الحقِّ والإيمانِ."}}