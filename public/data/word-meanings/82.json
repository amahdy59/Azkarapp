{"1":{"ٱنفَطَرَتۡ":"انْشَقَّتْ، واخْتَلَّ نِظامُها."},"2":{"ٱنتَثَرَتۡ":"تَساقَطَتْ."},"3":{"فُجِّرَتۡ":"فَجَّرَ اللهُ بَعْضَها في بَعْضٍ، فَمَلأَ جَمِيعَها."},"4":{"بُعۡثِرَتۡ":"قُلِبتْ بِبَعْثِ مَن كانَ فِيها."},"5":{"نَفۡسٞ":"كلُّ نَفْسٍ.","مَا قَدَّمَتۡ وَأَخَّرَتۡ":"ما تَقَدَّمَ مِنْ أَعْمالِها وَمَا تَأَخَّرَ."},"6":{"ٱلۡإِنسَٰنُ":"المنْكِرُ لِلْبَعْثِ.","مَا غَرَّكَ بِرَبِّكَ":"ما الَّذِي خَدَعَكَ حتَّى كَفَرْتَ بِرَبِّكَ؟","ٱلۡكَرِيمِ":"الجَوَادِ الكَثِيرِ الخيرِ."},"7":{"فَسَوَّىٰكَ":"فَجَعَلَكَ قَوِيماً سَلِيماً.","فَعَدَلَكَ":"فَجَعَلَكَ مُسْتَقِيمَ القامَةِ مُتَناسِبَ الأجْزَاءِ."},"8":{"مَا شَآءَ رَكَّبَكَ":"رَكَّبكَ التَّرْكِيبَ الَّذِي شاءَهُ."},"9":{"كَلَّا":"لَيسَ الأمرُ كَما تَقُولُونَ.","بِٱلدِّينِ":"بِيومِ الِحسابِ."},"10":{"لَحَٰفِظِينَ":"لمَلائِكَةً رُقَبَاءَ."},"11":{"كِرَامٗا":"على اللهِ.","كَٰتِبِينَ":"لِمَا وُكِّلُوا بإحْصائِهِ."},"13":{"ٱلۡأَبۡرَارَ":"القائِمينَ بِحُقُوقِ اللهِ وَحُقُوقِ عِبادِهِ.","نَعِيمٖ":"التَّنَعُّمِ الدَّائِم في الجنَّةِ."},"14":{"ٱلۡفُجَّارَ":"الَّذِينَ قَصَّرُوا في حُقُوقِ اللهِ وحُقُوقِ عِبادِهِ."},"15":{"يَصۡلَوۡنَهَا":"يُصِيبُهُم لَهَبُهَا.","يَوۡمَ ٱلدِّينِ":"يوم الجزاءِ."},"16":{"عَنۡهَا":"عذابِ جَهَنَّمَ.","بِغَآئِبِينَ":"لا بِخُرُوج وَلَا بِمَوتٍ."},"17":{"وَمَآ أَدۡرَىٰكَ":"وَما أَعْلَمَكَ؟","مَا يَوۡمُ ٱلدِّينِ":"ما عَظَمَةُ يَومِ الحِسابِ."},"19":{"لَا تَمۡلِكُ نَفۡسٞ لِّنَفۡسٖ شَيۡـٔٗا":"لَا يَقْدِرُ أَحدٌ على نَفْعِ أَحَدٍ."}}