{"1":{"حمٓ":"سَبَقَ الكَلامُ على الحُرُوفِ المُقَطَّعةِ في أوَّلِ سُورَةِ البَقَرةِ."},"2":{"وَٱلۡكِتَٰبِ":"القُرآنِ.","ٱلۡمُبِينِ":"الواضِحِ لَفْظاً وَمَعْنىً."},"4":{"أُمِّ ٱلۡكِتَٰبِ":"اللَّوحِ المحْفُوظِ.","لَعَلِيٌّ":"رَفِيعٌ.","حَكِيمٌ":"مُحْكَمٌ لا اخْتِلافَ فِيهِ، ولا تَنَاقُضَ."},"5":{"أَفَنَضۡرِبُ عَنكُمُ ٱلذِّكۡرَ":"أَفَنُعْرِضُ عَنْكُم، ونَتْرُكُ إنْزَالَ القُرآنِ إِلَيكُم.","صَفۡحًا":"أي: إعْراضاً.","مُسۡرِفِينَ":"مُتَجاوِزِينَ الحدَّ في الإِعْراضِ عَنِ القُرآنِ."},"6":{"وَكَمۡ":"كَثِيراً.","ٱلۡأَوَّلِينَ":"القُرُونِ الَّتي مَضَتْ."},"8":{"بَطۡشٗا":"قُوَّةً وَبأساً.","مَثَلُ":"عُقُوبةُ."},"10":{"مَهۡدٗا":"فِراشاً وبِساطاً.","سُبُلٗا":"طُرُقاً لِمَعاشِكُم وَمَتاجِرِكُم."},"11":{"مَآءَۢ":"مَطَراً.","بِقَدَرٖ":"بِمِقْدارِ الحاجَةِ.","فَأَنشَرۡنَا":"فَأَحْيَيْنا.","بَلۡدَةٗ":"قِطْعَةً واسِعَةً مِنَ الأرْضِ.","مَيۡتٗا":"مُقْفِراً مِنَ النَّباتِ والزَّرْعِ.","تُخۡرَجُونَ":"تُبْعَثُونَ يومَ القيامةِ."},"12":{"ٱلۡأَزۡوَٰجَ":"الأصْنافَ مِنْ حَيوانٍ ونَباتٍ، ذُكُوراً وإِناثاً.","ٱلۡفُلۡكِ":"السُّفُنِ.","وَٱلۡأَنۡعَٰمِ":"البَهائِمِ؛ كالإبِلِ، والخيلِ، والبِغالِ، والحمِيرِ."},"13":{"سَخَّرَ":"ذَلَّلَ وطَوَّعَ.","مُقۡرِنِينَ":"مُطِيقِينَ."},"14":{"لَمُنقَلِبُونَ":"رَاجِعُونَ."},"15":{"جُزۡءًا":"نَصِيباً."},"16":{"أَمِ":"بَلْ.","ٱتَّخَذَ":"أَتَزْعُمُونَ أَنَّ الله اتَّخَذَ.","وَأَصۡفَىٰكُم":"وَأَخْلَصَكُم."},"17":{"ضَرَبَ":"جَعَلَ.","مَثَلٗا":"شبيهاً، وهي الإِناثُ.","ظَلَّ":"صَارَ.","كَظِيمٌ":"حَزِينٌ مملُوءٌ بالهَمِّ والكَرْبِ."},"18":{"يُنَشَّؤُاْ":"يُرَبَّى.","ٱلۡحِلۡيَةِ":"الزِّينةِ.","ٱلۡخِصَامِ":"الجِدالِ."},"19":{"أَشَهِدُواْ خَلۡقَهُمۡ":"أَحَضَرُوا حِينَ خَلْقِهِم؟"},"20":{"يَخۡرُصُونَ":"يَكْذِبُونَ."},"21":{"مُسۡتَمۡسِكُونَ":"يَعْمَلُونَ به، وَيَدِينُونَ بما فِيهِ."},"22":{"أُمَّةٖ":"طَرِيقةٍ ودِينٍ.","عَلَىٰٓ ءَاثَٰرِهِم":"وَرَاءَهُم.","مُهۡتَدُونَ":"مُتَّبِعُونَ."},"23":{"مُتۡرَفُوهَآ":"الرُّؤَساءُ الَّذِينَ أَطْغَتْهُم النِّعْمَةُ."},"25":{"فَٱنتَقَمۡنَا مِنۡهُمۡ":"عاقَبْناهُم على ذُنُوبِهِم.","عَٰقِبَةُ ٱلۡمُكَذِّبِينَ":"آخِرُ أَمْرِهِمْ."},"26":{"بَرَآءٞ":"بَرِيءٌ."},"27":{"فَطَرَنِي":"خَلَقَنِي.","سَيَهۡدِينِ":"سَيُوَفِّقُنِي لاتِّباعِ سَبِيلِ الرُّشْدِ."},"28":{"وَجَعَلَهَا كَلِمَةَۢ بَاقِيَةٗ":"وَجَعَلَ إِبْراهِيمُ كَلِمةَ التَّوحِيدِ قَوْلاً باقِياً على مَرِّ الزَّمانِ.","عَقِبِهِۦ":"وَلَدِهِ مِن بَعْدِهِ."},"29":{"مَتَّعۡتُ":"أَجْزَلْتُ النِّعمَةَ، وَلَمْ أُعاجِلْ بالعُقُوبَةِ.","ٱلۡحَقُّ":"القُرْآنُ.","مُبِينٞ":"يُبَيِّنُ لَهُم مَا يَحْتاجُونَ إِلَيهِ مِنْ أُمُورِ دِينِهِم."},"31":{"لَوۡلَا":"هَلّا.","ٱلۡقَرۡيَتَيۡنِ":"مَكَّةَ والطَّائِفِ."},"32":{"رَحۡمَتَ رَبِّكَ":"النُّبُوَّةَ.","سُخۡرِيّٗا":"مُذَلَّلاً في شُؤُونِ المعاشِ.","وَرَحۡمَتُ رَبِّكَ":"النُّبُوَّةُ.","مِمَّا يَجۡمَعُونَ":"مِنَ الأمْوَالِ."},"33":{"أُمَّةٗ وَٰحِدَةٗ":"جماعَةً واحِدَةً، كُلُّهُم كُفَّارٌ.","وَمَعَارِجَ":"وَسَلَالِمَ.","يَظۡهَرُونَ":"يَصْعَدُونَ."},"34":{"وَسُرُرًا":"جَمْعُ سَرِيرٍ، وهو ككرْسِيٍّ واسِعٍ يُمْكِنُ الاضْطِجاعُ عَلَيهِ.","يَتَّكِـُٔونَ":"يَجْلِسُونَ عَلَيها مُعْتَمِدِينَ على مَرَافِقِهِم."},"35":{"وَزُخۡرُفٗا":"وَجَعَلْنا لهم ذَهَباً."},"36":{"يَعۡشُ":"يُعرِضْ.","ذِكۡرِ ٱلرَّحۡمَٰنِ":"القرآن.","نُقَيِّضۡ":"نَجْعَلْ.","قَرِينٞ":"مُلَازِمٌ ومُصَاحِبٌ."},"37":{"ٱلسَّبِيلِ":"طَرِيقِ الحقِّ."},"38":{"يَٰلَيۡتَ":"وَدِدْتُّ وتمنَّيتُ.","بُعۡدَ ٱلۡمَشۡرِقَيۡنِ":"بُعْدَ ما بَينَ المشْرِقِ والمغْرِبِ."},"44":{"لَذِكۡرٞ":"لَشَرَفٌ."},"45":{"مَنۡ أَرۡسَلۡنَا":"أَتْباعَ مَنْ أرْسَلْنا، وَهُم مُؤمِنُو أَهْلِ الكِتابِ."},"46":{"بِـَٔايَٰتِنَآ":"بِحُجَجِنا.","وَمَلَإِيْهِۦ":"عُظَماءِ قَومِهِ."},"48":{"مِنۡ أُخۡتِهَا":"مِنَ الَّتِي قَبْلَها."},"49":{"ٱلسَّاحِرُ":"العالِمُ، وَلَمْ يَكُنِ السِّحْرُ صِفَةَ ذَمٍّ عِنْدَ فِرْعَونَ وَمَلَئِهِ."},"50":{"يَنكُثُونَ":"يغْدِرُونَ ويَنْقُضُونَ ما عاهَدُوا عليهِ أَنْفُسَهُم."},"51":{"مِن تَحۡتِيٓ":"مِن تَحْتِ قُصُورِي."},"52":{"أَمۡ":"بَلْ.","مَهِينٞ":"ضَعِيفٌ حَقِيرٌ.","يُبِينُ":"أي: يُبِين الكَلَامَ."},"53":{"فَلَوۡلَآ":"فَهَلَّا.","مُقۡتَرِنِينَ":"مُتَتَابِعِينَ."},"54":{"فَٱسۡتَخَفَّ قَوۡمَهُۥ":"أَثار خِفَّةَ عُقُولِهِمْ بما أبْدَاهُ لَهُم مِنْ شُبَهٍ وحُجَجٍ باطِلَةٍ."},"55":{"ءَاسَفُونَا":"أَغْضَبُونا.","ٱنتَقَمۡنَا مِنۡهُمۡ":"عاقَبْناهُم عَلى ذُنُوبِهم."},"56":{"سَلَفٗا":"قَوْماً تَقَدَّمُوا لِيتَّعِظَ بِهِمُ الآخَرُونَ.","وَمَثَلٗا":"عِبْرةً وَعِظَةً."},"57":{"ضُرِبَ ٱبۡنُ مَرۡيَمَ مَثَلًا":"ضَرَبَ المشركُونَ نَبِيَّ اللهِ عِيسَى -عليه السلام- مَثَلاً لِآلِهَتِهِم وَشَبَّهُوهُ بِها في دُخُولِ النَّارِ.","يَصِدُّونَ":"يَصِيحُونَ فَرَحاً وَسُرُوراً."},"58":{"خَصِمُونَ":"شِدِيدُو التَّمَسُّكِ بالخُصُومَةِ مَعَ ظُهُورِ الحقِّ عِنْدَهُم."},"59":{"مَثَلٗا لِّبَنِيٓ إِسۡرَٰٓءِيلَ":"عِبْرةً لَهُم يَعْرِفُونَ بِهِ قُدْرَةَ اللهِ عَلَى ما يُرِيدُ؛ إِذْ خَلَقَهُ مِنْ غَيرِ أَبٍ."},"60":{"مِنكُم":"أَيْ: بَدَلاً مِنْكُم.","يَخۡلُفُونَ":"يَخْلُفُ بَعْضُهُم بَعْضاً بَدَلاً مِن بنِي آدمَ."},"61":{"وَإِنَّهُۥ":"وإنَّ نُزولَ عِيسَى عَلَيهِ السَّلامُ في آخِرِ الزَّمانِ.","لَعِلۡمٞ":"لَدَلِيلٌ وَعَلاَمةٌ.","فَلَا تَمۡتَرُنَّ":"فَلَا تَشُكُّوا أنَّها واقِعةٌ."},"62":{"مُبِينٞ":"بَيِّنُ العَدَاوَةِ."},"63":{"بِٱلۡبَيِّنَٰتِ":"بالأدِلَّةِ الواضِحاتِ.","بِٱلۡحِكۡمَةِ":"بالنُّبُوَّةِ."},"65":{"ٱلۡأَحۡزَابُ":"الفِرَقُ مِنَ النَّصارَى.","فَوَيۡلٞ":"فَهَلاكٌ وَعَذابٌ أَلِيمٌ."},"66":{"يَنظُرُونَ":"يَنْتَظِرُونَ.","بَغۡتَةٗ":"فَجْأةً."},"67":{"ٱلۡأَخِلَّآءُ":"الأصْدِقاءُ."},"70":{"وَأَزۡوَٰجُكُمۡ":"وَقُرَناؤُكُم المؤمِنُونَ.","تُحۡبَرُونَ":"تُنَعَّمُونَ وتُسَرُّونَ."},"71":{"بِصِحَافٖ":"بآنِيةٍ يُؤْكَلُ فِيها.","وَأَكۡوَابٖ":"آنِيَةٍ للشُّرْبِ.","وَتَلَذُّ":"وَتَجِدُ فِيها ما يَسُرُّها."},"74":{"ٱلۡمُجۡرِمِينَ":"الكَافِرينَ."},"75":{"لَا يُفَتَّرُ":"لا يُخَفَّفُ.","مُبۡلِسُونَ":"آيِسُونَ مِن رَحْمَةِ اللهِ."},"77":{"يَٰمَٰلِكُ":"هو اسْمُ خازِنِ جَهَنَّمَ.","لِيَقۡضِ عَلَيۡنَا رَبُّكَ":"لِيُمِتْنَا ربُّكَ.","مَٰكِثُونَ":"مُقِيمُونَ في العذابِ."},"79":{"أَمۡ":"بَلْ.","أَبۡرَمُوٓاْ":"أَحْكَمُوا.","مُبۡرِمُونَ":"مُحْكِمُونَ أمْراً في مُجازَاتِهم بِالنَّكالِ والعَذَابِ."},"80":{"سِرَّهُمۡ":"ما يُخْفُونَه مِنْ غَيرِهِم.","وَنَجۡوَىٰهُم":"الحدِيثَ الَّذِي يَتَسارُّونَ بِهِ فِيما بَينَهُم.","وَرُسُلُنَا":"الملائِكَةُ الحَفَظَةُ."},"81":{"فَأَنَا۠ أَوَّلُ ٱلۡعَٰبِدِينَ":"أَوَّلُ عابِدِيهِ بِذلكَ الوصف الذي زعمتموه، ولَكِنَّهُ لَا وَلَدَ لَهُ، فأَنا أَعْبُدُهُ بِأنَّه لَا وَلَدَ لَهُ."},"82":{"سُبۡحَٰنَ":"تنْزِيهاً وتَقْدِيساً.","يَصِفُونَ":"يَكْذِبُونَ."},"83":{"يَخُوضُواْ":"يَتَحَدَّثُوا بالباطِل على غيرِ هُدىً."},"84":{"فِي ٱلسَّمَآءِ إِلَٰهٞ وَفِي ٱلۡأَرۡضِ إِلَٰهٞ":"مَعْبُودٌ في السَّماءِ وفي الأَرْضِ."},"85":{"وَتَبَارَكَ":"كَثُرَ خَيْرُهُ.","تُرۡجَعُونَ":"تُرَدُّونَ بَعْدَ مَمَاتِكُم."},"86":{"ٱلشَّفَٰعَةَ":"طَلَبَ قَضاءِ حاجَةِ المشْفُوعِ لَهُ عِنْدَ المشْفُوعِ عِنْدَهُ مِنَ التَّجاوُزِ عَنِ السَّيئاتِ والزَّلَّاتِ وَغَيرِها."},"87":{"فَأَنَّىٰ يُؤۡفَكُونَ":"كَيْفَ يُصْرَفُونَ عَنْ عِبادَةِ الله؟"},"88":{"وَقِيلِهِۦ":"وَعِنْدَ اللهِ عِلْمُ قولِ الرَّسُولِ ﷺ."},"89":{"فَٱصۡفَحۡ":"فَأَعْرِضْ.","سَلَٰمٞ":"سَلَامُ مُتَارَكَةٍ وَمُفارَقَةٍ لِلْجاهِلِينَ."}}