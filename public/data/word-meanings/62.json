{"1":{"يُسَبِّحُ":"يُنَزِّهُ.","ٱلۡمَلِكِ":"المالِكِ لِكُلِّ شَيءٍ، المتَصَرِّفِ فِيهِ بِلا مُنازِعٍ.","ٱلۡقُدُّوسِ":"المنَزَّهِ عَن كُلِّ نَقْصٍ.","ٱلۡعَزِيزِ":"الَّذِي لا يُغَالَبُ.","ٱلۡحَكِيمِ":"المحْكِمِ فِي تَدْبِيرِهِ وصُنْعِهِ."},"2":{"ٱلۡأُمِّيِّـۧنَ":"العربِ الَّذِينَ لا يَقْرَؤُونَ وَلَا يَكْتُبُونَ.","ءَايَٰتِهِۦ":"القُرْآنَ.","وَيُزَكِّيهِمۡ":"ويُطَهِّرهم مِنَ العقائِدِ الفاسِدَةِ، والأخْلاقِ السَّيِّئةِ.","ٱلۡكِتَٰبَ":"القُرْآنَ.","وَٱلۡحِكۡمَةَ":"والسُّنَّةَ."},"3":{"وَءَاخَرِينَ":"وَأَرْسَلَهُ إلى آخَرِينَ.","مِنۡهُمۡ":"مِنَ العَرَبِ ومِنْ غَيْرِهِم.","لَمَّا يَلۡحَقُواْ بِهِمۡ":"لَمْ يَجِيئُوا بَعْدُ، وَسَيَجِيئُونَ."},"4":{"فَضۡلُ ٱللَّهِ":"مِمَّا تَفَضَّلَ اللهُ بِهِ عَلَى هَؤلَاءِ دُونَ غَيرِهِم.","ٱلۡفَضۡلِ ٱلۡعَظِيمِ":"الإحْسانِ، والعَطاءِ الجَزِيلِ."},"5":{"مَثَلُ":"شَبَهُ.","حُمِّلُواْ ٱلتَّوۡرَىٰةَ":"كُلِّفُوا العَمَلَ بِها.","لَمۡ يَحۡمِلُوهَا":"لم يَعْمَلُوا بِها.","أَسۡفَارَۢا":"كُتُباً لا يَدْرِي ما فِيها.","بِئۡسَ":"قَبُحَ.","لَا يَهۡدِي":"لا يُوفِّقُ."},"6":{"هَادُوٓاْ":"تَمَسَّكُوا بالِملَّةِ اليهُودِيَّةِ.","أَوۡلِيَآءُ لِلَّهِ":"أَحِبّاءُ للهِ."},"7":{"بِمَا قَدَّمَتۡ أَيۡدِيهِمۡ":"بِسببِ ما اكْتَسَبُوا في هذه الدُّنيا مِنَ الآثامِ."},"8":{"فَإِنَّهُۥ مُلَٰقِيكُمۡ":"آتٍ إلَيكُم وَقْتَ مَجِيءِ آجالِكُم.","ثُمَّ تُرَدُّونَ":"ثم تُرْجَعُونَ يَومَ القِيامةِ.","ٱلۡغَيۡبِ":"ما غابَ عنكم وعن أَبْصَارِكم.","ٱلشَّهَٰدَةِ":"ما تَرَوْنَه وتُشَاهِدونه."},"9":{"نُودِيَ":"نادى المؤَذِّنُ.","فَٱسۡعَوۡاْ":"فامْضُوا وأَقْبِلُوا.","ذِكۡرِ ٱللَّهِ":"الموعظةِ في خُطْبَةِ الإِمامِ.","وَذَرُواْ":"واتْرُكُوا."},"10":{"وَٱبۡتَغُواْ مِن فَضۡلِ ٱللَّهِ":"واطْلُبُوا مِن رِزْقِ اللهِ.","تُفۡلِحُونَ":"تَفُوزُونَ بِخَيرَيِ الدُّنيا والآخِرَةِ."},"11":{"لَهۡوًا":"صارِفاً عَنِ الصَّلاةِ.","ٱنفَضُّوٓاْ":"تَفَرَّقُوا.","قَآئِمٗا":"أي: عَلَى الِمنْبَرِ."}}