{"4":{"ٱلۡبَيَانَ":"النُّطْقَ والتَّعْبِيرَ عَمَّا في الضَّمائِرِ."},"5":{"بِحُسۡبَانٖ":"يَجْرِيانِ بِحِسابٍ مُتْقَنٍ."},"7":{"ٱلۡمِيزَانَ":"العَدْلَ الَّذِي شَرَعَهُ لِعِبادِهِ."},"8":{"أَلَّا تَطۡغَوۡاْ":"لِئَلَّا تَعْتَدُوا."},"9":{"بِٱلۡقِسۡطِ":"بالعَدْلِ.","وَلَا تُخۡسِرُواْ":"ولا تُنْقِصُوا."},"10":{"وَضَعَهَا":"مَهَّدَها.","لِلۡأَنَامِ":"لِلْخَلْقِ."},"11":{"ٱلۡأَكۡمَامِ":"جَمْعُ «كِمٍّ» وهو وِعاءُ الثَّمرَةِ."},"12":{"ذُو ٱلۡعَصۡفِ":"ذُو القِشْرِ.","وَٱلرَّيۡحَانُ":"كُلُّ نَبْتٍ طَيِّبِ الرَّائِحةِ."},"13":{"ءَالَآءِ":"نِعَمِ."},"14":{"ٱلۡإِنسَٰنَ":"أي: أَباه، وهو آدَمُ عليه السَّلام.","مِن صَلۡصَٰلٖ":"مِن طِينٍ يابِسٍ.","كَٱلۡفَخَّارِ":"الطينِ الَّذِي طُبِخَ بالنَّارِ."},"15":{"ٱلۡجَآنَّ":"إِبْلِيسَ.","مَارِجٖ":"لَهَبِ النَّارِ المُخْتَلِطِ بَعْضُهُ بِبَعْضٍ."},"17":{"ٱلۡمَشۡرِقَيۡنِ":"مَشْرِقَي الشَّمْسِ في الشِّتاءِ والصَّيفِ.","ٱلۡمَغۡرِبَيۡنِ":"مَغْرِبَيِ الشَّمسِ في الشِّتاءِ والصَّيفِ."},"19":{"مَرَجَ":"خَلَطَ.","ٱلۡبَحۡرَيۡنِ":"الماءَ العَذْبَ والمِلْحَ.","يَلۡتَقِيَانِ":"في مَرْأَى العَينِ."},"20":{"بَرۡزَخٞ":"حاجِزٌ.","لَا يَبۡغِيَانِ":"لا يطْغَى أحَدُهُما عَلَى الآخَرِ."},"22":{"ٱللُّؤۡلُؤُ":"الدُّرُّ.","وَٱلۡمَرۡجَانُ":"صِغارُ اللُّؤلُؤ."},"24":{"ٱلۡجَوَارِ":"السُّفُنُ الضَّخْمَةُ الَّتِي تَجْرِي في البَحْرِ.","ٱلۡمُنشَـَٔاتُ":"المَرْفُوعاتُ الشِّراعِ.","كَٱلۡأَعۡلَٰمِ":"كالجِبالِ."},"26":{"عَلَيۡهَا":"عَلَى وَجْهِ الأرْضِ.","فَانٖ":"هَالِكٌ."},"27":{"ٱلۡجَلَٰلِ":"ذُو العَظَمَةِ والكِبْرِياءِ.","وَٱلۡإِكۡرَامِ":"والفَضْلِ والجُوْدِ."},"31":{"سَنَفۡرُغُ":"سنفرغ لحسابكم ومجازاتكم بأعْمالِكُم.","أَيُّهَ ٱلثَّقَلَانِ":"أيُّها الإِنْسُ والجِنُّ."},"33":{"تَنفُذُواْ":"تَخْرُجُوا.","أَقۡطَارِ":"أَطْرَافِ.","بِسُلۡطَٰنٖ":"بِقُوَّةٍ وَحُجَّةٍ."},"35":{"شُوَاظٞ":"لَهَبٌ.","وَنُحَاسٞ":"مُذابٌ يُصَبُّ على رُؤُوسِكُم.","فَلَا تَنتَصِرَانِ":"فَلَا يَنْصُرُ بَعْضُكُم بَعْضاً."},"37":{"ٱنشَقَّتِ":"تَفَطَّرَتْ يَوْمَ القِيامَةِ.","وَرۡدَةٗ":"حَمْراءَ كَلَونِ الوَرْدِ.","كَٱلدِّهَانِ":"كالزَّيتِ الْمَغْلِيِّ والرَّصاصِ المُذابِ."},"41":{"بِسِيمَٰهُمۡ":"بعَلاماتِهِم.","بِٱلنَّوَٰصِي":"بمُقَدِّمَةِ رُؤُوسِهِم."},"44":{"حَمِيمٍ":"الماءِ الشَّدِيدِ الحَرارَةِ.","ءَانٖ":"بالغٍ مُنْتَهاهُ في الحرارةِ."},"46":{"مَقَامَ رَبِّهِۦ":"وَقْتَ قِيامِهِ بين يَدَي رَبِّهِ."},"48":{"أَفۡنَانٖ":"أغْصانٍ نَضِرَةٍ مِنَ الفَوَاكِهِ والثِّمارِ."},"52":{"زَوۡجَانِ":"صِنْفانِ."},"54":{"بَطَآئِنُهَا":"جَمْعُ بِطانَةٍ، وهي ما يَلِي الأرْضَ مِنَ الفِراشِ.","إِسۡتَبۡرَقٖ":"غَلِيظِ الحرِيرِ الخالِصِ.","وَجَنَى":"وَثَمَرُ.","دَانٖ":"قَرِيبٌ إِليهِم."},"56":{"فِيهِنَّ":"في هَذِه الفُرُشِ.","قَٰصِرَٰتُ ٱلطَّرۡفِ":"لا يَصْرِفْنَ أَبْصَارَهُنَّ إِلى غَيرِ أزْوَاجِهِنَّ.","لَمۡ يَطۡمِثۡهُنَّ":"لم يَطَأْهُنَّ."},"58":{"ٱلۡيَاقُوتُ":"حَجَرٌ مِنَ الأحْجارِ الكَرِيمَةِ، ذُو ألْوانٍ.","وَٱلۡمَرۡجَانُ":"صِغارُ اللُّؤلُؤِ."},"62":{"وَمِن دُونِهِمَا":"وَمِن دُونِ الجنَّتَينِ السَّابِقَتَينِ في الدَّرَجِ."},"64":{"مُدۡهَآمَّتَانِ":"خَضْرَاوانِ، وَقَدِ اشْتَدَّتْ خُضْرَتُهُما حَتَّى مالَتْ إلى السَّوادِ."},"66":{"نَضَّاخَتَانِ":"فَوَّارتانِ بالماءِ، لا تَنْقَطِعانِ."},"70":{"فِيهِنَّ":"في هَذِه الجنَّاتِ الأرْبَعِ.","خَيۡرَٰتٌ":"زَوْجاتٌ طيِّباتُ الأخْلاقِ.","حِسَانٞ":"حِسانُ الوُجُوهِ."},"72":{"حُورٞ":"نِساءٌ ذَوَاتُ حَوَرٍ، وهو شِدَّةُ بَياضِ العَينِ وشِدَّةُ سَوَادِها.","مَقۡصُورَٰتٞ":"مَسْتُوراتٌ مَصُوناتٌ.","ٱلۡخِيَامِ":"البُيوتِ."},"76":{"رَفۡرَفٍ":"وَسَائِدَ ذَوَاتِ أَغْطِيَةٍ.","وَعَبۡقَرِيٍّ":"وَفُرُشٍ بَدِيعَةٍ."},"78":{"تَبَٰرَكَ":"كَثُرَ خَيرُهُ.","ٱلۡجَلَٰلِ":"العَظَمَةِ والمَجْدِ.","وَٱلۡإِكۡرَامِ":"لِأَوْلِيائِهِ."}}