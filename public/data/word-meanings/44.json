{"1":{"حمٓ":"سَبَقَ الكلامُ عَلى الحُرُوفِ المقَطَّعةِ أوَّلَ سُورَةِ البَقَرةِ."},"2":{"ٱلۡمُبِينِ":"الواضِحِ لَفْظاً وَمَعْنىً."},"3":{"مُبَٰرَكَةٍ":"كَثِيرَةِ الخَيراتِ، وهي لَيلةُ القَدْرِ."},"4":{"يُفۡرَقُ":"يُقضَىٰ ويُفْصَلُ مِنَ اللَّوْحِ المحْفُوظِ إلى الكَتَبةِ مِنَ الملائِكَةِ.","حَكِيمٍ":"مُحْكَمٍ."},"10":{"فَٱرۡتَقِبۡ":"فانْتَظِرْ.","بِدُخَانٖ":"ظُلْمَةٍ كَهَيئَةِ الدُّخانِ بِسَبَبِ الجَدْبِ.","مُبِينٖ":"واضِحٍ."},"11":{"يَغۡشَى":"يَعُمُّ."},"13":{"أَنَّىٰ":"كَيفَ.","ٱلذِّكۡرَىٰ":"التَّذَكُّرُ والاتِّعاظُ."},"14":{"تَوَلَّوۡاْ عَنۡهُ":"أَعْرَضُوا عَنْه.","مُعَلَّمٞ":"عَلَّمَه بَشَرٌ أو الكَهَنَةُ أو الشَّياطِينُ."},"16":{"نَبۡطِشُ":"نُعَذِّبُ، والبَطْشُ أَخْذٌ بِشِدَّةٍ."},"17":{"فَتَنَّا":"ابْتَلينا واخْتَبَرْنا."},"18":{"أَدُّوٓاْ":"سَلِّمُوا وأرْسِلُوا مَعِي.","عِبَادَ ٱللَّهِ":"بَنِي إسْرائِيلَ."},"19":{"وَأَن لَّا تَعۡلُواْ عَلَى ٱللَّهِ":"لا تَتَكَبَّرُوا على اللهِ بِتَكْذِيبِ رُسُلِه.","بِسُلۡطَٰنٖ":"بِبُرْهانٍ."},"20":{"عُذۡتُ بِرَبِّي":"استَجَرْتُ بِاللهِ.","تَرۡجُمُونِ":"تَقْتُلُوني رَجْماً بالحِجارَةِ."},"21":{"فَٱعۡتَزِلُونِ":"كُفُّوا عَنْ أذَايَ."},"22":{"مُجۡرِمُونَ":"مُشْرِكُونَ بِاللهِ كافِرُونَ."},"23":{"فَأَسۡرِ":"اجْعَلْهُم يَسِيُرونَ لَيلاً."},"24":{"رَهۡوًا":"سَاكِناً مُسْتَقِرّاً عَلَى حالِه مُنْفَرِجاً."},"26":{"وَمَقَامٖ كَرِيمٖ":"وَمَنازِلَ جَمِيلَةٍ."},"27":{"وَنَعۡمَةٖ":"عَيْشٍ لَيِّنٍ رَغْدٍ.","فَٰكِهِينَ":"مُتَنَعِّمِينَ، مُتْرَفِينَ."},"28":{"كَذَٰلِكَ":"مِثْلَ ذَلِكَ العِقابِ يُعاقِبُ اللهُ مَنْ كَذَّبَ وَبَدّلَ نِعْمةَ اللهِ كُفْراً.","وَأَوۡرَثۡنَٰهَا":"ومَلَّكْناها."},"29":{"مُنظَرِينَ":"مُؤَخَّرِينَ عَنِ العُقُوبَةِ."},"30":{"ٱلۡمُهِينِ":"المُذِلِّ."},"31":{"عَالِيٗا":"جَبَّاراً.","مِنَ ٱلۡمُسۡرِفِينَ":"مُتَجاوِزاً للحَدِّ في العُلوِّ والتَّكَبُّرِ عَلَى عبادِ اللهِ."},"32":{"ٱلۡعَٰلَمِينَ":"عالَمِي زَمانِهِم."},"33":{"ٱلۡأٓيَٰتِ":"المُعْجِزاتِ.","بَلَٰٓؤٞاْ":"اخْتِبارٌ بالرَّخاءِ والشِّدَةِ."},"35":{"بِمُنشَرِينَ":"بِمَبْعُوثِينَ."},"37":{"تُبَّعٖ":"أَحَدِ مُلُوكِ اليمنِ الحِمْيَرِيِّينَ مِمَّن جَمَعَ مُلْكَ مَناطِقِ اليمنِ كُلِّها."},"40":{"يَوۡمَ ٱلۡفَصۡلِ":"يومَ القَضاءِ بَينَ الخَلْقِ.","مِيقَٰتُهُمۡ":"مَوعِدُ جزائِهِم."},"41":{"يُغۡنِي":"يَدْفَعُ.","مَوۡلٗى":"صَاحِبٌ."},"43":{"شَجَرَتَ ٱلزَّقُّومِ":"شَجَرةً كَرِيهةَ الرَّائِحَةِ صَغِيرةَ الوَرَقِ مَسْمُومةً، خَلَقَها اللهُ في جَهَنَّمَ."},"44":{"ٱلۡأَثِيمِ":"الكَثِيرِ الآثامِ، والمرادُ بِه المشْرِكُ."},"45":{"كَٱلۡمُهۡلِ":"كالمَعْدِنِ المُذابِ."},"46":{"ٱلۡحَمِيمِ":"الماءِ الَّذِي بَلَغَ الغايَةَ فِي الحرارةِ."},"47":{"فَٱعۡتِلُوهُ":"ادْفَعُوهُ وقُودُوهُ بِعُنْفٍ.","سَوَآءِ":"وَسَطِ."},"48":{"صُبُّواْ":"أَفْرِغُوا."},"49":{"ذُقۡ":"قُولُوا لَهُ عَلَى وَجْهِ الإهانَةِ: أَحْسِسْ.","أَنتَ ٱلۡعَزِيزُ ٱلۡكَرِيمُ":"أي: الذَّلِيلُ المُهانُ، عُكِسَ المَدْلُولُ للتَّهَكُّمِ بِهِ."},"50":{"تَمۡتَرُونَ":"تَشُكُّونَ."},"51":{"مَقَامٍ":"مَسْكَنٍ.","أَمِينٖ":"آمِنٍ صاحِبُه مِنَ الآفاتِ."},"53":{"سُندُسٖ":"الرقِيقِ مِنَ الحرِيرِ الخالِصِ.","وَإِسۡتَبۡرَقٖ":"الغليظِ مِنَ الحريرِ الخالصِ.","مُتَقَٰبِلِينَ":"أي: في مَجالِسِهِم ومُحادَثاتِهِم."},"54":{"وَزَوَّجۡنَٰهُم":"قَرَنَّاهُم.","بِحُورٍ":"جَمْعُ حَوْراءَ وهي البيضاءُ.","عِينٖ":"وَاسِعاتِ الأَعْيُنِ."},"55":{"يَدۡعُونَ":"يَطْلُبُونَ."},"56":{"ٱلۡمَوۡتَةَ ٱلۡأُولَىٰ":"الَّتِي سَلَفَتْ لَهُم في الدُّنيا."},"58":{"يَسَّرۡنَٰهُ":"سَهَّلْنا لَفْظَ القرآنِ وَمَعْناهُ."},"59":{"فَٱرۡتَقِبۡ":"فانْتَظِر ما وَعَدْتُكَ.","مُرۡتَقِبُونَ":"مُنْتَظِرُونَ موتَكَ وقَهْرَكَ."}}