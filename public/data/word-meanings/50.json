{"1":{"قٓ":"سَبَقَ الكلامُ على الحُرُوفِ المُقَطَّعةِ في أوَّلِ سُورَةِ البَقَرَةِ.","ٱلۡمَجِيدِ":"ذي المجْدِ والشَّرَفِ."},"2":{"عَجِيبٌ":"مُسْتَغْرَبٌ يُتَعَجَّبُ مِنْهُ."},"3":{"رَجۡعُۢ":"بَعْثٌ."},"4":{"تَنقُصُ ٱلۡأَرۡضُ مِنۡهُمۡ":"تُفْنِي مِنْ أَجْسامِهِم.","حَفِيظُۢ":"مَحفُوظٌ."},"5":{"مَرِيجٍ":"مُخْتَلِطٍ مُضْطَرِبٍ."},"6":{"فُرُوجٖ":"شُقُوقٍ وَصُدُوعٍ."},"7":{"مَدَدۡنَٰهَا":"بَسَطْناها.","رَوَٰسِيَ":"جِبالاً ثَوابِتَ.","زَوۡجِۭ":"نَوْعٍ وَجِنْسٍ.","بَهِيجٖ":"حَسَنِ المنْظَر."},"8":{"تَبۡصِرَةٗ":"تَجْعَلُ المرءَ مُبْصِراً.","وَذِكۡرَىٰ":"تُذَكِّرُ النَّاسِي.","مُنِيبٖ":"رَجَّاعٍ إلى اللهِ."},"9":{"مُبَٰرَكٗا":"كَثِيرَ الخَيْرِ والمنافِعِ.","وَحَبَّ ٱلۡحَصِيدِ":"وحَبَّ الزَّرْعِ المحْصُودِ."},"10":{"بَاسِقَٰتٖ":"مُرْتَفِعاتٍ.","طَلۡعٞ":"هُو أوَّلُ ما يَظْهَرُ مِن ثَمَرِ التَّمْرِ، وَهُو غِلافُ العُنْقُودِ.","نَضِيدٞ":"مَنْضُودٌ، مُصَفَّفٌ بعْضُهُ فَوْقَ بَعْضٍ."},"11":{"مَيۡتٗا":"أَجْدَبَتْ وَقَحَطَتْ.","كَذَٰلِكَ":"كَمَا أَحْيا اللهُ هَذِه الأَرْضَ الميتَةَ.","ٱلۡخُرُوجُ":"خُرُوجُ النَّاسِ يَومَ البعْثِ."},"12":{"ٱلرَّسِّ":"البِئْرِ."},"14":{"وَأَصۡحَٰبُ ٱلۡأَيۡكَةِ":"أَصْحابُ الشَّجَرِ المُلْتَفِّ، وهم قَوْمُ شُعَيبٍ عَلَيهِ السَّلامُ.","وَقَوۡمُ تُبَّعٖ":"هُم سَبأٌ، وتُبَّعٌ هُوَ أَحَدُ مُلُوكِ اليمَنِ.","فَحَقَّ":"صَدَقَ وَتَحَقَّقَ.","وَعِيدِ":"إنذارِي بالعُقُوبةِ."},"15":{"أَفَعَيِينَا":"أَفَعَجَزْنا.","لَبۡسٖ":"اشْتِباهٍ وَشَكٍّ.","خَلۡقٖ جَدِيدٖ":"قِيامِ الخَلْقِ في البَعْثِ."},"16":{"مَا تُوَسۡوِسُ بِهِۦ":"تُحَدِّث بِه.","حَبۡلِ ٱلۡوَرِيدِ":"عِرْقِ العُنُقِ المُتَّصِلِ بالقلبِ."},"17":{"يَتَلَقَّى":"يُسَجِّلُ.","ٱلۡمُتَلَقِّيَانِ":"المَلَكَانِ المُوكَّلَانِ بِكِتابَةِ أعْمالِ النَّاسِ وأَقْوالِهِم.","عَنِ ٱلۡيَمِينِ":"عَن يَمِينِ الإِنْسانِ.","قَعِيدٞ":"مُقاعِدٌ، مِثْلُ جَلِيسٍ للمُجالِسِ."},"18":{"رَقِيبٌ":"مَلَكٌ يَرْقُبُ قَوْلَهُ وَيَكْتُبُهُ.","عَتِيدٞ":"حَاضِرٌ مُعَدٌّ لِذَلِكَ."},"19":{"سَكۡرَةُ ٱلۡمَوۡتِ":"شِدَّةُ غَمَراتِ الموتِ.","تَحِيدُ":"تَفِرُّ وَتَهْرُبُ."},"20":{"ٱلصُّورِ":"القَرْنِ الَّذِي يَنْفُخُ فِيهِ إسْرَافِيلُ.","يَوۡمُ ٱلۡوَعِيدِ":"أي الَّذِي تَوَعَّدَ اللهُ بِه الكُفَّارَ."},"21":{"سَآئِقٞ":"مَلَكٌ يَسُوقُ الإنْسَانَ إِلى الْمَحْشَرِ.","وَشَهِيدٞ":"مَلَكٌ يَشْهَدُ عَلَى النَّفْسِ بِما عَمِلَتْ."},"22":{"حَدِيدٞ":"قَوِيُّ النَّفاذِ في المرئِيِّ."},"23":{"قَرِينُهُۥ":"المَلَكُ الكاتِبُ الشَّهِيدُ عَلَيهِ.","عَتِيدٌ":"مُهَيَّأٌ محفُوظٌ."},"24":{"عَنِيدٖ":"مُعانِدٍ لِلْحَقِّ."},"25":{"مُعۡتَدٖ":"ظَالِمٍ مُتَجاوِزٍ لِلْحَقِّ.","مُرِيبٍ":"شَاكٍّ."},"27":{"قَرِينُهُۥ":"شَيْطَانُه الَّذِي كَانَ مُوَكَّلاً بِهِ في الدُّنيا.","مَآ أَطۡغَيۡتُهُۥ":"ما أَضْلَلْتُهُ.","ضَلَٰلِۭ":"طَرِيقٍ بَعِيدٍ عن سَبِيلِ الهُدَى."},"28":{"قَدَّمۡتُ إِلَيۡكُم بِٱلۡوَعِيدِ":"أَعْلَمْتُكُم ما يَنْتَظِرُ العاصِيَ مِن العُقُوبَةِ."},"30":{"مَزِيدٖ":"زِيادةٍ في وارِدِيها."},"31":{"وَأُزۡلِفَتِ":"وقُرِّبَتْ.","غَيۡرَ بَعِيدٍ":"مَكَاناً غَيرَ بَعِيدٍ مِنَ المُتَّقِينَ."},"32":{"أَوَّابٍ":"كَثِيرِ الرُّجُوعِ عن ذُنُوبِهِ.","حَفِيظٖ":"حافظٍ لِكُلِّ عَمَلٍ صَالِحٍ قَرَّبَهُ إلى ربِّهِ."},"33":{"بِٱلۡغَيۡبِ":"في حالِ غِيابهِ عَنْ أَعْيُنِ النَّاسِ.","مُنِيبٍ":"تائبٍ مِنْ ذُنُوبِهِ."},"34":{"بِسَلَٰمٖ":"وَأَنْتُم سالِمُونَ.","يَوۡمُ ٱلۡخُلُودِ":"هُوَ الَّذِي لا زَوَالَ لَهُ، وَلَا مَوْتَ."},"35":{"مَزِيدٞ":"أي: النَّظَرُ إلى وَجْهِ اللهِ الكريمِ."},"36":{"مِن قَرۡنٍ":"مِنْ أُمَّةٍ.","بَطۡشٗا":"قُوَّةً وَسَطْوَةً.","فَنَقَّبُواْ":"فَطَوَّفُوا.","مَحِيصٍ":"مَهْرَبٍ مِنْ عَذَابِ اللهِ."},"37":{"قَلۡبٌ":"عَقْلٌ.","أَلۡقَى ٱلسَّمۡعَ":"أَصْغَى السَّمْعَ، واسْتَمَعَ بِأُذُنَيْهِ.","شَهِيدٞ":"حاضِرٌ بِقَلْبِهِ."},"38":{"وَمَا مَسَّنَا":"وَمَا أَصَابَنا.","لُغُوبٖ":"تَعَبٍ."},"40":{"وَأَدۡبَٰرَ ٱلسُّجُودِ":"عَقِبَ الصَّلَواتِ."},"41":{"وَٱسۡتَمِعۡ":"أيُّها النَّبِيُّ لِمَا أُخْبِرُكَ بِهِ مِنْ أَهْوَالِ يَوْمِ القِيامَةِ.","ٱلۡمُنَادِ":"هُوَ المَلَكُ المُوَكَّلُ بِنَفْخِ الصُّورِ.","مَكَانٖ قَرِيبٖ":"صَخْرَةِ بَيتِ المَقْدِسِ."},"42":{"بِٱلۡحَقِّ":"بِالصِّدْقِ.","يَوۡمُ ٱلۡخُرُوجِ":"يومُ البَعْثِ مِنَ القُبُورِ."},"44":{"تَشَقَّقُ":"تَتَصَدَّعُ.","سِرَاعٗا":"مُسْرِعِينَ."},"45":{"بِجَبَّارٖ":"بِمُسَلَّطٍ عَلَيهِم تُجْبِرُهُم عَلَى الإِيمانِ."}}