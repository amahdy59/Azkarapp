{"1":{"يُسَبِّحُ":"يُنَزِّهُ.","ٱلۡحَمۡدُ":"الثَّناءُ الحسنُ الجميلُ."},"3":{"وَصَوَّرَكُمۡ":"خَلَقَكُم.","ٱلۡمَصِيرُ":"المَرْجِعُ يَومَ القِيامَةِ."},"4":{"تُسِرُّونَ":"تُخْفُونَهُ.","تُعۡلِنُونَ":"تُظْهِرُونَهُ.","بِذَاتِ ٱلصُّدُورِ":"بما تُخْفِيهِ النُّفُوسُ."},"5":{"فَذَاقُواْ":"حَلَّ بِهِم.","وَبَالَ":"سُوءَ عاقِبَةِ."},"6":{"بِٱلۡبَيِّنَٰتِ":"الآياتِ الواضِحاتِ، والمُعْجِزاتِ الظَّاهراتِ.","وَتَوَلَّواْ":"أَعْرَضُوا عَنِ الحَقِّ.","وَٱسۡتَغۡنَى ٱللَّهُ":"عَنْ عِبادَتِهِم وإيمانِهِم.","حَمِيدٞ":"مَحْمُودٌ في أقوالِهِ وأفعالِهِ وصِفاتِهِ."},"7":{"يُبۡعَثُواْ":"يُخْرَجُوا مِن قُبُورِهِم.","يَسِيرٞ":"هَيِّنٌ."},"8":{"وَٱلنُّورِ":"أَيْ: واهْتَدُوا بالقرآنِ."},"9":{"لِيَوۡمِ ٱلۡجَمۡعِ":"لِيومِ الحَشْرِ.","ٱلتَّغَابُنِ":"الغَبْنُ والتَّفاوُتُ بَينَ الخَلْقِ.","يُكَفِّرۡ":"يَمْحُ.","تَحۡتِهَا":"تَحْتِ قُصُورِها وأَشْجارِها."},"10":{"وَبِئۡسَ ٱلۡمَصِيرُ":"وَساءَ المَرْجِعُ الَّذِي صَارُوا إِلَيهِ، وهو جَهَنَّمُ."},"11":{"مُصِيبَةٍ":"مَكْرُوهٍ.","بِإِذۡنِ ٱللَّهِ":"بمشيئته.","يَهۡدِ قَلۡبَهُۥ":"يُوَفِقْهُ اللهُ إِلَى مَرْضاتِهِ."},"12":{"تَوَلَّيۡتُمۡ":"أَعْرَضْتُم عَن طاعَةِ اللهِ."},"13":{"ٱللَّهُ لَآ إِلَٰهَ إِلَّا هُوَ":"لا مَعْبُودَ بِحَقٍّ سِواهُ.","فَلۡيَتَوَكَّلِ ٱلۡمُؤۡمِنُونَ":"فَلْيَعْتَمِدوا في كُلِّ الأُمُورِ."},"14":{"عَدُوّٗا لَّكُمۡ":"أي: يَمْنَعُونَكُم مِنَ الإسْلامِ أو الهِجْرَةِ أو يكُونونَ سَبَباً لِلْمَعاصِي.","وَإِن تَعۡفُواْ":"تَتَجاوَزُوا عَن سَيِّئاتِهِم.","وَتَغۡفِرُواْ":"وتَسْتُرُوها عَلَيهِم."},"15":{"فِتۡنَةٞ":"اخْتِبارٌ لَكُم وشُغْلٌ عَنِ الآخِرَةِ.","أَجۡرٌ":"ثَوابٌ."},"16":{"مَا ٱسۡتَطَعۡتُمۡ":"ما أطَقْتُم.","خَيۡرٗا":"يَكُنْ خَيراً.","وَمَن يُوقَ شُحَّ نَفۡسِهِۦ":"ومَن سَلِمَ مِنَ البُخْلِ والحِرْصِ.","ٱلۡمُفۡلِحُونَ":"الظّافِرُونَ بِكُلِّ خَيرٍ."},"17":{"تُقۡرِضُواْ ٱللَّهَ":"تُنْفِقُوا أَمْوَالَكُم في سَبِيلِ اللهِ بِإخْلاصٍ وَطِيبِ نَفْسٍ.","شَكُورٌ":"مُجازٍ على الطَّاعةِ.","حَلِيمٌ":"لا يَعْجَلُ بالعُقُوبَةِ عَلى مَنْ عَصاهُ."},"18":{"ٱلۡغَيۡبِ":"ما غَابَ عنكم وعن أَبْصَارِكم.","ٱلشَّهَٰدَةِ":"ما لم يَغِبْ عَنِ الأَبْصارِ."}}