{"1":{"يسٓ":"سَبَقَ الكلامُ على الحُرُوفِ المُقَطَّعةِ في أوَّلِ سُورَةِ البَقَرةِ."},"4":{"صِرَٰطٖ مُّسۡتَقِيمٖ":"طَرِيقٍ مُعْتَدِلٍ؛ وهو الإسْلامُ."},"7":{"حَقَّ ٱلۡقَوۡلُ":"وَجَبَ القولُ أي: العذابُ."},"8":{"أَغۡلَٰلٗا":"قُيُوداً تَشُدُّ أيدِيَهُم إلى أعناقِهِم تَحتَ أذقانِهم.","مُقۡمَحُونَ":"رافِعُونَ رؤوسَهم غاضُّونَ أبْصارَهُم."},"9":{"سَدّٗا":"حاجِزاً ومانِعاً.","فَأَغۡشَيۡنَٰهُمۡ":"غَطَّينا أبْصارَهُم."},"11":{"أَجۡرٖ كَرِيمٍ":"أجْرٍ حَسَنٍ، وهو دخولُ الجنّةِ."},"12":{"نُحۡيِ ٱلۡمَوۡتَىٰ":"نَبْعَثُهُم بَعْدَ الموتِ.","وَءَاثَٰرَهُمۡ":"أي: ما أَبْقَوهُ مِنَ الحسَناتِ الَّتي لايَنْقَطِعُ نَفْعُها بَعْدَ الموتِ.","إِمَامٖ مُّبِينٖ":"كِتابٍ واضِحٍ؛ وهو اللَّوحُ المحفُوظُ."},"13":{"أَصۡحَٰبَ ٱلۡقَرۡيَةِ":"أَهْلَ القَرْيَةِ، وهي «أنْطاكِيَةُ»."},"14":{"فَعَزَّزۡنَا بِثَالِثٖ":"أي: قوَّيناهُما بِرَسُولٍ ثالِثٍ."},"18":{"تَطَيَّرۡنَا بِكُمۡ":"تَشَاءَمْنا بِكُم.","لَنَرۡجُمَنَّكُمۡ":"لَنَقْتُلَنَّكُم رَمْياً بالِحجارَةِ."},"19":{"طَٰٓئِرُكُم مَّعَكُمۡ":"شُؤْمُكُم مَعَكُم، الذي هو كُفْرُكُم وشِرْكُكُم."},"20":{"أَقۡصَا ٱلۡمَدِينَةِ":"مِن مَكانٍ بَعِيدٍ فِيها."},"22":{"فَطَرَنِي":"خَلَقَنِي."},"23":{"وَلَا يُنقِذُونِ":"لا يُنَجُّونَنِي مِمَّا أَنا فِيه."},"24":{"ضَلَٰلٖ مُّبِينٍ":"خَطَأٍ ظاهِرٍ."},"28":{"جُندٖ":"جَيشٍ."},"29":{"صَيۡحَةٗ":"صَوْتاً مُهلِكاً مِنَ السَّماءِ.","خَٰمِدُونَ":"مَيِّتُونَ لا حَرَاكَ فِيهِم."},"30":{"يَسۡتَهۡزِءُونَ":"يَسْخَرُونَ."},"31":{"مِنَ ٱلۡقُرُونِ":"مِنَ الأُمَمِ الخالِيةِ."},"32":{"مُحۡضَرُونَ":"نُحْضِرُهُم للحسابِ والجزاءِ."},"33":{"وَءَايَةٞ لَّهُمُ":"دَلَالةٌ لَهُم.","ٱلۡأَرۡضُ ٱلۡمَيۡتَةُ":"هي الَّتي لا نَبَاتَ فِيها.","أَحۡيَيۡنَٰهَا":"أي: بإنْزالِ المطرِ عَلَيها وإخراجِ النَّباتِ منها."},"34":{"جَنَّٰتٖ":"بَسَاتِينَ.","فَجَّرۡنَا":"شَقَقْنا."},"36":{"ٱلۡأَزۡوَٰجَ":"الأَصْنافَ والأَنْواعَ."},"37":{"ءَايَةٞ لَّهُمُ":"علامةٌ لَهُم.","نَسۡلَخُ مِنۡهُ":"نَنْزِعُ مِنْهُ."},"38":{"لِمُسۡتَقَرّٖ لَّهَا":"مُسْتَقَرُّهَا تَحْتَ العَرْشِ، كما جاء في الحديثِ المتَّفقِ عَلَيه."},"39":{"مَنَازِلَ":"مسافات، وهي ثمانيةٌ وعِشْرُونَ مَنْزِلاً.","كَٱلۡعُرۡجُونِ ٱلۡقَدِيمِ":"كالعِذْقِ اليابسِ المُتَضائلِ المتَقَوِّسِ."},"40":{"أَن تُدۡرِكَ":"أن تَلْحَقَ.","فَلَكٖ":"مَدَارٍ.","يَسۡبَحُونَ":"يَدُورُونَ في فَلَكِ السَّماءِ بانْبِساطٍ وسُهُولَةٍ."},"41":{"ءَايَةٞ لَّهُمۡ":"دليلٌ لَهُم.","ٱلۡمَشۡحُونِ":"الممْلُوءِ."},"43":{"صَرِيخَ لَهُمۡ":"مُغِيثَ لَهُم.","يُنقَذُونَ":"يُخَلَّصُونَ مِنَ الغَرَقِ."},"45":{"مَا بَيۡنَ أَيۡدِيكُمۡ":"مِنَ الآخرةِ وأهْوَالِهَا.","وَمَا خَلۡفَكُمۡ":"مِنْ أحْوالِ الدُّنيا وعِقابِها."},"49":{"يَنظُرُونَ":"ينتظِرُونَ.","صَيۡحَةٗ وَٰحِدَةٗ":"هي نَفْخَةُ الفَزَعِ عِنْدَ قِيامِ السَّاعةِ.","يَخِصِّمُونَ":"يَخْتَصِمُونَ في شُؤونِ حياتِهم غافِلينَ عَن يَوْمِ القيامةِ."},"50":{"تَوۡصِيَةٗ":"وَصِيَّةً."},"51":{"ٱلصُّورِ":"«القَرْنِ» الذي يُنفَخُ فيه للبعث.","ٱلۡأَجۡدَاثِ":"القُبُورِ.","يَنسِلُونَ":"يُسْرِعُونَ في الخُرُوجِ."},"52":{"يَٰوَيۡلَنَا":"يا هَلَاكَنا.","مَنۢ بَعَثَنَا":"مَنْ أَحْيانا؟","مِن مَّرۡقَدِنَا":"مِنْ قُبُورِنا."},"53":{"صَيۡحَةٗ وَٰحِدَةٗ":"نَفْخَةً واحِدَةً.","مُحۡضَرُونَ":"نُحْضِرُهم للحِسابِ والجَزَاءِ."},"55":{"فِي شُغُلٖ":"في نَعِيمٍ عَظِيمٍ يُلْهِيهِم عمَّا سِواه.","فَٰكِهُونَ":"مُتَلَذِّذُونَ."},"56":{"ٱلۡأَرَآئِكِ":"الأَسِرَّةِ المزَيَّنةِ."},"57":{"مَا يَدَّعُونَ":"ما يَشْتَهُونَ."},"59":{"وَٱمۡتَٰزُواْ":"تميَّزُوا، وانفرِدُوا عَنِ المؤمِنِينَ."},"60":{"أَعۡهَدۡ إِلَيۡكُمۡ":"أُوصِكُم وأُبَلِّغْكُم."},"62":{"جِبِلّٗا":"خَلْقاً."},"64":{"ٱصۡلَوۡهَا":"ادخُلُوا جَهَنَّمَ وقاسُوا حَرَّها."},"65":{"نَخۡتِمُ":"نَطْبَعُ."},"66":{"لَطَمَسۡنَا عَلَىٰٓ أَعۡيُنِهِمۡ":"لصَيرَّناها مَمْسُوحَةً لا يُرى لها شَقٌّ ولا جَفْنٌ.","فَٱسۡتَبَقُواْ ٱلصِّرَٰطَ":"بادَرُوا إليه.","فَأَنَّىٰ يُبۡصِرُونَ":"فكيفَ يُبْصِرُونَ وقد طُمِسَتْ أَبْصارُهُم؟"},"67":{"لَمَسَخۡنَٰهُمۡ عَلَىٰ مَكَانَتِهِمۡ":"لَغَيَّرْنا خَلْقَهم في المكانِ الَّذي هم فيهِ.","مُضِيّٗا":"أي: ذَهاباً إلى الأمامِ."},"68":{"نُعَمِّرۡهُ":"نُطِلْ عُمُرَه.","نُنَكِّسۡهُ فِي ٱلۡخَلۡقِ":"نَرُدَّه إلى أرْذَلِ العُمُرِ وأَضْعَفِه."},"70":{"وَيَحِقَّ ٱلۡقَوۡلُ":"أي: تَجِبَ كلمةُ العذابِ."},"71":{"مِمَّا عَمِلَتۡ أَيۡدِينَآ":"أي: مما أبْدَعْناهُ وَعَمِلْناهُ.","لَهَا مَٰلِكُونَ":"مَالِكُونَ أَمْرَها، يَتَصَرَّفُونَ بِها كيفَ شَاؤُوا."},"72":{"وَذَلَّلۡنَٰهَا لَهُمۡ":"سَخَّرْناها لَهُم.","رَكُوبُهُمۡ":"مَرْكُوبُهم الّذي يَرْكَبُونَه."},"75":{"وَهُمۡ لَهُمۡ جُندٞ مُّحۡضَرُونَ":"والحالُ أَنَّ هذه الآلهةَ قَدْ أُحْضِرَتْ مُجْتَمِعَةً لِتُعايِنَ عذابَ عابِدِيها، وهي لا تَسْتَطِيعُ نَصْرَهُم."},"77":{"مِن نُّطۡفَةٖ":"هي مَنِيُّ الرَّجُلِ يقْذِفُه في رَحمِ امْرَأتِه.","خَصِيمٞ":"كثيرُ الخُصُومَةِ بالباطلِ."},"78":{"رَمِيمٞ":"باليةٌ مُتفَتِّتةٌ."},"79":{"أَنشَأَهَآ":"خَلَقَها."},"80":{"مِنۡهُ تُوقِدُونَ":"تَقْدَحُونَ منه."},"83":{"مَلَكُوتُ":"هو المُلْكُ التَّامُّ للأشياءِ كلِّها."}}