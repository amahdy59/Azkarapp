{"1":{"كٓهيعٓصٓ":"سَبَقَ الكلامُ على الحُرُوفِ المُقَطَّعةِ في أوَّلِ سُورَةِ البَقَرةِ."},"3":{"خَفِيّٗا":"سِرّاً."},"4":{"وَهَنَ":"ضَعُفَ.","وَٱشۡتَعَلَ ٱلرَّأۡسُ شَيۡبٗا":"انْتَشَرَ الشَّيبُ في رَأسِي.","شَقِيّٗا":"مَحْرُوماً مِن إِجابَةِ الدُّعاءِ."},"5":{"ٱلۡمَوَٰلِيَ":"العَصَبَةَ وأقْرَبَ القَرَابَةِ.","عَاقِرٗا":"التي لا تَلِدُ.","وَلِيّٗا":"وَلَداً وَارِثاً ومُعِيناً."},"6":{"يَرِثُنِي":"يَرِثُ نُبُوَّتي.","رَضِيّٗا":"مَرْضِيّاً عِنْدَكَ وَعِنْدَ عِبَادِكَ."},"7":{"سَمِيّٗا":"مُسَمّىً باسْمِه."},"8":{"أَنَّىٰ":"كيفَ؟","عِتِيّٗا":"النِّهايةَ في كِبَر السِّنِّ."},"9":{"هَيِّنٞ":"سَهْلٌ.","وَلَمۡ تَكُ شَيۡـٔٗا":"ولم تَكُ شيئاً مَذْكُوراً ولا مَوْجُوداً."},"10":{"ءَايَةٗ":"علامةً.","سَوِيّٗا":"صَحِيحاً مُعَافىً."},"11":{"ٱلۡمِحۡرَابِ":"المُصَلَّى.","بُكۡرَةٗ وَعَشِيّٗا":"صَباحاً ومَسَاءً."},"12":{"بِقُوَّةٖ":"بجِدٍّ واجْتِهَادٍ.","ٱلۡحُكۡمَ":"الحِكْمَةَ وحُسنَ الفَهْمِ.","صَبِيّٗا":"صغيرَ السِّنِّ."},"13":{"حَنَانٗا":"رَحْمَةً ومحبةً.","وَزَكَوٰةٗ":"طَهَارةً مِنَ الذُّنُوبِ.","تَقِيّٗا":"خائفاً مِنَ اللهِ، ومُطِيعاً لَه."},"14":{"بَرَّۢا":"بَارّاً ومُطيعاً.","جَبَّارًا":"مُتَكَبِّراً عَنْ طاعةِ ربِّه، وطاعةِ والدَيْه.","عَصِيّٗا":"عاصِياً لِرَبِّه وَلِوالِدَيْه."},"16":{"فِي ٱلۡكِتَٰبِ":"في هَذا القُرْآنِ.","ٱنتَبَذَتۡ":"تباعَدَتْ واعْتَزَلَتْ.","شَرۡقِيّٗا":"مَكَاناً مِمَّا يلِي الشَّرقَ عَنْ أَهْلِها."},"17":{"رُوحَنَا":"أي: جِبْرِيلَ عليهِ السَّلامُ.","فَتَمَثَّلَ لَهَا بَشَرٗا":"تصَوَّرَ لَها في صُورَةِ إنْسَانٍ.","سَوِيّٗا":"تامَّ الخَلْقِ."},"18":{"أَعُوذُ بِٱلرَّحۡمَٰنِ":"ألْتَجِئُ وأَسْتَجِيرُ بالرَّحمنِ."},"19":{"زَكِيّٗا":"طاهِراً مِنَ الذُّنوبِ."},"20":{"أَنَّىٰ":"كيفَ؟","لَمۡ يَمۡسَسۡنِي بَشَرٞ":"لم يَمَسَّني بَشَرٌ بِنِكَاحٍ حَلَالٍ.","بَغِيّٗا":"زانيةً."},"21":{"ءَايَةٗ":"علامةً تَدُلُّ على قُدْرَةِ اللهِ.","رَحۡمَةٗ مِّنَّا":"جَعَلَه اللهُ رحمةً لأمِّه ولِمَن آمَنَ به.","مَقۡضِيّٗا":"قَضاءً سابِقاً مُقَدَّراً."},"22":{"فَٱنتَبَذَتۡ":"فتباعَدَتْ."},"23":{"نَسۡيٗا مَّنسِيّٗا":"شَيْئاً لا يُعْرَفُ ولا يُذكَرُ."},"24":{"فَنَادَىٰهَا":"أي: جبريلُ أو عِيسى.","سَرِيّٗا":"جَدْوَلَ ماءٍ."},"25":{"هُزِّيٓ":"حَرِّكِي."},"26":{"وَقَرِّي عَيۡنٗا":"وطِيبِي نَفْساً بِمَولُودِكِ.","نَذَرۡتُ":"أوْجَبْتُ على نَفْسِي.","صَوۡمٗا":"سُكُوتاً.","إِنسِيّٗا":"أَحَداً مِنَ النَّاسِ."},"27":{"شَيۡـٔٗا فَرِيّٗا":"أمْراً عَظِيماً مُفْتَرَىً."},"28":{"يَٰٓأُخۡتَ هَٰرُونَ":"يا أُخْتَ الرَّجلِ الصَّالحِ هارُونَ.","ٱمۡرَأَ سَوۡءٖ":"رَجُلَ سَوْءٍ يأتي الفَوَاحِشَ.","بَغِيّٗا":"زَانيةً."},"29":{"ٱلۡمَهۡدِ":"ما يُهَيَّأ للرَّضِيعِ مِن فِراشٍ ونَحْوِه.","صَبِيّٗا":"طِفْلاً رَضِيعاً."},"30":{"ٱلۡكِتَٰبَ":"الإنْجِيلَ."},"31":{"مُبَارَكًا":"عَظِيمَ الْخيرِ والنَّفْعِ","مَا دُمۡتُ حَيّٗا":"ما بَقِيِتُ حَيّاً."},"32":{"بَرَّۢا":"بَارّاً ومُطِيعاً.","جَبَّارٗا":"مُتَكَبِّراً.","شَقِيّٗا":"عَاصِياً لِربِّي."},"33":{"وَيَوۡمَ أُبۡعَثُ حَيّٗا":"أي: يَوْمَ الْقِيَامةِ."},"34":{"فِيهِ يَمۡتَرُونَ":"يَشُكُّ فيه اليهودُ والنَّصَارَىٰ ويُجَادِلُونَ."},"35":{"مَا كَانَ":"ما يَنْبَغِي وَلَا يَلِيقُ.","سُبۡحَٰنَهُۥٓ":"تَقَدَّسَ وتَنَزَّهَ عَن ذَلِكَ.","قَضَىٰٓ":"أَرَادَ.","فَيَكُونُ":"أي: كَمَا أرَادَه."},"36":{"هَٰذَا صِرَٰطٞ مُّسۡتَقِيمٞ":"هَذَا طريقٌ لا اعْوِجَاجَ فِيه."},"37":{"ٱلۡأَحۡزَابُ":"الفِرَقُ مِنْ أَهْلِ الْكِتَابِ.","فَوَيۡلٞ":"فهَلاكٌ.","مَشۡهَدِ":"شُهُودِ.","يَوۡمٍ عَظِيمٍ":"يومِ القِيامَةِ."},"38":{"أَسۡمِعۡ بِهِمۡ وَأَبۡصِرۡ":"ما أقدَرَهم على السَّمعِ والبَصَرِ يوم القيامةِ!","فِي ضَلَٰلٖ مُّبِينٖ":"في انْحِرَافٍ واضحٍ عَن سَبيلِ الحقِّ."},"39":{"يَوۡمَ ٱلۡحَسۡرَةِ":"يومَ النَّدامةِ على ما فرَّطُوا في جَنْبِ اللهِ."},"41":{"صِدِّيقٗا":"عَظِيمَ الصِّدقِ."},"42":{"وَلَا يُغۡنِي":"ولا يَدْفَعُ."},"43":{"أَهۡدِكَ":"أُرْشِدْكَ.","صِرَٰطٗا سَوِيّٗا":"طريقاً مُسْتَوياً لا اعْوِجَاجَ فيه."},"44":{"لَا تَعۡبُدِ ٱلشَّيۡطَٰنَ":"لا تُطِعِ الشَّيطانَ في عِبادةِ الأصْنام.","عَصِيّٗا":"مُخَالِفاً مُسْتكْبِراً عَن طاعَةِ اللهِ."},"45":{"لِلشَّيۡطَٰنِ وَلِيّٗا":"قَرِيناً لَه في اللَّعنةِ، وقريباً منه في النَّار."},"46":{"أَرَاغِبٌ أَنتَ عَنۡ ءَالِهَتِي":"أَمُعْرِضٌ أنت عَن عِبادَةِ آلِهَتِي.","لَأَرۡجُمَنَّكَ":"لَأَقْتُلَنَّك رَمْياً بِالْحِجارَةِ.","مَلِيّٗا":"زَماناً طَوِيلاً مِنَ الدَّهْرِ."},"47":{"سَلَٰمٌ عَلَيۡكَ":"تحيةُ تَودِيعٍ ومُتَارَكَةٍ، أي: تَسْلَمُ ممَّا تَكْرَهُه مِنِّي.","بِي حَفِيّٗا":"كَثيرَ البِرِّ واللُّطْفِ."},"48":{"وَأَعۡتَزِلُكُمۡ":"وأُفارِقُكُم.","شَقِيّٗا":"مَحْرُوماً مِنْ إجابَةِ الدُّعاءِ."},"50":{"لِسَانَ صِدۡقٍ":"ثَناءً حَسَناً.","عَلِيّٗا":"رفيعَ القَدْرِ باقياً في النَّاسِ."},"51":{"مُخۡلَصٗا":"مُخْتاراً لِرِسالتِه."},"52":{"ٱلطُّورِ":"جَبَلِ طُورِ سَيناءَ.","وَقَرَّبۡنَٰهُ نَجِيّٗا":"فشَرَّفْناه بِمُناجاتِنا وتَكْلِيمِنا إيَّاه سرّاً."},"56":{"صِدِّيقٗا":"عظيمَ الصِّدقِ في قولِه وعَمَلِه."},"57":{"وَرَفَعۡنَٰهُ":"أي: ذِكْرَه ومَنْزِلَتَه، قيل: إنَّه رُفِعَ إلى السَّماءِ الرابعةِ.","عَلِيًّا":"رفيعَ القَدْرِ، أو ذا مَكانٍ عالٍ في السَّماءِ."},"58":{"وَٱجۡتَبَيۡنَآ":"واصْطَفَينا للرِّسالةِ والنُّبوَّةِ.","خَرُّواْ":"وَقَعُوا.","وَبُكِيّٗا":"وباكِينَ مِنْ خَشْيَتِه سُبْحَانَه وتَعالَى."},"59":{"فَخَلَفَ مِنۢ بَعۡدِهِمۡ":"فجاءَ بَعْدَهُم.","خَلۡفٌ":"أتْبَاعُ سُوءٍ.","غَيًّا":"جَزاءَ الغَيِّ، أو وَادِياً في جَهَنَّمَ."},"61":{"بِٱلۡغَيۡبِ":"أي: غائبةً عَنْهم لا يُشاهِدُونها.","مَأۡتِيّٗا":"آتِياً لا مَحالةَ."},"62":{"لَغۡوًا":"كَلاماً باطِلاً.","بُكۡرَةٗ وَعَشِيّٗا":"أي: على مِقْدارِ ما يَعرِفُونَ من الغَداءِ والعَشَاءِ، وإلَّا فليسَ في الجنَّةِ بُكْرَةٌ ولا عَشِيَّةٌ."},"63":{"نُورِثُ":"نُعْطِي."},"64":{"وَمَا نَتَنَزَّلُ":"أي: نَحْنُ الملائكةُ مِنَ السَّماءِ إلى الأرضِ.","لَهُۥ مَا بَيۡنَ أَيۡدِينَا":"مما يُسْتَقْبَلُ مِنْ أُمُورِ الآخِرَةِ.","وَمَا خَلۡفَنَا":"مِمَّا مَضَى مِنْ أُمُورِ الدُّنْيا.","وَمَا بَيۡنَ ذَٰلِكَ":"وَمَا بَيْنَ الدُّنْيا والآخِرةِ.","نَسِيّٗا":"ناسِياً لشيءٍ مِنَ الأشياءِ."},"65":{"وَٱصۡطَبِرۡ لِعِبَٰدَتِهِۦ":"واثْبُتْ عَلى طاعةِ الله بِصَبْرٍ ومُوَاظَبَةٍ.","سَمِيّٗا":"مُماثِلاً في ذَاتِه وَأَسْمائِه وصِفاتِه وأفعالِه."},"68":{"لَنَحۡشُرَنَّهُمۡ":"لَنَجْمَعَنَّ هَؤلاءِ المُنْكِرِينَ لِلبَعْثِ يومَ القيامةِ.","جِثِيّٗا":"بارِكِينَ على رُكَبِهِم."},"69":{"ثُمَّ لَنَنزِعَنَّ":"ثم لَنَأخُذَنَّ.","شِيعَةٍ":"طائِفَةٍ.","عِتِيّٗا":"تَمرُّداً وعِصْياناً للهِ تَعالى."},"70":{"هُمۡ أَوۡلَىٰ بِهَا صِلِيّٗا":"هُم أَوْلى بجَهَنَّمَ دُخُولاً."},"71":{"إِلَّا وَارِدُهَا":"إلَّا واردٌ النارَ بالمُرُورِ على الصِّراطِ المنْصُوبِ على مَتْنِ جَهَنَّمَ.","حَتۡمٗا مَّقۡضِيّٗا":"أَمْراً مَحْتُوماً قُضِيَ وحُكِمَ أنَّه لابُدَّ مِن وُقُوعِه."},"72":{"وَنَذَرُ":"ونَتْرُكُ."},"73":{"خَيۡرٞ مَّقَامٗا":"أَفْضَلُ مَنْزِلاً.","وَأَحۡسَنُ نَدِيّٗا":"وأَحْسَنُ مَجْلِساً."},"74":{"مِن قَرۡنٍ":"مِنْ أُمَمٍ.","هُمۡ أَحۡسَنُ أَثَٰثٗا وَرِءۡيٗا":"أَحْسنُ مَتاعاً مِنْهُم، وأَجْمَلُ مَنْظَراً."},"75":{"فَلۡيَمۡدُدۡ":"فَلْيُمْهِلْهُ اسْتِدْرَاجاً.","هُوَ شَرّٞ مَّكَانٗا":"شرٌّ مَسْكَناً ومُسْتَقَرّاً.","وَأَضۡعَفُ جُندٗا":"وأَضْعَفُ قوةً وَرِجالاً."},"76":{"وَٱلۡبَٰقِيَٰتُ ٱلصَّٰلِحَٰتُ":"أَعمالُ الخيرِ.","وَخَيۡرٞ مَّرَدًّا":"وخيرٌ مَرْجِعاً وَعاقِبَةً."},"77":{"لَأُوتَيَنَّ":"لَأُعْطَينَّ في الآخِرَةِ."},"78":{"أَطَّلَعَ ٱلۡغَيۡبَ":"أعَلِمَ الغَيبَ؟","عَهۡدٗا":"أي: عَهْداً بِدُخُولِ الجنَّةِ."},"79":{"وَنَمُدُّ لَهُۥ":"ونَزِيدُه في الآخِرَةِ."},"80":{"وَنَرِثُهُۥ":"أي: بَعْدَ هَلاكِه فيَصِيرُ لنا مالُه وولدُه."},"81":{"عِزّٗا":"شُفَعَاءَ وأنْصَاراً يَتَعزَّزُونَ بِهِم."},"82":{"وَيَكُونُونَ عَلَيۡهِمۡ ضِدًّا":"وتَكُونُ هذه الآلهةُ مُخَالِفةً لهم تُخاصِمُهُم، على عَكْسِ ما كانُوا يَرْجُونَه مِنْ هَؤلاءِ."},"83":{"تَؤُزُّهُمۡ":"تُهَيِّجُ الكَافِرِينَ وتَدْفَعُهُم إلى المَعاصِي."},"84":{"نَعُدُّ لَهُمۡ":"نُحْصِي أَعْمالَهم وَأَعمارَهُم."},"85":{"وَفۡدٗا":"قادِمِينَ على اللهِ مُكْرَمِينَ."},"86":{"وَنَسُوقُ ٱلۡمُجۡرِمِينَ":"أي: نَحُثُّهم على السَّيرِ، ونَطْرُدُهم كما تُطْرَدُ البَهَائِمُ","وِرۡدٗا":"عِطاشاً."},"89":{"شَيۡـًٔا إِدّٗا":"شَيئاً عَظِيماً مُنْكَراً."},"90":{"يَتَفَطَّرۡنَ مِنۡهُ":"يَتَشَقَّقْنَ ويَتَفَتَّتْنَ مِن شَناعَتِه.","وَتَنشَقُّ":"وتَتَصَدَّعُ.","وَتَخِرُّ ٱلۡجِبَالُ":"أي: تَسْقُطُ وتَنْهَدِمُ.","هَدًّا":"أي: مَهْدُودَةً ومَكْسُورَةً."},"96":{"وُدّٗا":"حُبّاً في قُلُوبِ عِبَادِه."},"97":{"لُدّٗا":"شَدِيدِي الخُصُومَةِ بالباطِل."},"98":{"مِن قَرۡنٍ":"مِنْ أُمَمٍ.","رِكۡزَۢا":"صَوْتاً خَفِيّاً."}}