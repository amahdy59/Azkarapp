{
  "name": "azkarapp",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "audit:prod": "pnpm audit --prod",
    "build:pages": "vite build --mode github-pages && node scripts/check-bundle-budget.mjs",
    "build": "vite build",
    "check": "prettier --check . && eslint . --max-warnings 0 && tsc --noEmit && npm run validate:audio && npm run test:coverage && vite build && node scripts/check-bundle-budget.mjs",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:run": "vitest run",
    "budget": "node scripts/check-bundle-budget.mjs",
    "typecheck": "tsc --noEmit",
    "validate:audio": "node scripts/validate-audio-manifest.mjs",
    "report:audio": "node scripts/generate-audio-mapping-report.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-arabic": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-radio-group": "1.2.3",
    "@radix-ui/react-scroll-area": "1.2.3",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-slot": "1.1.2",
    "@supabase/supabase-js": "2.56.0",
    "@untitledui/icons": "0.0.22",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "input-otp": "1.4.2",
    "motion": "12.23.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8",
    "vaul": "1.1.2",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "4.1.12",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "4.1.9",
    "axe-core": "^4.12.1",
    "eslint": "^10.6.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "prettier": "^3.9.4",
    "tailwindcss": "4.1.12",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.62.1",
    "vite": "6.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  }
}
